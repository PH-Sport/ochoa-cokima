---
import Base from "../layouts/Base.astro";
// Solo lo que la web hace de verdad: no tiene formularios, ni cookies, ni medición. Lo que haga el
// titular con los correos que recibe no se sabe, y no se escribe hasta que lo diga el cliente.
---

<Base title="Política de privacidad · Grupo Tombo" description="Política de privacidad de la web del Grupo Tombo.">
  <section class="legal">
    <div class="wrap">
      <h1>Política de privacidad</h1>
      <p>
        Esta web no usa cookies, no tiene formularios y no guarda datos personales de quien la visita.
      </p>
      <p>
        El responsable del tratamiento es <em>[razón social pendiente — datos fiscales del cliente]</em>.
        Este contenido se completará con los datos que facilite el titular.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal .wrap {
    padding-block: clamp(36px, 7vw, 80px) clamp(48px, 8vw, 96px);
  }
  h1 {
    margin: 0 0 18px;
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  p {
    color: var(--muted);
    max-width: var(--measure);
  }
</style>
