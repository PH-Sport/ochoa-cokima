---
import Base from "../layouts/Base.astro";
// Con los mismos huecos que las legales de las dos casas: los datos fiscales del titular los tiene
// que dar el cliente (docs/estado.md §5). No se inventan.
---

<Base title="Aviso legal · Grupo Tombo" description="Aviso legal de la web del Grupo Tombo.">
  <section class="legal">
    <div class="wrap">
      <h1>Aviso legal</h1>
      <p>
        Titular del sitio: <em>[razón social pendiente — datos fiscales del cliente]</em>, con domicilio
        en <em>[pendiente]</em> y CIF <em>[pendiente]</em>. Contacto:
        <a href="mailto:info@grupotombo.com">info@grupotombo.com</a>.
      </p>
      <p>
        Este contenido se completará con los datos fiscales que facilite el titular.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal .wrap {
    padding-block: clamp(36px, 7vw, 80px) clamp(48px, 8vw, 96px);
  }
  h1 {
    margin: 0 0 18px;
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  p {
    color: var(--muted);
    max-width: var(--measure);
  }
</style>
