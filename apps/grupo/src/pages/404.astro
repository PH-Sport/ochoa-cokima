---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada · Grupo Tombo" description="Esta página no existe.">
  <section class="nada">
    <div class="wrap">
      <h1>Esta página no existe.</h1>
      <p>Puede que fuera de la web anterior. <a href="/">Volver al inicio</a>.</p>
    </div>
  </section>
</Base>

<style>
  .nada .wrap {
    padding-block: clamp(48px, 10vw, 120px);
  }
  h1 {
    margin: 0 0 12px;
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  p {
    color: var(--muted);
  }
</style>
