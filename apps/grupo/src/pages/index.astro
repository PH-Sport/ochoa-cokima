---
// La portada del grupo, desde el 2026-11-23 una pantalla partida (docs/grupo-tombo-web.md): cada mitad
// es su casa con su propia estética —Cokima de noche, Los Ochoa de día— y el logo del grupo las une en
// la costura. Debajo, el contacto con el estilo del grupo. Textos, fotos y logos son los de cada casa,
// sin inventar nada; los nombres y las direcciones van en texto, no dentro de imágenes, por los buscadores.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import cokima from "../assets/cokima-portada.jpg";
import ochoa from "../assets/ochoa-portada.jpg";

const foto = { widths: [480, 780, 1200, 1600], sizes: "(min-width: 820px) 50vw, 100vw", quality: 76 };
---

<Base
  title="Grupo Tombo · Grupo hostelero en Madrid"
  description="Grupo Tombo es el grupo hostelero de Cokima, en Andrés Mellado, y de la Tasquita Los Ochoa, en la Castellana: locales con personalidad propia y la buena comida como denominador común."
  ficha
  cabecera={false}
>
  <h1 class="oculto">Grupo Tombo: Cokima y Tasquita Los Ochoa</h1>
  <section class="split" id="restaurantes" aria-label="Nuestras casas">
    <a class="mitad cokima" href="https://www.cokima.es/">
      <Image src={cokima} alt="" {...foto} loading="eager" fetchpriority="high" />
      <div class="dentro">
        <img class="logo" src="/images/cokima-logo.png" alt="Cokima" width="1756" height="354" />
        <p class="seña"><span>Kitchen Madness ·</span> <span>Andrés Mellado, 21</span></p>
        <p class="lema">Puedes comer en cualquier sitio, pero será solo comer.</p>
        <span class="boton">Entrar en Cokima →</span>
      </div>
    </a>
    <a class="mitad ochoa" href="https://www.tasquitalosochoa.es/">
      <Image src={ochoa} alt="" {...foto} loading="eager" />
      <div class="dentro">
        <span class="rotulo"><small>Tasquita</small><b>Los Ochoa</b><small>Madrid</small></span>
        <p class="lema">¡La tasca que te mereces!</p>
        <p class="seña">P.º de la Castellana, 117</p>
        <span class="boton">Entrar en Los Ochoa →</span>
      </div>
    </a>
    <a class="costura" href="#contacto" aria-label="Grupo Tombo, ir al contacto">
      <img src="/images/logo-blanco.png" alt="Grupo Tombo" width="690" height="248" />
    </a>
  </section>

  <section class="contacto" id="contacto">
    <div class="wrap">
      <div class="quienes">
        <img class="marca claro" src="/images/logo.png" alt="Grupo Tombo" width="800" height="288" />
        <img class="marca oscuro" src="/images/logo-blanco.png" alt="Grupo Tombo" width="690" height="248" />
        <p>
          Amantes de la comida y de los buenos restaurantes decidimos emprender en este viaje culinario
          creando locales con personalidad propia pero con la buena comida como denominador común.
        </p>
      </div>
      <div>
        <h2>Contacto</h2>
        <p>Si quieres contactar con nosotros, escríbenos.</p>
        <a class="correo" href="mailto:info@grupotombo.com">info@grupotombo.com</a>
      </div>
      <div id="trabaja">
        <h2>Trabaja con nosotros</h2>
        <p>Envíanos tu currículum a este correo.</p>
        <a class="correo" href="mailto:info@grupotombo.com">info@grupotombo.com</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // El dedo, como en cada casa: `pointerdown` y no `:active`, porque en Safari de iOS ese estado solo se
  // aplica de forma fiable con un listener táctil (lo explica el Base de Ochoa). Al tocar una mitad, su
  // botón se hunde; el de Cokima, además, se enciende y se apaga solo (--ck-dur-neon-toque), como en Brasa,
  // y el de Ochoa vuelve a subir al soltar.
  // El build reescribe las duraciones de tokens.css a segundos («1800ms» sale como «1.8s»): hay que leer la
  // unidad, o un parseFloat a secas da 1,8 ms y el neón se apaga en el acto.
  const ms = (nombre: string) => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(nombre).trim();
    const n = parseFloat(v) || 0;
    return v.endsWith("ms") ? n : v.endsWith("s") ? n * 1000 : n;
  };
  let pulsado: HTMLElement | null = null;
  let desde = 0;

  document.addEventListener(
    "pointerdown",
    (e) => {
      const mitad = (e.target as Element | null)?.closest?.(".mitad");
      const boton = mitad?.querySelector<HTMLElement>(".boton");
      if (!boton) return;
      pulsado = boton;
      desde = performance.now();
      boton.classList.remove("soltando");
      boton.classList.add("tocando");
      if (mitad!.classList.contains("cokima") && e.pointerType !== "mouse") {
        boton.classList.add("encendido");
        clearTimeout(Number(boton.dataset.apaga));
        boton.dataset.apaga = String(setTimeout(() => boton.classList.remove("encendido"), ms("--ck-dur-neon-toque")));
      }
    },
    { passive: true },
  );

  // En `pointerup` y en `pointercancel`: sin el segundo, arrastrar el dedo fuera lo dejaba hundido.
  const suelta = () => {
    const boton = pulsado;
    if (!boton) return;
    pulsado = null;
    if (boton.closest(".cokima")) {
      // Hundido lo justo para verse: --ck-dur-out como poco, como en Brasa.
      setTimeout(() => boton.classList.remove("tocando"), Math.max(0, ms("--ck-dur-out") - (performance.now() - desde)));
    } else {
      boton.classList.remove("tocando");
      boton.classList.add("soltando");
      boton.addEventListener("animationend", () => boton.classList.remove("soltando"), { once: true });
    }
  };
  document.addEventListener("pointerup", suelta, { passive: true });
  document.addEventListener("pointercancel", suelta, { passive: true });
</script>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* La pantalla partida: arriba y abajo en el móvil, izquierda y derecha en el ordenador */
  .split {
    position: relative;
    display: grid;
    grid-template-rows: 1fr 1fr;
    height: 100svh;
    min-height: 620px;
  }
  @media (min-width: 820px) {
    .split {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
      min-height: 560px;
    }
  }

  .mitad {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    isolation: isolate;
  }
  .mitad > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transform: scale(1.01);
    transition: transform var(--dur-lento) var(--curva-suave);
  }
  .mitad::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* Al señalar una casa, la otra se apaga un poco. Solo opacidad, como piden las reglas de movimiento. */
  .mitad::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--oscurece);
    opacity: 0;
    transition: opacity var(--dur-rapido) var(--curva-suave);
    pointer-events: none;
  }
  @media (hover: hover) {
    .mitad:hover > :global(img) {
      transform: scale(1.045);
    }
    .split:hover .mitad:not(:hover)::after {
      opacity: 1;
    }
  }
  .mitad:focus-visible {
    outline: 3px solid var(--on-red);
    outline-offset: -8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .mitad > :global(img),
    .mitad::after {
      transition: none;
    }
    .mitad:hover > :global(img) {
      transform: scale(1.01);
    }
  }

  .dentro {
    width: 100%;
    display: grid;
    gap: clamp(10px, 1.6vh, 16px);
    justify-items: start;
    padding-block: clamp(22px, 5vh, 56px);
    padding-left: max(20px, env(safe-area-inset-left, 0px));
    padding-right: max(20px, env(safe-area-inset-right, 0px));
  }
  @media (min-width: 820px) {
    .dentro {
      padding: clamp(40px, 9vh, 96px) clamp(32px, 5vw, 72px);
    }
  }
  .dentro p {
    margin: 0;
  }

  /* Cokima, de noche: su fondo, su logo, su Bricolage y la Cormorant de su voz */
  .cokima {
    background: var(--ck-ground);
    color: var(--ck-bone);
  }
  .cokima::before {
    background: linear-gradient(to top, var(--ck-velo) 8%, var(--ck-velo-medio) 55%, var(--ck-velo-alto) 100%);
  }
  .cokima .logo {
    width: clamp(160px, 46vw, 260px);
    height: auto;
  }
  @media (min-width: 820px) {
    .cokima .logo {
      width: clamp(170px, 30vw, 360px);
    }
  }
  .cokima .seña {
    font-family: var(--ck-sans);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ck-bone-dim);
  }
  /* Si no cabe en una línea, se parte entre el nombre y la dirección, no dentro de la dirección. */
  .cokima .seña span {
    white-space: nowrap;
  }
  .cokima .lema {
    max-width: 24ch;
    font-family: var(--ck-voz);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    line-height: 1.15;
  }
  /* El botón es el `.pill.solid` de Brasa, tal cual (apps/cokima/src/styles/brasa.css): un neón apagado
     que arranca a trompicones con el ratón encima y se queda encendido; al pulsar se hunde un poco, y en
     el móvil el toque lo enciende y se apaga solo. Aquí la mitad entera es el enlace, así que lo que lo
     enciende es señalar la mitad. Lo único que no viene son las chispas al pulsar, que pinta brasa.js. */
  .cokima .boton {
    position: relative;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid var(--ck-bone);
    background: var(--ck-bone);
    color: var(--ck-texto-solido);
    font: 500 0.92rem/1 var(--ck-sans);
    transition: transform var(--ck-dur-out) var(--ck-ease);
  }
  .cokima .boton::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    border: 1.5px solid var(--ck-ember);
    box-shadow: 0 0 7px var(--ck-neon-luz), inset 0 0 5px var(--ck-neon-luz);
    opacity: 0;
    transition: opacity var(--ck-dur-out) var(--ck-ease);
  }
  @keyframes encender {
    0% { opacity: 0; }
    8.75% { opacity: 0.55; }
    15% { opacity: 0.18; }
    23.75% { opacity: 0.48; }
    31.25% { opacity: 0.1; }
    43.75% { opacity: 0.1; }
    53.75% { opacity: 0.72; }
    60% { opacity: 0.45; }
    71.25% { opacity: 0.88; }
    78.75% { opacity: 0.68; }
    91.25%, 100% { opacity: 1; }
  }
  @media (hover: hover) {
    .cokima:hover .boton::after {
      animation: encender var(--ck-dur-encender) ease-in-out forwards;
    }
  }
  .cokima .boton.encendido::after {
    animation: encender var(--ck-dur-encender) ease-in-out forwards;
  }
  .cokima .boton.tocando {
    transform: scale(0.965);
  }

  /* Los Ochoa, de día: su rótulo, su Anton con sombra y sus botones de borde negro */
  .ochoa {
    background: var(--oc-paper);
    color: var(--oc-paper);
  }
  .ochoa::before {
    background: linear-gradient(to top, var(--oc-velo) 6%, var(--oc-velo-medio) 55%, var(--oc-velo-alto) 100%);
  }
  .rotulo {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 0.55em 1.5em 0.6em;
    border-radius: 50%;
    background: var(--oc-paper);
    border: 4px solid var(--oc-borde-rotulo);
    box-shadow: var(--sombra-rotulo);
    font-family: var(--oc-display);
    color: var(--oc-red);
    text-transform: uppercase;
    line-height: 1;
  }
  .rotulo small {
    font-size: clamp(0.62rem, 0.5rem + 0.4vw, 0.85rem);
    letter-spacing: 0.08em;
  }
  .rotulo b {
    font-weight: 400;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.4rem);
    letter-spacing: 0.01em;
    text-shadow: 0.045em 0.05em 0 var(--oc-ink);
  }
  .ochoa .lema {
    margin-top: 4px;
    max-width: 16ch;
    font-family: var(--oc-display);
    text-transform: uppercase;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-shadow: 0.05em 0.05em 0 var(--oc-red);
  }
  .ochoa .seña {
    font-family: var(--oc-sans);
    font-weight: 500;
    font-size: 0.82rem;
  }
  /* El botón es el `.btn` de Ochoa, tal cual (apps/ochoa/src/styles/global.css): rojo con sombra dura de
     tinta; con el ratón encima se oscurece y baja un píxel, y al pulsar se hunde los tres píxeles de su
     sombra y se queda pegado al papel, y al soltar vuelve a subir. Aquí lo acciona la mitad entera. */
  .ochoa .boton {
    margin-top: 4px;
    display: inline-block;
    padding: 12px 22px;
    border-radius: var(--oc-r-btn);
    background: var(--oc-red);
    color: var(--oc-paper);
    box-shadow: 3px 3px 0 var(--oc-ink);
    font-family: var(--oc-sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.005em;
    white-space: nowrap;
    transition:
      transform var(--oc-dur-out) var(--oc-ease),
      box-shadow var(--oc-dur-out) var(--oc-ease),
      background var(--oc-dur-out) var(--oc-ease);
  }
  @media (hover: hover) {
    .ochoa:hover .boton {
      background: var(--oc-red-2);
      transform: translate(1px, 1px);
      box-shadow: 2px 2px 0 var(--oc-ink);
    }
  }
  .ochoa .boton.tocando {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--oc-ink);
    transition: none;
  }
  .ochoa .boton.soltando {
    animation: tacto-sube var(--oc-dur-sube) var(--oc-ease);
  }
  @keyframes tacto-sube {
    from {
      transform: translate(3px, 3px);
      box-shadow: 0 0 0 var(--oc-ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cokima .boton,
    .ochoa .boton {
      transition: none;
    }
    .ochoa .boton.soltando {
      animation: none;
    }
  }

  /* La costura: el grupo, en la línea entre las dos (arriba en el centro en el ordenador) */
  .costura {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: block;
    padding: 12px 16px;
    background: var(--costura);
    border-radius: 10px;
    box-shadow: var(--sombra-costura);
  }
  .costura img {
    display: block;
    width: clamp(88px, 10vw, 120px);
    height: auto;
  }
  @media (min-width: 820px) {
    .costura {
      top: clamp(28px, 6vh, 56px);
      transform: translateX(-50%);
    }
  }

  /* Debajo: el grupo y el contacto */
  .contacto .wrap {
    display: grid;
    gap: 32px;
    padding-block: clamp(44px, 8vw, 88px);
  }
  @media (min-width: 900px) {
    .contacto .wrap {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 56px;
      align-items: start;
    }
  }
  .quienes {
    display: grid;
    gap: 16px;
  }
  .marca {
    width: 132px;
    height: auto;
  }
  .marca.claro {
    display: var(--logo-light);
  }
  .marca.oscuro {
    display: var(--logo-dark);
  }
  .contacto h2 {
    margin: 0 0 8px;
    font-size: var(--step-1);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .contacto p {
    margin: 0;
    color: var(--muted);
    max-width: 44ch;
  }
  .correo {
    display: inline-block;
    margin-top: 12px;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--red);
  }
</style>
