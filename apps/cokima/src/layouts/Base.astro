---
import "../styles/tokens.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Seo from "@tombo/ui/Seo.astro";
import ConsentBanner from "@tombo/ui/ConsentBanner.astro";
import QuietScrollHistory from "@tombo/ui/QuietScrollHistory.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { RESTAURANT } from "../site.ts";

interface Props {
  title: string;
  description: string;
  locale: "es" | "en";
  altPath: string;
}

const { title, description, locale, altPath } = Astro.props;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {/* `viewport-fit=cover`: ver el Base de Ochoa. Llegó a parecer el culpable de
        lo de la barra del navegador y no lo era. Es una decisión de plataforma y
        las dos casas van igual. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* PRIMERO EL ESQUEMA, LUEGO EL COLOR. Los dos metas hacen falta y no se
        sustituyen: `color-scheme` le dice al navegador en qué mundo está —y con
        eso deja de pintar SU interfaz en claro sobre una web negra—, y
        `theme-color` le da el tono exacto para la barra.

        Con solo el segundo no bastaba, que es lo que Mario vio el 2026-08-18 en
        el iPhone: `theme-color` llevaba puesto desde el principio y aun así
        salía una franja blanca arriba en Brave y la barra inferior gris en
        Safari. Un color propuesto no cambia el criterio con el que el navegador
        decide su propia interfaz.

        Va aquí además de en el CSS —`html { color-scheme: dark }`— porque el
        `<head>` se aplica antes de que llegue la hoja de estilos, y ese hueco es
        justo donde cabía el destello blanco. */}
    <meta name="color-scheme" content="dark" />
    {/* El tizón de la casa para la barra. Es el `--ground` sobre el que ya flota
        la cabecera, así que la barra deja de anunciarse al asomar. El
        razonamiento largo está en el Base de Ochoa. */}
    <meta name="theme-color" content="#150f0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-400.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} locale={locale} altPath={altPath} restaurant={RESTAURANT} ogImage="/images/hero.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Antes del router, que es a quien envuelve. Ver el Base de Ochoa y el
        propio componente: es lo que sacaba la barra del navegador al soltar. */}
    <QuietScrollHistory />
    <ClientRouter />
  </head>
  <body>
    <Nav locale={locale} altPath={altPath} />
    <slot />
    <Footer locale={locale} />
    <ConsentBanner locale={locale} cookiesPath="/cookies" />
    <script>
      import { initTracking } from "@tombo/tracking/client";

      function loadGtm(id: string) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
        const s = document.createElement("script");
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtm.js?id=${id}`;
        document.head.appendChild(s);
      }

      // Nada de medición sin consentimiento (spec §10).
      window.addEventListener(
        "tombo:consent",
        () => {
          const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
          if (gtmId) loadGtm(gtmId);
          initTracking({
            gtmId,
            pixelId: import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined,
            coverSlug: (import.meta.env.PUBLIC_COVERMANAGER_SLUG as string | undefined) ?? "restaurante-cokima",
          });
        },
        { once: true },
      );
    </script>
  </body>
</html>
