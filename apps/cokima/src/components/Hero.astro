---
// apps/cokima/src/components/Hero.astro
import { Image } from "astro:assets";
import OpenState from "@tombo/ui/OpenState.astro";
import Embers from "./Embers.astro";
import { RESTAURANT } from "../site.ts";
import hero from "../assets/hero.jpg";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";
---

<header class="hero" id="top">
  <Image
    src={hero}
    alt={es ? "Plato de Cokima recién servido" : "A Cokima dish, just served"}
    widths={[480, 780, 1200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="shot"
  />
  <Embers />
  <div class="veil"></div>
  <div class="wrap copy">
    <h1>
      {es ? (
        <>Puedes comer en cualquier sitio. <span class="red">Pero será solo comer.</span></>
      ) : (
        <>You can eat anywhere. <span class="red">But it will just be eating.</span></>
      )}
    </h1>
    <OpenState hours={RESTAURANT.openingHours} locale={locale} />
  </div>
</header>

<style>
  .hero {
    position: relative;
    /* svh y no vh: en móvil, vh cuenta con la barra del navegador retraída y la
       portada se corta por abajo justo donde queremos que asome el primer
       plato. Además de la cabecera se resta una franja de asomo: sin ella la
       portada llena la pantalla al píxel y la tira de platos queda invisible
       hasta que alguien decide bajar. Que asome es el punto entero. */
    height: calc(100svh - var(--t-header-h, 61px) - clamp(128px, 18vw, 156px));
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Degradado solo bajo el texto, no una capa uniforme sobre toda la foto:
     apagar la imagen entera es justo lo que hacen las cinco webs que nos
     pusieron de referencia, y es lo que las vuelve intercambiables. */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(21, 15, 12, 0.94) 0%,
      rgba(21, 15, 12, 0.72) 26%,
      rgba(21, 15, 12, 0) 62%
    );
  }
  /* El cartel de cookies vive en esta misma esquina durante la primera visita.
     `--t-consent-h` lo publica el propio cartel y vuelve a 0 al decidir, así
     que el titular se aparta mientras hace falta y no un píxel más. */
  .copy {
    position: relative;
    padding-bottom: calc(clamp(26px, 5vw, 54px) + var(--t-consent-h, 0px));
    width: 100%;
    transition: padding-bottom 200ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .copy {
      transition: none;
    }
  }
  .hero h1 {
    font-weight: 800;
    font-size: clamp(2.3rem, 8.2vw, 5.4rem);
    line-height: 0.99;
    letter-spacing: -0.025em;
    margin: 0 0 14px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .hero h1 .red {
    color: var(--vermilion);
  }
</style>
