---
// apps/cokima/src/components/Entrada.astro
//
// La landing de Cokima: la pantalla entera es el plato, el nombre en el medio y
// dos botones abajo. Y nada más. Ni claim, ni hamburguesa, ni el estado de
// abierto, ni el cartel de cookies: todo eso aparece al deslizar. Es una
// decisión de Mario y conviene no erosionarla añadiendo «solo una cosita más».
//
// Sustituye al Hero heredado, que era la portada de Ochoa con otra foto —foto a
// sangre, titular abajo a la izquierda y una tira de platos asomando debajo—.
//
// EL VÍDEO TODAVÍA NO EXISTE. Mario lo va a montar en Higgsfield con cuatro
// fotos de platos. La etiqueta `<video>` NO se pinta hasta que el archivo esté
// de verdad en `public/video/`: se comprueba aquí, al construir. La primera
// versión lo pintaba siempre confiando en `preload="none"`, y dejaba cuatro
// 404 en la consola de cada visita —el navegador pide las dos fuentes, y el
// script las volvía a pedir al llamar a load()—. Con la comprobación, hoy se
// ve el póster y el día que aparezca el archivo se ve el vídeo, sin tocar nada.
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { Image } from "astro:assets";
import { showPhotoGuides } from "@tombo/config/photo-guides";
import poster from "../assets/entrada-poster.jpg";

const publico = (n: string) => fileURLToPath(new URL(`../../public/video/${n}`, import.meta.url));
const hayMp4 = existsSync(publico("entrada.mp4"));
const hayWebm = existsSync(publico("entrada.webm"));
const hayVideo = hayMp4 || hayWebm;

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";

const t = es
  ? {
      carta: "Ver carta",
      reservar: "Reservar",
      alt: "Un plato de Cokima servido en la mesa del restaurante",
      hueco:
        "Falta el vídeo: cuatro platos en bucle y sin sonido, en public/video/entrada.mp4. En cuanto esté, se pone solo.",
    }
  : {
      carta: "See the menu",
      reservar: "Book a table",
      alt: "A Cokima dish served at the restaurant",
      hueco:
        "Video missing: four dishes on a loop, no sound, at public/video/entrada.mp4. It appears on its own once it is there.",
    };

const hrefCarta = es ? "/carta" : "/en/menu";
const hrefReserva = es ? "/reservas" : "/en/reservations";
const guias = showPhotoGuides();
---

<section class="entrada" id="top">
  {/* El póster es una imagen de verdad y no un fotograma: mientras no haya
      vídeo es lo único que se ve, y en iPhone con el ahorro de energía puesto
      seguirá siendo lo único que se vea aunque el vídeo exista. Por eso se
      procesa como cualquier otra foto de la casa, con sus tamaños. */}
  <Image
    src={poster}
    alt={t.alt}
    widths={[420, 720, 1080, 1440]}
    sizes="100vw"
    quality={74}
    loading="eager"
    fetchpriority="high"
    class="cartel"
  />

  {hayVideo && (
    <video
      class="cinta"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      {hayWebm && <source src="/video/entrada.webm" type="video/webm" />}
      {hayMp4 && <source src="/video/entrada.mp4" type="video/mp4" />}
    </video>
  )}

  {/* Un velo que sube desde abajo, no una capa uniforme: apagar la imagen
      entera es lo que vuelve intercambiables a las webs de restaurante, y ya
      se decidió así en la portada anterior. */}
  <div class="velo"></div>

  {/* El rótulo en el centro. Y como ahora el nombre se ve de verdad, el `<h1>`
      deja de tener que ir escondido para que la página conserve su encabezado:
      es el mismo elemento haciendo las dos cosas. */}
  <h1 class="rotulo">
    <span class="nombre">Cokima</span>
    <span class="sub">Kitchen Madness</span>
  </h1>

  <div class="wrap pie">
    {/* El aviso de que hay más abajo. NO es el ratoncito con la ruedita ni la
        flecha que rebota: los dos son el mismo cliché y se reconocen antes de
        entenderlos. Aquí es un pulso de luz que baja por un riel, que es como
        se enciende un tubo de neón —y de neón sabe este local—. Decorativo del
        todo: la página se desliza igual sin él, así que no entra en el árbol de
        accesibilidad ni le habla a nadie. */}
    <svg class="baja" viewBox="0 0 2 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <line class="riel" x1="1" y1="0" x2="1" y2="40" />
      <line class="chispa" x1="1" y1="0" x2="1" y2="40" pathLength="100" />
    </svg>

    <div class="botones">
      <a class="btn" href={hrefCarta}>{t.carta}</a>
      <a class="btn ghost" href={hrefReserva}>{t.reservar}</a>
    </div>
  </div>

  {guias && <p class="hueco">{t.hueco}</p>}

  {/* Centinela: mientras este píxel del final de la entrada siga en pantalla,
      la cabecera flota sin fondo. En cuanto se va por arriba, vuelve a ser una
      barra normal. Va aquí y no en el Nav porque es la entrada la que pide que
      la cabecera se aparte, no la cabecera la que sabe de portadas. */}
  <i class="centinela" aria-hidden="true"></i>
</section>

<script>
  /* La portada mide una vez y se queda quieta hasta que cambie el ancho.
   *
   * Es el mismo congelado que ya llevaba el Hero anterior, y sigue haciendo
   * falta por lo mismo: en cuanto un navegador toca el alto del viewport —y
   * ocultar la barra de direcciones al deslizar es exactamente eso—, una
   * portada dimensionada en `svh` cambia de tamaño, empuja todo lo que tiene
   * debajo e invalida la capa entera del documento. Medido en su día: la
   * portada pasaba de 623 a 561px y arrastraba el documento de 2990 a 2928.
   *
   * Solo se vuelve a medir cuando cambia el ANCHO, que es el único cambio de
   * viewport que de verdad afecta al cálculo. Una rotación recoloca; un vaivén
   * de barras no toca nada.
   *
   * Si el script no llega a correr, manda el `calc()` del CSS y la portada
   * mide exactamente lo mismo: esto no añade una medida, congela la que ya
   * había. El caso entero está en docs/barra-del-navegador-ios.md.
   */
  let sueltaAnterior: (() => void) | undefined;

  const montaEntrada = () => {
    const entrada = document.querySelector<HTMLElement>(".entrada");
    if (!entrada) return undefined;

    const raiz = document.documentElement;
    const abort = new AbortController();
    let anchoMedido = -1;

    const mide = () => {
      if (window.innerWidth === anchoMedido) return;
      anchoMedido = window.innerWidth;
      raiz.style.removeProperty("--alto-entrada");
      raiz.style.setProperty(
        "--alto-entrada",
        `${Math.round(entrada.getBoundingClientRect().height)}px`,
      );
    };

    mide();
    window.addEventListener("resize", mide, { passive: true, signal: abort.signal });

    return () => {
      abort.abort();
      raiz.style.removeProperty("--alto-entrada");
    };
  };

  /* El vídeo no se pide hasta que se sabe que se puede reproducir: con
   * `preload="none"` el navegador no descarga nada por su cuenta, así que sin
   * esto no llegaría a sonar ni el primer fotograma. Y no se pide en absoluto
   * si quien mira ha dicho que no quiere movimiento, o si el archivo todavía no
   * existe —que es el caso hoy—: en los dos casos se queda el póster, que es
   * una foto real y no un hueco. */
  const montaCinta = () => {
    const cinta = document.querySelector<HTMLVideoElement>(".cinta");
    if (!cinta) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    cinta.load();
    /* En iPhone con el ahorro de energía activado, `play()` se rechaza aunque
       el vídeo esté silenciado. No es un error que haya que registrar: es el
       teléfono diciendo que no, y la respuesta correcta es quedarse en el
       póster. */
    cinta.play().then(
      () => cinta.classList.add("puesta"),
      () => {},
    );
  };

  /* Mientras la entrada ocupa la pantalla, la cabecera flota encima sin fondo y
   * sin su botón de reservar, que abajo está a tamaño de pulgar. El estado vive
   * en el <html> para que lo lea el Nav sin que ninguno de los dos importe al
   * otro. */
  let sueltaCabecera: (() => void) | undefined;

  const montaCabecera = () => {
    const centinela = document.querySelector(".centinela");
    const raiz = document.documentElement;
    if (!centinela) {
      /* Otras páginas no tienen entrada. Con el router de Astro el <html>
         sobrevive a la navegación, así que hay que borrar la marca a mano o la
         carta hereda una cabecera transparente sobre nada. */
      raiz.removeAttribute("data-sobre-entrada");
      return undefined;
    }

    const ojo = new IntersectionObserver(
      ([e]) => raiz.toggleAttribute("data-sobre-entrada", e.isIntersecting),
      { threshold: 0 },
    );
    ojo.observe(centinela);

    return () => {
      ojo.disconnect();
      raiz.removeAttribute("data-sobre-entrada");
    };
  };

  document.addEventListener("astro:page-load", () => {
    sueltaAnterior?.();
    sueltaCabecera?.();
    sueltaAnterior = montaEntrada();
    sueltaCabecera = montaCabecera();
    montaCinta();
  });
</script>

<style>
  .entrada {
    position: relative;
    /* La pantalla entera, y no la pantalla menos la cabecera: aquí la cabecera
       flota encima en vez de ocupar sitio. `svh` y no `vh` por lo de siempre —
       `vh` cuenta con la barra del navegador retraída y recorta los botones por
       abajo justo en el móvil, que es donde más importan. El valor congelado lo
       publica el script. */
    /* Dos filas: el rótulo flota en todo el hueco libre y los botones se apoyan
       abajo. Con `flex-end`, que es como estaba, el rótulo habría quedado
       pegado a los botones en vez de en el medio. */
    display: grid;
    grid-template-rows: 1fr auto;
    height: var(--alto-entrada, 100svh);
    /* Y se sube por debajo de la cabecera. La barra es `sticky`, así que aunque
       parezca flotar SÍ reserva sus 61px en el flujo: sin este margen la entrada
       empezaba debajo de ella y se salía otro tanto por abajo. Medido: su final
       caía en y=904 con un viewport de 844, y el centinela nunca llegaba a
       entrar en pantalla, así que la cabecera no se volvía transparente jamás.
       `--t-header-h` lo republica el Nav en cliente con el alto real. */
    margin-top: calc(-1 * var(--t-header-h, 61px));
    min-height: 520px;
    overflow: hidden;
    isolation: isolate;
  }
  .cartel,
  .cinta {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* El vídeo entra por encima del póster y solo cuando ya está reproduciéndose:
     así no hay ni un fotograma en negro entre la foto y la cinta. */
  .cinta {
    z-index: -1;
    opacity: 0;
    transition: opacity var(--dur-in) var(--ease);
  }
  .cinta.puesta {
    opacity: 1;
  }
  .velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Los topes salen de medir dónde cae el texto, no de tantear: el claim
       ocupa del 37% al 55% de la altura contando desde abajo, y el estado llega
       al 59%. Con la curva anterior —0.52 al 46%— el píxel más claro que queda
       bajo el claim daba 2,13:1 con el texto hueso, cuando un titular de 40px
       necesita 3:1. Así que el velo se mantiene denso hasta pasado el 62% y
       solo entonces se abre, que es lo que deja el plato limpio arriba, que es
       donde se mira. */
    background: linear-gradient(
      to top,
      rgba(21, 15, 12, 0.97) 0%,
      rgba(21, 15, 12, 0.9) 32%,
      rgba(21, 15, 12, 0.81) 62%,
      rgba(21, 15, 12, 0.18) 86%,
      rgba(21, 15, 12, 0) 100%
    );
  }
  /* El velo tiene que ir por encima del vídeo, no solo del póster. */
  .cinta.puesta ~ .velo {
    z-index: -1;
  }

  /* El rótulo, centrado en todo el hueco que dejan los botones. */
  .rotulo {
    position: relative;
    align-self: center;
    justify-self: center;
    margin: 0;
    text-align: center;
    display: grid;
    gap: clamp(6px, 1.2vh, 12px);
    /* La misma sombra ancha y difusa que llevaba el claim, y por el mismo
       motivo: cuando entre el vídeo el fondo cambiará en cada fotograma y no
       hay degradado que sirva para todos. */
    text-shadow: 0 2px 28px rgba(21, 15, 12, 0.85);
  }
  .nombre {
    font-weight: 800;
    font-size: clamp(3.2rem, 16vw, 7rem);
    line-height: 0.9;
    /* El nombre respira en vez de apretarse: es un rótulo, no un titular de
       lectura, y los titulares de esta casa van con tracking negativo. */
    letter-spacing: 0.01em;
  }
  .sub {
    font-weight: 600;
    font-size: clamp(0.78rem, 3.2vw, 1rem);
    letter-spacing: 0.34em;
    /* El tracking abre por los dos lados y descentra la línea respecto al
       nombre; el margen izquierdo compensa el hueco que sobra a la derecha. */
    margin-left: 0.34em;
    text-transform: uppercase;
    /* Ni el hueso entero —competiría con el nombre— ni `--bone-dim`, que a este
       tamaño se quedaba en 4,37:1 sobre la foto y el mínimo son 4,5. Un punto
       más claro que el apagado, sin traer un color nuevo a la paleta. La
       primera línea es el respaldo para quien no entienda `color-mix`: se
       quedaría sin color de texto y heredaría el hueso a secas. */
    color: var(--bone-dim);
    color: color-mix(in srgb, var(--bone) 34%, var(--bone-dim));
  }

  /* ── El pulso que baja ──────────────────────────────────────────────────
     Un riel apenas visible y una chispa que lo recorre de arriba abajo, se va
     por el extremo y deja una pausa antes de volver. Sin rebote y sin vuelta
     atrás: lo que rebota es un muelle, y esto es luz.

     Va con `stroke-dashoffset` sobre `pathLength="100"`, así que el trazo se
     mide en porcentaje y no en píxeles: cambiar el alto del riel no descuadra
     la animación. Y la pausa está dentro de los propios fotogramas —cae en el
     55% del ciclo y el resto espera fuera de vista—, que sale más barato que
     encadenar dos animaciones. */
  .baja {
    justify-self: center;
    width: 2px;
    height: clamp(26px, 4.4vh, 40px);
    /* La separación que pidió Mario: el pulso no puede quedar pegado al botón
       ni parecer parte de él. */
    margin-bottom: clamp(18px, 3vh, 28px);
    overflow: visible;
  }
  /* El riel tiene que verse aunque tenuemente: al 22% daba 1,54:1 sobre la foto
     —invisible— y durante el segundo y medio de pausa no quedaba nada en
     pantalla, así que la chispa aparecía de la nada en vez de recorrer algo. */
  .riel {
    stroke: rgba(243, 234, 221, 0.36);
    stroke-width: 2;
  }
  .chispa {
    stroke: var(--bone);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 26 100;
    animation: pulso-baja 3.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes pulso-baja {
    0% {
      stroke-dashoffset: 26;
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    48% {
      opacity: 1;
    }
    55% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  /* Igual que el rescoldo: nada se mueve cuando no se le ve. Y en cuanto se
     empieza a bajar el aviso sobra, porque ya se ha hecho caso. */
  :global(html:not([data-sobre-entrada])) .chispa {
    animation-play-state: paused;
  }

  .pie {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
    /* Pegados abajo, que es lo que pidió Mario, pero nunca por debajo de la
       barra de gestos del iPhone: con `viewport-fit=cover` la página llega al
       borde físico y sin el `env()` los botones acabarían debajo del pasamanos.
       Sin apartarse por `--t-consent-h`, además: el cartel de cookies ya no
       aparece mientras se está en la entrada. */
    padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px));
  }

  .botones {
    display: grid;
    gap: 10px;
    /* Apilados y a todo el ancho en móvil, que es como están en la referencia y
       como se pulsan con el pulgar. En cuanto hay sitio se ponen en fila y
       dejan de estirarse: un botón de 600px de ancho no lo pulsa nadie. */
    width: 100%;
    max-width: 420px;
  }
  @media (min-width: 620px) {
    .botones {
      display: flex;
      gap: 12px;
      max-width: none;
    }
  }
  .botones .btn {
    /* La píldora sale de `--r-control`, que es la decisión de marca: aquí todo
       lo que se pulsa es redondo del todo, al revés que en la tasca.

       Achatados, como los quería Mario, pero no por debajo de 48px: es el área
       que hace falta para acertar con el pulgar sin mirar, y una píldora ancha
       y baja engaña —parece más grande de lo que es de alto—. Con 48 se ve
       claramente más plano que los 54 de antes y se sigue pulsando bien. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 30px;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }
  .botones .btn.ghost {
    /* El contorno claro y no el borde tenue de `.ghost`: sobre una foto, una
       línea al 12% de opacidad no se ve. */
    border-color: rgba(243, 234, 221, 0.55);
    background: rgba(21, 15, 12, 0.28);
    backdrop-filter: blur(6px);
  }
  .botones .btn.ghost:hover {
    border-color: var(--bone);
    background: rgba(21, 15, 12, 0.5);
  }

  /* ── El rescoldo ────────────────────────────────────────────────────────
     Mario los quería «vivos», con una sombra que se mueva, y avisó de no caer
     en lo de siempre. Lo de siempre es: un brillo que barre la pieza de
     izquierda a derecha, un halo que late con ritmo, o un borde de degradado
     girando. Los tres se reconocen al primer vistazo porque tienen CADENCIA —
     se les oye el compás— y porque el gesto no significa nada.

     Esto es otra cosa. Cokima es un mundo de brasa: sus colores se llaman
     `vermilion` y `ember`, el local tiene un mural de fuego y un neón. Y una
     brasa no late ni barre: su luz se mueve poco, despacio y sin compás. De ahí
     las tres reglas de este efecto:

       1. LENTO      19 y 26 segundos por vuelta. A esa velocidad no se ve
                     moverse; se nota que no está quieto, que es distinto.
       2. POCO       tres píxeles de recorrido y un 3% de escala. Si se aprecia
                     el desplazamiento, ya es demasiado.
       3. SIN COMPÁS los fotogramas clave caen en 23%, 41%, 68% y 86%, que no
                     son equidistantes, y los dos botones llevan duraciones y
                     retardos distintos. Nunca coinciden, así que no hay pulso
                     que seguir.

     Se anima un pseudo-elemento con `transform` y no la `box-shadow` del botón:
     una sombra animada repinta en cada fotograma, y esto se compone en la GPU
     sin tocar el dibujo. */
  .botones .btn {
    position: relative;
    z-index: 0;
  }
  .botones .btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    /* El sólido irradia su propio rojo. */
    background: var(--vermilion);
    filter: blur(11px);
    opacity: 0.4;
    animation: rescoldo 19s ease-in-out infinite;
  }
  /* El de contorno no irradia color —sería un botón rojo disfrazado—: lo que se
     mueve detrás es el propio fondo de la casa, y sirve para despegarlo de la
     foto, que es lo que de verdad le hace falta ahí. */
  .botones .btn.ghost::before {
    background: var(--ground);
    filter: blur(16px);
    opacity: 0.55;
    animation-duration: 26s;
    animation-delay: -7s;
  }
  @keyframes rescoldo {
    0% {
      transform: translate3d(-2px, 1px, 0) scale(1);
      opacity: 0.36;
    }
    23% {
      transform: translate3d(2px, -1px, 0) scale(1.02);
      opacity: 0.5;
    }
    41% {
      transform: translate3d(3px, 2px, 0) scale(1.01);
      opacity: 0.41;
    }
    68% {
      transform: translate3d(-1px, -2px, 0) scale(1.03);
      opacity: 0.52;
    }
    86% {
      transform: translate3d(-3px, 0, 0) scale(1.01);
      opacity: 0.39;
    }
    100% {
      transform: translate3d(-2px, 1px, 0) scale(1);
      opacity: 0.36;
    }
  }
  /* Nada se mueve fuera de pantalla: es la regla 6 de `movimiento.md`, la misma
     por la que la cinta rotulada de la tasca se para cuando no se la ve. Aquí
     el aviso llega gratis, porque `data-sobre-entrada` ya dice si la entrada
     sigue delante. */
  :global(html:not([data-sobre-entrada])) .botones .btn::before {
    animation-play-state: paused;
  }

  /* Un píxel al final de la sección, sin tamaño ni color: solo existe para que
     el observador tenga algo que mirar. */
  .centinela {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }

  /* El hueco del vídeo, solo en desarrollo y en las previews por rama. Lo
     decide `showPhotoGuides()` y hay tests que fijan que en producción no
     existe: no es cuestión de acordarse de quitarlo.

     Y espera fuera como el rótulo y la hamburguesa: si no, el único cartel de
     una pantalla que se ha vaciado a propósito sería el aviso de que falta un
     vídeo, plantado justo encima de lo que hay que juzgar. El hueco se sigue
     marcando; solo espera su turno. */
  .hueco {
    position: absolute;
    left: 50%;
    top: 16px;
    transform: translateX(-50%);
    margin: 0;
    z-index: 2;
    max-width: min(92%, 30rem);
    text-align: center;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--bone);
    background: rgba(21, 15, 12, 0.82);
    border: 1px dashed var(--ember);
    border-radius: var(--r-caja);
    padding: 7px 12px;
    backdrop-filter: blur(4px);
    transition: opacity var(--dur-in) var(--ease);
  }
  :global(html[data-sobre-entrada]) .hueco {
    opacity: 0;
    visibility: hidden;
