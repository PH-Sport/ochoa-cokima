---
// apps/cokima/src/components/Contacto.astro
//
// El teléfono y el Instagram de Cokima como dos acciones (Mario, 2026-11-02: «No te olvides del
// Instagram y del teléfono, tal y como hicimos con Ochoa»). La idea es la de Ochoa —icono, lo que hace
// y cuál es: el número escrito es lo que alguien copia o lee en voz alta—, pero la pieza es de Brasa:
// píldoras, porque se pulsan, y su estilo en brasa.css (.contacto). En el móvil el primero abre el
// marcador y el segundo la app de Instagram. Va en Visítanos y al pie del desplegable del móvil.
import { RESTAURANT } from "../site.ts";

const telHref = `tel:${RESTAURANT.telephone.replace(/\s/g, "")}`;
// Sin el prefijo internacional: es el número tal y como lo diría alguien de aquí.
const telVisible = RESTAURANT.telephone.replace(/^\+34\s*/, "");
const instagram = RESTAURANT.instagram ?? "";
const usuario = "@" + instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, "").replace(/\/$/, "");
---

<ul class="contacto">
  <li>
    <a href={telHref}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
      </svg>
      <span class="etq">Llamar</span>
      <span class="dato">{telVisible}</span>
    </a>
  </li>
  <li>
    <a href={instagram} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      <span class="etq">Instagram</span>
      <span class="dato">{usuario}</span>
    </a>
  </li>
</ul>
