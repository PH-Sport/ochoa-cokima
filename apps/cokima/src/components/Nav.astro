---
interface Props {
  locale: "es" | "en";
  altPath: string;
}
const { locale, altPath } = Astro.props;
const es = locale === "es";
const links = es
  ? [
      { href: "/carta", label: "La carta" },
      { href: "/reservas", label: "Reservas" },
      { href: "/#visita", label: "Dónde estamos" },
    ]
  : [
      { href: "/en/menu", label: "Menu" },
      { href: "/en/reservations", label: "Reservations" },
      { href: "/en/#visit", label: "Find us" },
    ];
const home = es ? "/" : "/en/";
const reserve = es ? "/reservas" : "/en/reservations";
---

<nav class="nav">
  <div class="wrap nav-in">
    <a class="brand" href={home}>Cokima<i class="spark" aria-hidden="true"></i></a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <div class="nav-right">
      <span class="lang">
        {es ? <><b>ES</b> · <a href={altPath}>EN</a></> : <><a href={altPath}>ES</a> · <b>EN</b></>}
      </span>
      <a href={reserve} class="btn">{es ? "Reservar" : "Book"}</a>
    </div>
  </div>
</nav>

<script>
  // El alto de la cabecera cambia por breakpoint y por idioma (los enlaces en
  // español son más largos y pueden envolver a otra fila en pantallas muy
  // estrechas). Los tokens de tokens.css llevan el valor medido como punto de
  // partida — el sticky es correcto sin JavaScript — y aquí se afina con el
  // alto real para que las tabs de la carta nunca se solapen ni dejen hueco.
  const mount = () => {
    const nav = document.querySelector<HTMLElement>(".nav");
    if (!nav) return;
    const sync = () => {
      document.documentElement.style.setProperty(
        "--t-header-h",
        `${Math.ceil(nav.getBoundingClientRect().height)}px`,
      );
    };
    sync();
    new ResizeObserver(sync).observe(nav);
  };

  // `astro:after-swap` y no `astro:page-load`: este último también dispara en
  // la carga inicial, así que con ClientRouter activo duplicaría el observer.
  mount();
  document.addEventListener("astro:after-swap", mount);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(21, 15, 12, 0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-in {
    display: flex;
    align-items: center;
    gap: 22px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    font-weight: 800;
    font-size: 1.42rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .spark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vermilion);
    box-shadow: 0 0 8px 2px var(--ember), 0 0 2px 1px var(--vermilion);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .lang {
    font-size: 0.9rem;
    color: var(--bone-dim);
  }
  .lang b {
    color: var(--bone);
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 0.98rem;
    color: var(--bone-dim);
  }
  .nav-links a:hover {
    color: var(--bone);
  }
  @media (max-width: 780px) {
    .nav-in {
      height: auto;
      flex-wrap: wrap;
      padding-block: 10px;
      row-gap: 8px;
    }
    /* .nav-links es hijo directo de .nav-in, así que el wrap
       de arriba sí lo alcanza: flex-basis: 100% lo manda a su
       propia fila dentro de .nav-in. */
    .nav-links {
      order: 3;
      flex-basis: 100%;
      gap: 18px;
      font-size: 0.9rem;
    }
    .nav-links a {
      /* línea 23.04px (0.9rem × 1.6 heredado) + 11px × 2 de padding = 45.04px ≥ 44px área táctil */
      padding-block: 11px;
    }
  }
  /* Por debajo de 861px, ReserveBar (fija, al pie) ya lleva el CTA de
     reserva: ocultamos el de la cabecera para no duplicarlo en pantalla.
     El selector de idioma y los enlaces de navegación siguen visibles. */
  @media (max-width: 860px) {
    .nav-right .btn {
      display: none;
    }
  }
</style>
