---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Embers from "../../components/Embers.astro";
import MenuDeck from "../../components/MenuDeck.astro";
import { ALLERGEN_LABELS } from "../../site.ts";

const featured = (await getCollection("menu-en", (e) => e.data.featured)).map((e) => e.data);
---

<Base
  title="Cokima — Kitchen Madness · Restaurant in Madrid"
  description="An explosion of flavour at Andrés Mellado 21, Madrid. Sharing plates from classic Madrid recipes to the most exotic kitchen. Book your table."
  locale="en"
  altPath="/"
>
  <header class="hero" id="top">
    <Embers />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Kitchen Madness · Madrid</p>
        <h1>You can eat anywhere. <span class="red">But it will just be eating.</span></h1>
        <p class="kicker">
          An explosion of flavour. A concept built for sharing: from Madrid's classic recipes to the
          most exotic kitchen, with fresh produce and no fear of mixing.
        </p>
        <div class="hero-cta">
          <a href="/en/reservations" class="btn">Book a table</a>
          <a href="/en/menu" class="btn ghost">See the menu</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/images/hero.jpg" alt="Cokima dish on dark slate" width="1200" height="1200" loading="eager" fetchpriority="high" />
        <span class="tag">Sharing is caring</span>
      </div>
    </div>
  </header>

  <section class="picks">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Not to be missed</p>
        <h2>The essentials</h2>
      </div>
      <MenuDeck
        sections={[{ id: "imprescindibles", title: "Selection", dishes: featured }]}
        locale="en"
        allergenLabels={ALLERGEN_LABELS.en}
      />
      <p class="more"><a href="/en/menu" class="btn ghost">Full menu</a></p>
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap">
      <p class="quote">“We love to mix, experiment, get messy.”</p>
    </div>
  </section>

  <section class="visita" id="visit">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Find us</p>
        <h2>Chamberí, Madrid</h2>
      </div>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Address</dt><dd>C. de Andrés Mellado, 21<small>28015 Madrid</small></dd></div>
          <div class="block"><dt>Phone</dt><dd><a href="tel:+34915989401">+34 915 98 94 01</a></dd></div>
          <div class="block"><dt>Hours</dt><dd>Monday to Sunday · 9:00 – 00:00<small>Kitchen 13:00–16:00 & 19:30–23:30</small></dd></div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/cokimamadrid">@cokimamadrid</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Map placeholder: Andrés Mellado 21, Madrid">
          <div class="pin"><i class="dot"></i><span>Andrés Mellado 21</span></div>
          <span class="ph">Map · integration pending</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Ver apps/cokima/src/pages/index.astro para el porqué de la compresión del
     hero y del reordenado de la foto en móvil. */
  .hero { position: relative; padding: clamp(28px, 5vw, 72px) 0 clamp(24px, 4vw, 48px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 64px); align-items: center; position: relative; z-index: 1; }
  .hero h1 { font-weight: 800; font-size: clamp(2.9rem, 8.4vw, 6rem); line-height: 0.98; letter-spacing: -0.025em; margin: 0.3em 0 0; text-wrap: balance; }
  .hero h1 .red { color: var(--vermilion); }
  .kicker { max-width: 46ch; color: var(--bone-dim); font-size: 1.1rem; margin: 1.5rem 0 0; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2.1rem; }
  .hero-photo { position: relative; border: 1px solid var(--ground-3); border-radius: 5px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8); aspect-ratio: 4 / 5; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; }
  .hero-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(150deg, rgba(21, 15, 12, 0) 40%, rgba(21, 15, 12, 0.55) 100%); }
  .hero-photo .tag { position: absolute; left: 16px; bottom: 16px; z-index: 2; font-family: var(--serif); font-style: italic; font-size: 1rem; background: rgba(21, 15, 12, 0.55); border: 1px solid var(--line); padding: 6px 12px; border-radius: 3px; }
  /* Después de las reglas base del hero a propósito: misma especificidad, gana
     el último. */
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 22px; }
    .hero-copy { display: contents; }
    .hero-copy .eyebrow { order: 1; }
    .hero-copy h1 { order: 2; }
    .hero-copy .kicker { order: 3; }
    .hero-photo { order: 4; aspect-ratio: 3 / 2; }
    .hero-copy .hero-cta { order: 5; margin-top: 0; }
    .hero h1 { font-size: clamp(2.4rem, 8vw, 3.4rem); }
    .kicker { font-size: 1rem; margin-top: 1rem; }
  }
  .manifesto { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(44px, 7vw, 88px) 0; }
  .quote { font-family: var(--serif); font-style: italic; font-size: clamp(1.55rem, 3.6vw, 2.6rem); line-height: 1.3; max-width: 24ch; margin: 0; text-wrap: balance; }
  .picks, .visita { padding: clamp(52px, 8vw, 96px) 0 0; }
  .more { margin-top: 2.2rem; }
  .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 56px); align-items: stretch; margin-top: 2rem; }
  @media (max-width: 820px) { .visit-grid { grid-template-columns: 1fr; } }
  .info { margin: 0; }
  .block { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .block dt { font-family: var(--serif); font-style: italic; font-size: 1.02rem; color: var(--ember); margin: 0 0 0.45rem; }
  .block dd { margin: 0; font-size: 1.1rem; }
  .block dd small { display: block; color: var(--bone-dim); font-size: 0.9rem; margin-top: 0.3rem; }
  .mapbox { position: relative; border: 1px solid var(--ground-3); border-radius: 8px; overflow: hidden; min-height: 280px; background: radial-gradient(circle at 62% 42%, rgba(237, 28, 36, 0.16), transparent 45%), repeating-linear-gradient(0deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px), repeating-linear-gradient(90deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px), var(--ground-2); }
  .pin { position: absolute; left: 62%; top: 42%; transform: translate(-50%, -100%); text-align: center; }
  .dot { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--vermilion); margin: 0 auto; box-shadow: 0 0 0 6px rgba(237, 28, 36, 0.22), 0 0 16px 3px var(--ember); }
  .pin span { font-size: 0.82rem; background: rgba(21, 15, 12, 0.7); padding: 4px 10px; border-radius: 3px; margin-top: 8px; display: inline-block; }
  .ph { position: absolute; left: 16px; bottom: 12px; font-size: 0.82rem; color: var(--bone-faint); }
</style>
