---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import Base from "../../layouts/Base.astro";
import Entrada from "../../components/Entrada.astro";
import Highlights from "../../components/Highlights.astro";

const featured = pickFeatured((await getCollection("menu-en")).map((e) => e.data));
---

<Base
  title="Cokima — Kitchen Madness · Restaurant in Madrid"
  description="An explosion of flavour at Andrés Mellado 21, Madrid. Sharing plates from classic Madrid recipes to the most exotic kitchen. Book your table."
  locale="en"
  altPath="/"
>
  <Entrada locale="en" />

  <Highlights dishes={featured} locale="en" href="/en/menu" />

  <section class="manifesto">
    <div class="wrap">
      <p class="quote">“We love to mix, experiment, get messy.”</p>
    </div>
  </section>

  <section class="visita" id="visit">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Find us</p>
        <h2>Chamberí, Madrid</h2>
      </div>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Address</dt><dd>C. de Andrés Mellado, 21<small>28015 Madrid</small></dd></div>
          <div class="block"><dt>Phone</dt><dd><a href="tel:+34915989401">+34 915 98 94 01</a></dd></div>
          <div class="block"><dt>Hours</dt><dd>Monday to Sunday · 9:00 – 00:00<small>Kitchen 13:00–16:00 & 19:30–23:30</small></dd></div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/cokimamadrid">@cokimamadrid</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Map placeholder: Andrés Mellado 21, Madrid">
          <div class="pin"><i class="dot"></i><span>Andrés Mellado 21</span></div>
          <span class="ph">Map · integration pending</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(44px, 7vw, 88px) 0; }
  .quote { font-family: var(--serif); font-style: italic; font-size: clamp(1.55rem, 3.6vw, 2.6rem); line-height: 1.3; max-width: 24ch; margin: 0; text-wrap: balance; }
  .visita { padding: clamp(52px, 8vw, 96px) 0 0; }
  /* `minmax(0, 1fr)` y no `1fr`: ver la versión española, donde está el motivo. */
  .visit-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 56px); align-items: stretch; margin-top: 2rem; }
  @media (max-width: 820px) { .visit-grid { grid-template-columns: 1fr; } }
  .info { margin: 0; }
  .block { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .block dt { font-family: var(--serif); font-style: italic; font-size: 1.02rem; color: var(--ember); margin: 0 0 0.45rem; }
  .block dd { margin: 0; font-size: 1.1rem; }
  .block dd small { display: block; color: var(--bone-dim); font-size: 0.9rem; margin-top: 0.3rem; }
  .mapbox { position: relative; border: 1px solid var(--ground-3); border-radius: 8px; overflow: hidden; min-height: 280px; background: radial-gradient(circle at 62% 42%, rgba(237, 28, 36, 0.16), transparent 45%), repeating-linear-gradient(0deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px), repeating-linear-gradient(90deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px), var(--ground-2); }
  .pin { position: absolute; left: 62%; top: 42%; transform: translate(-50%, -100%); text-align: center; }
  .dot { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--vermilion); margin: 0 auto; box-shadow: 0 0 0 6px rgba(237, 28, 36, 0.22), 0 0 16px 3px var(--ember); }
  .pin span { font-size: 0.82rem; background: rgba(21, 15, 12, 0.7); padding: 4px 10px; border-radius: 3px; margin-top: 8px; display: inline-block; }
  .ph { position: absolute; left: 16px; bottom: 12px; font-size: 0.82rem; color: var(--bone-faint); }
</style>
