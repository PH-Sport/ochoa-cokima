---
import Base from "../../layouts/Base.astro";
import BookingEmbed from "@tombo/ui/BookingEmbed.astro";
import { COVER_SLUG } from "../../site.ts";
---

<Base
  title="Reservations · Cokima — Kitchen Madness"
  description="Book your table at Cokima, Andrés Mellado 21, Madrid. Kitchen open 13:00–16:00 and 19:30–23:30."
  locale="en"
  altPath="/reservas"
>
  <section class="reservar">
    <div class="wrap">
      <div class="grid">
        <div>
          <p class="eyebrow">Reservations</p>
          <h1>Book your table</h1>
          <p class="txt">
            Kitchen open 13:00–16:00 and 19:30–23:30, every day.
            Can't find a slot? Call us on <a href="tel:+34915989401">+34 915 98 94 01</a>.
          </p>
        </div>
        <BookingEmbed slug={COVER_SLUG} locale="en" title="Cokima reservations" />
      </div>
    </div>
  </section>
</Base>

<style>
  .reservar {
    padding: clamp(52px, 8vw, 96px) 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1;
    margin: 0.15rem 0 0;
    letter-spacing: -0.02em;
  }
  .txt {
    color: var(--bone-dim);
    margin: 1.1rem 0 0;
    max-width: 42ch;
  }
  .txt a {
    color: var(--bone);
    text-decoration: underline;
  }
</style>
