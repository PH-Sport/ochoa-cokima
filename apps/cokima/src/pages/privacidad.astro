---
import Base from "../layouts/Base.astro";
---

<Base title="Política de privacidad · Cokima" description="Política de privacidad de Cokima." locale="es" altPath="/en/">
  <section class="legal">
    <div class="wrap">
      <h1>Política de privacidad</h1>
      <p>
        Los datos facilitados a través del módulo de reservas son tratados por CoverManager
        como encargado del tratamiento para gestionar tu reserva. No almacenamos datos
        personales en este sitio web.
      </p>
      <p>
        El responsable del tratamiento es <em>[razón social pendiente — datos fiscales del
        cliente]</em>. Este contenido se completará antes de la puesta en producción.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal { padding: clamp(52px, 8vw, 96px) 0 0; }
  h1 { font-weight: 800; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.02em; }
  p { color: var(--bone-dim); max-width: 65ch; }
</style>
