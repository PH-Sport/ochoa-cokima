---
// La home de Cokima es Brasa desde el 2026-10-31: el boceto que eligió Mario, en una sola página
// con cuatro secciones y Reservar (docs/cokima-el-rediseno.md §3). No usa Base.astro: es el marco de la
// web anterior —su cabecera, su pie, su cartel de cookies y el router de transiciones—, y Brasa
// trae su propia barra y cambia de sección sin recargar. Las legales siguen con Base.
import "../styles/tokens.css";
import "../styles/brasa.css";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Seo from "@tombo/ui/Seo.astro";
import BookingEmbed from "@tombo/ui/BookingEmbed.astro";
import Contacto from "../components/Contacto.astro";
import { RESTAURANT, COVER_SLUG } from "../site.ts";
import poster from "../assets/entrada-poster.jpg";

// El vídeo de la entrada, detrás de la portada (Mario, 2026-10-31: «a modo provisional»). Se busca
// con import.meta.glob por lo mismo que en Entrada.astro, que explica la trampa: la existencia la
// resuelve el bundler, no el sistema de ficheros. Dos cortes: el vertical y, en el ordenador, el
// ancho, que elige brasa.js al arrancar.
const cintas = import.meta.glob<string>("../assets/video/entrada{,-ancho}.{mp4,webm}", {
  eager: true,
  query: "?url",
  import: "default",
});
const url = (nombre: string, ext: string) =>
  Object.entries(cintas).find(([ruta]) => ruta.endsWith(`/${nombre}.${ext}`))?.[1];
const mp4 = url("entrada", "mp4");
const webm = url("entrada", "webm");
const mp4Ancho = url("entrada-ancho", "mp4");
const webmAncho = url("entrada-ancho", "webm");

// La piel de Brasa para el motor de CoverManager (ver pages/covermanager.css.ts). En local no se
// aplica: el motor es https y no carga una hoja de http://localhost.
const coverTemplate = new URL("/covermanager.css", Astro.site).href;

// La carta entra en la página como datos, y la pinta brasa.js según la manera elegida.
const carta = (await getCollection("menu-es")).map(({ id, data }) => ({
  id,
  section: data.section,
  name: data.name,
  description: data.description ?? null,
  price: data.price,
  featured: data.featured ?? null,
}));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Los dos metas del esquema oscuro, por lo mismo que en Base.astro; el tono es el --ground. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* La Cormorant viene de Google Fonts, como en el boceto. Antes de producción se sirve desde
        la web, como la Bricolage: pedirla a Google le pasa la IP de cada visita. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,300;1,400&display=swap" />
    <Seo
      title="Cokima — Kitchen Madness · Restaurante en Madrid"
      description="Una explosión de sabor en Andrés Mellado 21, Madrid. Cocina para compartir: de la receta madrileña de siempre a la más exótica. Reserva tu mesa."
      locale="es"
      restaurant={RESTAURANT}
      ogImage="/images/hero.jpg"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    {/* El vídeo va antes que el fondo y fuera de <main>: así las chispas se pintan ENCIMA del vídeo
        y el texto encima de los dos. El póster manda mientras no hay cinta —con «reducir
        movimiento», con ahorro de datos o si el iPhone no deja reproducir—. Sin `autoplay`: la
        arranca brasa.js, que es quien sabe qué ha pedido quien mira (regla 20 de movimiento.md). */}
    <div class="cine" aria-hidden="true">
      <Image src={poster} alt="" widths={[480, 780, 1200, 1600]} sizes="100vw" quality={74} loading="eager" fetchpriority="high" />
      {(mp4 || webm) && (
        <video
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
          disablepictureinpicture
          disableremoteplayback
          data-ancho-webm={webmAncho}
          data-ancho-mp4={mp4Ancho}
        >
          {webm && <source src={webm} type="video/webm" />}
          {mp4 && <source src={mp4} type="video/mp4" />}
        </video>
      )}
    </div>
    <canvas class="fondo" aria-hidden="true"></canvas>

    <header class="barra oculta">
      <a class="marca" href="#inicio" data-ir="inicio">Cokima</a>
      <nav class="secciones" aria-label="Secciones">
        <a href="#inicio" data-ir="inicio">Inicio</a><a href="#carta" data-ir="carta">La carta</a><a href="#nosotros" data-ir="nosotros">Nosotros</a><a href="#visitanos" data-ir="visitanos">Visítanos</a>
      </nav>
      <button type="button" class="desp" aria-expanded="false" aria-controls="desplegable-secciones"><span data-actual>Inicio</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.2 6 8l4-3.8" /></svg></button>
      <a class="pill solid peq" href="#reservar" data-ir="reservar">Reservar</a>
    </header>

    <div class="velo" aria-hidden="true"></div>
    <nav class="desplegable" id="desplegable-secciones" aria-label="Secciones">
      <a href="#inicio" data-ir="inicio">Inicio</a><a href="#carta" data-ir="carta">La carta</a><a href="#nosotros" data-ir="nosotros">Nosotros</a><a href="#visitanos" data-ir="visitanos">Visítanos</a>
      <div class="desp-pie"><Contacto /></div>
    </nav>

    <main>
      <!-- ===== Inicio ===== -->
      <section class="vista" data-vista="inicio">
        <div class="portada">
          <h1><span class="nombre">Cokima</span><span class="sub">Kitchen Madness</span></h1>
          <div class="acc"><a class="pill" href="#carta" data-ir="carta">Ver carta</a><a class="pill solid" href="#reservar" data-ir="reservar">Reservar</a></div>
        </div>
        <!-- Por debajo de la portada, el Inicio son cinco paneles a todo lo ancho: cada uno cuenta una
             cosa de Cokima y adelanta una sección. Mario los eligió entre tres maneras el 2026-11-02
             (docs/cokima-el-rediseno.md §3, «La dirección de Brasa»). Los textos son de la web del
             Grupo Tombo y de @cokimamadrid; los coloca y los abre brasa.js. -->
        <div class="pan-zona">
          <div class="paneles rv" data-paneles>
            <div class="pan" data-panel>
              <img class="pan-foto" src="/images/hero.jpg" alt="" width="1200" height="1200" loading="lazy">
              <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Kitchen Madness · Argüelles</small>Cokima</span></button>
              <div class="pan-cont">
                <p class="etq">Kitchen Madness · Argüelles</p>
                <h2 class="pan-tit">Puedes comer en cualquier sitio, pero será solo comer.</h2>
                <p class="voz">Cokima es una explosión de sabor, un concepto creado para compartir y desfasar, mandanga de la buena.</p>
                <p class="estado" data-estado></p>
                <p class="pan-acc"><a class="pill" href="#carta" data-ir="carta">Ver la carta</a><a class="pill solid" href="#reservar" data-ir="reservar">Reservar mesa</a></p>
              </div>
            </div>
            <div class="pan" data-panel>
              <img class="pan-foto" src="/images/producto-atun.jpg" alt="" width="1100" height="1100" loading="lazy">
              <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Buen producto. Malas intenciones.</small>El producto</span></button>
              <div class="pan-cont">
                <p class="etq">Buen producto. Malas intenciones.</p>
                <p class="voz">Elaboramos nuestros platos con los mejores productos frescos;</p>
                <ul class="pan-trio">
                  <li><img src="/images/producto-atun.jpg" alt="Un lomo de atún rojo en unas manos con guantes negros" width="1100" height="1100" loading="lazy"><p>pescado que casi aletea,</p></li>
                  <li><img src="/images/producto-picana.jpg" alt="Una picaña madurada abierta por la mitad" width="1100" height="1100" loading="lazy"><p>carne de animales que viven mejor que tú</p></li>
                  <li><img src="/images/producto-tomates.jpg" alt="Tres tomates apilados en unas manos con guantes negros" width="1100" height="1467" loading="lazy"><p>y verduras que saben a lo que tienen que saber.</p></li>
                </ul>
                <p class="pan-acc"><a class="pill" href="#carta" data-ir="carta">Ver la carta</a></p>
              </div>
            </div>
            <div class="pan" data-panel>
              <img class="pan-foto" src="/images/katsu.jpg" alt="" width="880" height="1100" loading="lazy">
              <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>La carta</small>Imprescindibles</span></button>
              <div class="pan-cont">
                <p class="etq">La carta · Imprescindibles</p>
                <p class="voz">Cocina ecléctica con toques que van desde las recetas más castizas, de las que a los de <i>Madriz</i> les llena de orgullo, hasta los guiños más exóticos para los modernos gastronómicos.</p>
                <ul class="pan-platos" data-destacados></ul>
                <p class="pan-acc"><a class="pill" href="#carta" data-ir="carta">Ver la carta entera</a></p>
              </div>
            </div>
            <div class="pan" data-panel>
              <img class="pan-foto" src="/images/sala-entera.jpg" alt="" width="1400" height="931" loading="lazy">
              <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Nosotros</small>La sala</span></button>
              <div class="pan-cont">
                <p class="etq">Nosotros</p>
                <h2 class="pan-tit">Nacimos en Argüelles con una misión.</h2>
                <p class="voz">Romper las reglas, jugar con los sabores… y demostrar que la cocina, también puede ser una bomba.</p>
                <p class="pan-acc"><a class="pill" href="#nosotros" data-ir="nosotros">Conócenos</a></p>
              </div>
            </div>
            <div class="pan" data-panel>
              <img class="pan-foto" src="/images/puerta.jpg" alt="" width="1400" height="1400" loading="lazy">
              <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Visítanos</small>Ven</span></button>
              <div class="pan-cont">
                <p class="etq">Visítanos</p>
                <h2 class="pan-tit">Ven a conocernos y le dirás <i>ciao</i> a las croquetas de tu abuela.</h2>
                <p class="pan-dato">Calle de Andrés Mellado, 21 · Argüelles, Madrid</p>
                <p class="estado" data-estado></p>
                <p class="pan-acc"><a class="pill solid" href="#reservar" data-ir="reservar">Reservar mesa</a><a class="pill" href="#visitanos" data-ir="visitanos">Cómo llegar y horario</a></p>
              </div>
            </div>
          </div>
        </div>
        <div class="wrap">
          <footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><a href="tel:+34915989401">+34 915 98 94 01</a><a href="https://instagram.com/cokimamadrid" rel="me noopener" target="_blank">@cokimamadrid</a><span>Lunes a domingo, 9:00–00:00</span></footer>
        </div>
      </section>

      <!-- ===== La carta ===== -->
      <section class="vista" data-vista="carta" hidden>
        <div class="wrap cab-vista">
          <p class="etq">La carta</p>
          <h2 class="tit">Para compartir y desfasar.</h2>
        </div>
        <nav class="chips" aria-label="Partes de la carta"><div class="wrap"><a href="#p-compartir" data-a="compartir">Compartir es vivir</a><a href="#p-terminar" data-a="terminar">Para terminar o no…</a><a href="#p-postres" data-a="postres">Los postres</a></div></nav>
        <div id="carta-cuerpo"></div>
        <div class="wrap"><footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><a href="tel:+34915989401">+34 915 98 94 01</a><a href="https://instagram.com/cokimamadrid" rel="me noopener" target="_blank">@cokimamadrid</a></footer></div>
      </section>

      <!-- ===== Nosotros ===== -->
      <section class="vista" data-vista="nosotros" hidden>
        <div class="wrap cab-vista">
          <p class="etq">Nosotros</p>
          <h2 class="tit">Nacimos en Argüelles con una misión.</h2>
          <p class="voz">Romper las reglas, jugar con los sabores… y demostrar que la cocina, también puede ser una bomba.</p>
        </div>
        <div class="wrap">
          <article class="relato rv"><figure><img src="/images/bomba.jpg" alt="El mural de la bomba sobre las mesas" width="1400" height="1400" style="aspect-ratio:1"></figure>
            <div class="txt"><p class="etq">La cocina</p><p class="tit">Aquí no cocinamos para que se vea bonito…</p><p class="voz">Cocinamos para que deje huella.</p></div></article>
          <article class="relato der rv"><figure><img src="/images/martin.jpg" alt="Martín, del equipo de cocina" width="825" height="1100"></figure>
            <div class="txt"><p class="etq">Martín, en la cocina</p><p class="tit">Trabajo serio. Cocina canalla.</p><p class="voz">Más cuchillo. Más producto.</p></div></article>
          <article class="relato rv"><figure><img src="/images/neon.jpg" alt="El neón «Orgasm, at the first bite» sobre la pared de fotos" width="1400" height="1283" style="aspect-ratio:1"></figure>
            <div class="txt"><p class="etq">La sala</p><p class="tit">Perseguimos una sensación muy concreta.</p><p class="voz">Ese <i>Orgasm at firstbite</i> del que habla nuestra pared.</p></div></article>
          <article class="relato der rv"><figure><img src="/images/sala.jpg" alt="Dos personas ríen en una mesa de la sala" width="880" height="1100"></figure>
            <div class="txt"><p class="etq">Quien te lo sirve</p><p class="tit">El plato es importante, pero quien te lo sirve también.</p><p class="voz">En Cokima no solo servimos comida… Servimos momentos. Sonrisas. Y el deseo de volver.</p></div></article>
          <article class="relato rv"><figure><img src="/images/manos.jpg" alt="Un cliente muerde un bocado con las manos" width="880" height="1100"></figure>
            <div class="txt"><p class="etq">Compartir es vivir</p><p class="tit">Hay platos que no necesitan cubiertos.</p><p class="voz">Solo ganas. Buen rollo. Y alguien con quien compartir.</p></div></article>
          <article class="relato der rv"><figure><div class="par"><img src="/images/tarta.jpg" alt="Una mujer se come la tarta de queso" width="1100" height="1100"><img src="/images/vacio.jpg" alt="El plato vacío" width="1100" height="1100"></div></figure>
            <div class="txt" style="margin-top:28px"><p class="etq">Lo que dicen</p><p class="tit">La mejor crítica nunca ha necesitado palabras.</p><p class="voz">Solo un plato vacío.</p><p class="hueco">Hueco: reseñas reales de clientes. Falta el material.</p></div></article>
          <footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><a href="tel:+34915989401">+34 915 98 94 01</a><a href="https://instagram.com/cokimamadrid" rel="me noopener" target="_blank">@cokimamadrid</a></footer>
        </div>
      </section>

      <!-- ===== Visítanos ===== -->
      <section class="vista" data-vista="visitanos" hidden>
        <div class="wrap cab-vista">
          <p class="etq">Visítanos</p>
          <h2 class="tit">Si alguna vez has cruzado esta puerta, ya sabes por qué siempre apetece volver.</h2>
          <p class="voz">Y si todavía no lo has hecho, te estamos esperando.</p>
        </div>
        <div class="wrap visita">
          <img src="/images/puerta.jpg" alt="El rótulo de Cokima en la entrada" width="1400" height="1400">
          <div class="visita-datos">
            <Contacto />
            <dl class="datos">
              <div><dt>Dónde</dt><dd>Calle de Andrés Mellado, 21</dd><dd>28015 Madrid · Argüelles</dd>
                <dd><a class="enlace" href="https://www.google.com/maps/search/?api=1&amp;query=Calle%20de%20Andr%C3%A9s%20Mellado%2021%2C%2028015%20Madrid" target="_blank" rel="noopener">Cómo llegar ↗</a></dd></div>
              <div><dt>Cuándo</dt><dd>Lunes a domingo, 9:00–00:00</dd><dd>Cocina 13:00–16:00 y 19:30–23:30</dd><dd class="estado" data-estado></dd></div>
              <div><dt>Reservas</dt><dd><a class="pill solid" href="#reservar" data-ir="reservar" style="margin-top:4px">Reservar mesa</a></dd></div>
            </dl>
          </div>
        </div>
        <div class="wrap"><footer class="pie"><a href="/aviso-legal">Aviso legal</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a></footer></div>
      </section>

      <!-- ===== Reservar ===== -->
      <!-- El motor de CoverManager dentro de la web, como en Ochoa (Mario, 2026-11-02), con la piel de
           Brasa. Va en un <template>: brasa.js lo monta la primera vez que se abre esta sección, y así
           el Inicio no llama a covermanager.com (docs/cokima-el-rediseno.md §3). No está en el menú de
           secciones: se llega por los «Reservar». -->
      <section class="vista" data-vista="reservar" data-nombre="Reservar" hidden>
        <div class="wrap cab-vista reserva">
          <div>
            <p class="etq">Reservas</p>
            <h2 class="tit">Reserva tu mesa</h2>
            <p class="reserva-txt">Lunes a domingo, 9:00–00:00. Si no encuentras hueco, llámanos al <a href="tel:+34915989401">+34 915 98 94 01</a>.</p>
          </div>
          <template data-motor><BookingEmbed slug={COVER_SLUG} locale="es" title="Reservas Cokima" template={coverTemplate} /></template>
        </div>
        <div class="wrap"><footer class="pie"><a href="/aviso-legal">Aviso legal</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a></footer></div>
      </section>
    </main>

    <script type="application/json" id="carta-datos" set:html={JSON.stringify(carta)} />
    <script>
      import "../brasa.js";
    </script>
  </body>
</html>
