---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import { showPhotoGuides } from "@tombo/config/photo-guides";
import PhotoGuide from "@tombo/ui/PhotoGuide.astro";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";

const featured = pickFeatured((await getCollection("menu-es")).map((e) => e.data));

// La casa: la sección que hoy no existe porque no hay fotos del local, solo del
// plato. Se dibuja en hueco para poder decidir qué se encarga; cuando lleguen
// las imágenes, esta sección deja de ser andamio y se publica con ellas.
const guides = showPhotoGuides();
const casa = [
  { file: "apps/cokima/src/assets/casa/pase.jpg", ratio: "16 / 9", note: "El pase de cocina en servicio, con la llama. Horizontal y ancha." },
  { file: "apps/cokima/src/assets/casa/sala.jpg", ratio: "1 / 1", note: "La sala de noche, luz baja y mesas llenas." },
  { file: "apps/cokima/src/assets/casa/producto.jpg", ratio: "1 / 1", note: "Producto en crudo sobre fondo negro, luz dura." },
  { file: "apps/cokima/src/assets/casa/equipo.jpg", ratio: "3 / 4", note: "El equipo en la cocina. Vertical, caras de verdad." },
];
---

<Base
  title="Cokima — Kitchen Madness · Restaurante en Madrid"
  description="Una explosión de sabor en Andrés Mellado 21, Madrid. Cocina para compartir: de la receta madrileña de siempre a la más exótica. Reserva tu mesa."
  locale="es"
  altPath="/en/"
>
  <Hero locale="es" />

  <Highlights dishes={featured} locale="es" href="/carta" />

  <section class="manifesto">
    <div class="wrap">
      <p class="quote">«Nos gusta mezclar, probar, mancharnos.»</p>
    </div>
  </section>

  {guides && (
    <section class="casa">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">La casa · huecos de foto</p>
          <h2>Lo que falta por retratar</h2>
        </div>
        <p class="casa-txt">
          Estos cuatro huecos no se publican: están para decidir qué se encarga al fotógrafo y con
          qué encuadre. Dejando el archivo con el nombre que pone cada uno, el hueco se convierte
          en la foto.
        </p>
        <div class="wall">
          {casa.map((c) => (
            <PhotoGuide file={c.file} ratio={c.ratio} note={c.note} minHeight="150px" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="visita" id="visita">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Dónde estamos</p>
        <h2>Chamberí, Madrid</h2>
      </div>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Dirección</dt><dd>C. de Andrés Mellado, 21<small>28015 Madrid</small></dd></div>
          <div class="block"><dt>Teléfono</dt><dd><a href="tel:+34915989401">915 98 94 01</a></dd></div>
          <div class="block"><dt>Horario</dt><dd>Lunes a domingo · 9:00 – 00:00<small>Cocina 13:00–16:00 y 19:30–23:30</small></dd></div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/cokimamadrid">@cokimamadrid</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Mapa orientativo: Andrés Mellado 21, Madrid">
          <div class="pin"><i class="dot"></i><span>Andrés Mellado 21</span></div>
          <span class="ph">Mapa · pendiente de integrar</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(44px, 7vw, 88px) 0;
  }
  .quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.55rem, 3.6vw, 2.6rem);
    line-height: 1.3;
    max-width: 24ch;
    margin: 0;
    text-wrap: balance;
  }
  /* Mosaico asimétrico y no una rejilla de cuatro iguales: la distribución es
     justo lo que hay que decidir aquí, y cuatro rectángulos idénticos no
     ayudan a imaginar nada. `:global` porque los hijos son componentes con su
     propio ámbito de estilos y esta hoja no los alcanza sin él. */
  .casa {
    padding: clamp(52px, 8vw, 96px) 0 0;
  }
  .casa-txt {
    color: var(--bone-dim);
    max-width: 56ch;
    margin: 1rem 0 0;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 1.6rem;
  }
  .wall > :global(*:first-child) {
    grid-column: span 2;
  }
  @media (min-width: 861px) {
    .wall {
      grid-template-columns: repeat(3, 1fr);
    }
    .wall > :global(*:nth-child(1)) {
      grid-column: 1 / span 2;
      grid-row: 1;
    }
    .wall > :global(*:nth-child(2)) {
      grid-column: 1;
      grid-row: 2;
    }
    .wall > :global(*:nth-child(3)) {
      grid-column: 2;
      grid-row: 2;
    }
    .wall > :global(*:nth-child(4)) {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  .visita {
    padding: clamp(52px, 8vw, 96px) 0 0;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: stretch;
    margin-top: 2rem;
  }
  @media (max-width: 820px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
  .info {
    margin: 0;
  }
  .block {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .block dt {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ember);
    margin: 0 0 0.45rem;
  }
  .block dd {
    margin: 0;
    font-size: 1.1rem;
  }
  .block dd small {
    display: block;
    color: var(--bone-dim);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .mapbox {
    position: relative;
    border: 1px solid var(--ground-3);
    border-radius: 8px;
    overflow: hidden;
    min-height: 280px;
    background:
      radial-gradient(circle at 62% 42%, rgba(237, 28, 36, 0.16), transparent 45%),
      repeating-linear-gradient(0deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(90deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px),
      var(--ground-2);
  }
  .pin {
    position: absolute;
    left: 62%;
    top: 42%;
    transform: translate(-50%, -100%);
    text-align: center;
  }
  .dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--vermilion);
    margin: 0 auto;
    box-shadow: 0 0 0 6px rgba(237, 28, 36, 0.22), 0 0 16px 3px var(--ember);
  }
  .pin span {
    font-size: 0.82rem;
    background: rgba(21, 15, 12, 0.7);
    padding: 4px 10px;
    border-radius: 3px;
    margin-top: 8px;
    display: inline-block;
  }
  .ph {
    position: absolute;
    left: 16px;
    bottom: 12px;
    font-size: 0.82rem;
    color: var(--bone-faint);
  }
</style>
