---
// La home de Cokima es Brasa desde el 2026-10-31: el boceto que eligió Mario, en una sola página
// con cuatro secciones (docs/cokima-el-rediseno.md §3). No usa Base.astro: aquel es el marco de la
// web anterior —su cabecera, su pie, su cartel de cookies y el router de transiciones—, y Brasa
// trae su propia barra y cambia de sección sin recargar. Las legales siguen con Base.
import "../styles/tokens.css";
import "../styles/brasa.css";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Seo from "@tombo/ui/Seo.astro";
import { RESTAURANT } from "../site.ts";
import poster from "../assets/entrada-poster.jpg";

// El vídeo de la entrada, detrás de la portada (Mario, 2026-10-31: «a modo provisional»). Se busca
// con import.meta.glob por lo mismo que en Entrada.astro, que explica la trampa: la existencia la
// resuelve el bundler, no el sistema de ficheros. Dos cortes: el vertical y, en el ordenador, el
// ancho, que elige brasa.js al arrancar.
const cintas = import.meta.glob<string>("../assets/video/entrada{,-ancho}.{mp4,webm}", {
  eager: true,
  query: "?url",
  import: "default",
});
const url = (nombre: string, ext: string) =>
  Object.entries(cintas).find(([ruta]) => ruta.endsWith(`/${nombre}.${ext}`))?.[1];
const mp4 = url("entrada", "mp4");
const webm = url("entrada", "webm");
const mp4Ancho = url("entrada-ancho", "mp4");
const webmAncho = url("entrada-ancho", "webm");

// La carta entra en la página como datos, y la pinta brasa.js según la manera elegida.
const carta = (await getCollection("menu-es")).map(({ id, data }) => ({
  id,
  section: data.section,
  name: data.name,
  description: data.description ?? null,
  price: data.price,
  featured: data.featured ?? null,
}));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Los dos metas del esquema oscuro, por lo mismo que en Base.astro; el tono es el --ground. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* La Cormorant viene de Google Fonts, como en el boceto. Antes de producción se sirve desde
        la web, como la Bricolage: pedirla a Google le pasa la IP de cada visita. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,300;1,400&display=swap" />
    <Seo
      title="Cokima — Kitchen Madness · Restaurante en Madrid"
      description="Una explosión de sabor en Andrés Mellado 21, Madrid. Cocina para compartir: de la receta madrileña de siempre a la más exótica. Reserva tu mesa."
      locale="es"
      restaurant={RESTAURANT}
      ogImage="/images/hero.jpg"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    {/* El vídeo va antes que el fondo y fuera de <main>: así el fuego se pinta ENCIMA del vídeo
        y el texto encima de los dos. El póster manda mientras no hay cinta —con «reducir
        movimiento», con ahorro de datos o si el iPhone no deja reproducir—. Sin `autoplay`: la
        arranca brasa.js, que es quien sabe qué ha pedido quien mira (regla 20 de movimiento.md). */}
    <div class="cine" aria-hidden="true">
      <Image src={poster} alt="" widths={[480, 780, 1200, 1600]} sizes="100vw" quality={74} loading="eager" fetchpriority="high" />
      {(mp4 || webm) && (
        <video
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
          disablepictureinpicture
          disableremoteplayback
          data-ancho-webm={webmAncho}
          data-ancho-mp4={mp4Ancho}
        >
          {webm && <source src={webm} type="video/webm" />}
          {mp4 && <source src={mp4} type="video/mp4" />}
        </video>
      )}
    </div>
    <canvas class="fondo" aria-hidden="true"></canvas>

    <header class="barra oculta">
      <a class="marca" href="#inicio" data-ir="inicio">Cokima</a>
      <nav class="secciones" aria-label="Secciones">
        <a href="#inicio" data-ir="inicio">Inicio</a><a href="#carta" data-ir="carta">La carta</a><a href="#nosotros" data-ir="nosotros">Nosotros</a><a href="#visitanos" data-ir="visitanos">Visítanos</a>
      </nav>
      <a class="pill solid peq" href="https://www.covermanager.com/reservation/module_restaurant/restaurante-cokima/spanish" target="_blank" rel="noopener">Reservar</a>
    </header>

    <nav class="pestanas oculta" aria-label="Secciones">
      <a href="#inicio" data-ir="inicio">Inicio</a><a href="#carta" data-ir="carta">La carta</a><a href="#nosotros" data-ir="nosotros">Nosotros</a><a href="#visitanos" data-ir="visitanos">Visítanos</a>
    </nav>

    <main>
      <!-- ===== Inicio ===== -->
      <section class="vista" data-vista="inicio">
        <div class="portada">
          <h1><span class="nombre">Cokima</span><span class="sub">Kitchen Madness</span></h1>
          <div class="acc"><a class="pill" href="#carta" data-ir="carta">Ver carta</a><a class="pill solid" href="https://www.covermanager.com/reservation/module_restaurant/restaurante-cokima/spanish" target="_blank" rel="noopener">Reservar</a></div>
        </div>
        <div class="wrap sigue">
          <p class="etq rv">Kitchen Madness · Argüelles</p>
          <p class="lema rv" style="margin-top:14px">Buen producto. Malas intenciones.</p>
          <p class="estado rv" data-estado></p>
          <div class="puertas">
            <a class="puerta rv" href="#carta" data-ir="carta"><img src="/images/katsu.jpg" alt="" width="880" height="1100"><span class="txt"><span class="etq">La carta</span><span class="t">Para compartir y desfasar.</span></span></a>
            <a class="puerta rv" href="#nosotros" data-ir="nosotros"><img src="/images/martin.jpg" alt="" width="825" height="1100" style="object-position:50% 20%"><span class="txt"><span class="etq">Nosotros</span><span class="t">Trabajo serio. Cocina canalla.</span></span></a>
            <a class="puerta rv" href="#visitanos" data-ir="visitanos"><img src="/images/puerta.jpg" alt="" width="1400" height="1400"><span class="txt"><span class="etq">Visítanos</span><span class="t">Andrés Mellado, 21.</span></span></a>
          </div>
          <footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><span>+34 915 98 94 01</span><span>Lunes a domingo, 9:00–00:00</span></footer>
        </div>
      </section>

      <!-- ===== La carta ===== -->
      <section class="vista" data-vista="carta" hidden>
        <div class="wrap cab-vista">
          <p class="etq">La carta</p>
          <h2 class="tit">Para compartir y desfasar.</h2>
          <div class="boceto" role="group" aria-label="Boceto: cómo enseñar los platos con foto">
            <span class="q">Boceto · los platos con foto</span>
            <div class="ops"><button type="button" data-modo="1" aria-pressed="true">1 · Portadilla</button><button type="button" data-modo="2" aria-pressed="false">2 · Al tocar</button><button type="button" data-modo="3" aria-pressed="false">3 · Pareja</button></div>
            <p class="nota" data-nota></p>
          </div>
        </div>
        <nav class="chips" aria-label="Partes de la carta"><div class="wrap"><a href="#p-compartir" data-a="compartir">Compartir es vivir</a><a href="#p-terminar" data-a="terminar">Para terminar o no…</a><a href="#p-postres" data-a="postres">Los postres</a></div></nav>
        <div id="carta-cuerpo"></div>
        <div class="wrap"><footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><span>+34 915 98 94 01</span></footer></div>
      </section>

      <!-- ===== Nosotros ===== -->
      <section class="vista" data-vista="nosotros" hidden>
        <div class="wrap cab-vista">
          <p class="etq">Nosotros</p>
          <h2 class="tit">Nacimos en Argüelles con una misión.</h2>
          <p class="voz">Romper las reglas, jugar con los sabores… y demostrar que la cocina, también puede ser una bomba.</p>
        </div>
        <div class="wrap">
          <article class="relato rv"><figure><img src="/images/bomba.jpg" alt="El mural de la bomba sobre las mesas" width="1400" height="1400" style="aspect-ratio:1"></figure>
            <div class="txt"><p class="etq">La cocina</p><p class="tit">Aquí no cocinamos para que se vea bonito…</p><p class="voz">Cocinamos para que deje huella.</p></div></article>
          <article class="relato der rv"><figure><img src="/images/martin.jpg" alt="Martín, del equipo de cocina" width="825" height="1100"></figure>
            <div class="txt"><p class="etq">Martín, en la cocina</p><p class="tit">Trabajo serio. Cocina canalla.</p><p class="voz">Más cuchillo. Más producto.</p></div></article>
          <article class="relato rv"><figure><img src="/images/neon.jpg" alt="El neón «Orgasm, at the first bite» sobre la pared de fotos" width="1400" height="1283" style="aspect-ratio:1"></figure>
            <div class="txt"><p class="etq">La sala</p><p class="tit">Perseguimos una sensación muy concreta.</p><p class="voz">Ese <i>Orgasm at firstbite</i> del que habla nuestra pared.</p></div></article>
          <article class="relato der rv"><figure><img src="/images/sala.jpg" alt="Dos personas ríen en una mesa de la sala" width="880" height="1100"></figure>
            <div class="txt"><p class="etq">Quien te lo sirve</p><p class="tit">El plato es importante, pero quien te lo sirve también.</p><p class="voz">En Cokima no solo servimos comida… Servimos momentos. Sonrisas. Y el deseo de volver.</p></div></article>
          <article class="relato rv"><figure><img src="/images/manos.jpg" alt="Un cliente muerde un bocado con las manos" width="880" height="1100"></figure>
            <div class="txt"><p class="etq">Compartir es vivir</p><p class="tit">Hay platos que no necesitan cubiertos.</p><p class="voz">Solo ganas. Buen rollo. Y alguien con quien compartir.</p></div></article>
          <article class="relato der rv"><figure><div class="par"><img src="/images/tarta.jpg" alt="Una mujer se come la tarta de queso" width="1100" height="1100"><img src="/images/vacio.jpg" alt="El plato vacío" width="1100" height="1100"></div></figure>
            <div class="txt" style="margin-top:28px"><p class="etq">Lo que dicen</p><p class="tit">La mejor crítica nunca ha necesitado palabras.</p><p class="voz">Solo un plato vacío.</p><p class="hueco">Hueco: reseñas reales de clientes. Falta el material.</p></div></article>
          <footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><span>+34 915 98 94 01</span></footer>
        </div>
      </section>

      <!-- ===== Visítanos ===== -->
      <section class="vista" data-vista="visitanos" hidden>
        <div class="wrap cab-vista">
          <p class="etq">Visítanos</p>
          <h2 class="tit">Si alguna vez has cruzado esta puerta, ya sabes por qué siempre apetece volver.</h2>
          <p class="voz">Y si todavía no lo has hecho, te estamos esperando.</p>
        </div>
        <div class="wrap visita">
          <img src="/images/puerta.jpg" alt="El rótulo de Cokima en la entrada" width="1400" height="1400">
          <dl class="datos">
            <div><dt>Dónde</dt><dd>Calle de Andrés Mellado, 21</dd><dd>28015 Madrid · Argüelles</dd>
              <dd><a class="enlace" href="https://www.google.com/maps/search/?api=1&amp;query=Calle%20de%20Andr%C3%A9s%20Mellado%2021%2C%2028015%20Madrid" target="_blank" rel="noopener">Cómo llegar ↗</a></dd></div>
            <div><dt>Cuándo</dt><dd>Lunes a domingo, 9:00–00:00</dd><dd>Cocina 13:00–16:00 y 19:30–23:30</dd><dd class="estado" data-estado></dd></div>
            <div><dt>Teléfono</dt><dd>+34 915 98 94 01</dd></div>
            <div><dt>Reservas</dt><dd><a class="pill solid" href="https://www.covermanager.com/reservation/module_restaurant/restaurante-cokima/spanish" target="_blank" rel="noopener" style="margin-top:4px">Reservar mesa</a></dd></div>
          </dl>
        </div>
        <div class="wrap"><footer class="pie"><a href="/aviso-legal">Aviso legal</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a></footer></div>
      </section>
    </main>

    <script type="application/json" id="carta-datos" set:html={JSON.stringify(carta)} />
    <script>
      import "../brasa.js";
    </script>
  </body>
</html>
