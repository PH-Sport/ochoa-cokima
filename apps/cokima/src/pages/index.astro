---
// El Inicio de Brasa. Cada sección de la web es su propia página desde el 2026-11-04: el marco —la barra,
// las chispas, el vídeo— está en layouts/Brasa.astro, y cada página trae solo lo suyo
// (docs/cokima-el-rediseno.md §3, «Una dirección para cada sección»).
import Brasa from "../layouts/Brasa.astro";
import { platosDeLaCarta, precio } from "../carta.ts";

const destacados = (await platosDeLaCarta()).filter((d) => d.featured);
---

<Brasa
  vista="inicio"
  title="Cokima — Kitchen Madness · Restaurante en Madrid"
  description="Una explosión de sabor en Andrés Mellado 21, Madrid. Cocina para compartir: de la receta madrileña de siempre a la más exótica. Reserva tu mesa."
>
  <section class="vista" data-vista="inicio">
    <div class="portada">
      <h1><span class="nombre" data-texto="Cokima">Cokima</span><span class="sub">Kitchen Madness</span></h1>
      <div class="acc"><a class="pill" href="/carta" data-ir="carta">Ver carta</a><a class="pill solid" href="/reservas" data-ir="reservar">Reservar</a></div>
    </div>
    <!-- Por debajo de la portada, el Inicio son cuatro paneles a todo lo ancho: cada uno cuenta una
         cosa de Cokima y adelanta una sección. Mario los eligió entre tres maneras el 2026-11-02, y
         el mismo día los reordenó: primero los platos, como «Lo que más sale» en Ochoa; luego el
         producto y la sala; y al final Cokima y Ven en uno, con un texto para buscadores
         (docs/cokima-el-rediseno.md §3). Los textos son de la web del Grupo Tombo y de
         @cokimamadrid; los coloca y los abre brasa.js. -->
    <div class="pan-zona">
      <div class="paneles rv" data-paneles>
        <div class="pan" data-panel>
          <img class="pan-foto" src="/images/imprescindibles-arroz.jpg" alt="" width="1100" height="1375" loading="lazy">
          <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>La carta</small>Imprescindibles</span></button>
          <div class="pan-cont">
            <p class="etq">La carta · Imprescindibles</p>
            <p class="voz pan-largo">Cocina ecléctica con toques que van desde las recetas más castizas, de las que a los de <i>Madriz</i> les llena de orgullo, hasta los guiños más exóticos para los modernos gastronómicos.</p>
            <ul class="pan-platos" data-destacados>{destacados.map((d) => <li><span>{d.name}{d.description && <small>{d.description}</small>}</span><b>{precio(d.price)}</b></li>)}</ul>
            <p class="pan-acc"><a class="pill" href="/carta" data-ir="carta">Ver la carta entera</a></p>
          </div>
        </div>
        <div class="pan" data-panel>
          <img class="pan-foto" src="/images/producto-atun.jpg" alt="" width="1100" height="1100" loading="lazy">
          <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Buen producto. Malas intenciones.</small>El producto</span></button>
          <div class="pan-cont">
            <p class="etq">Buen producto. Malas intenciones.</p>
            <p class="voz">Elaboramos nuestros platos con los mejores productos frescos;</p>
            <ul class="pan-trio">
              <li><img src="/images/producto-atun-marcado.jpg" alt="Un lomo de atún marcado cortándose con el cuchillo" width="1100" height="1465" loading="lazy"><p>más cuchillo, más producto,</p></li>
              <li><img src="/images/producto-steak-tartar.jpg" alt="El steak tartar de picaña madurada sobre el tuétano" width="1100" height="1100" loading="lazy"><p>materia prima de primer nivel</p></li>
              <li><img src="/images/producto-tomates.jpg" alt="Tres tomates apilados en unas manos con guantes negros" width="1100" height="1467" loading="lazy"><p>y verduras que saben a lo que tienen que saber.</p></li>
            </ul>
            <p class="pan-acc"><a class="pill" href="/carta" data-ir="carta">Ver la carta</a></p>
          </div>
        </div>
        <div class="pan" data-panel>
          <img class="pan-foto" src="/images/sala-entera.jpg" alt="" width="1400" height="931" loading="lazy">
          <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Nosotros</small>La sala</span></button>
          <div class="pan-cont">
            <p class="etq">Nosotros</p>
            <h2 class="pan-tit">Nacimos en Argüelles con una misión.</h2>
            <p class="voz">Romper las reglas, jugar con los sabores… y demostrar que la cocina, también puede ser una bomba.</p>
            <p class="pan-acc"><a class="pill" href="/nosotros" data-ir="nosotros">Conócenos</a></p>
          </div>
        </div>
        <div class="pan" data-panel>
          <img class="pan-foto" src="/images/puerta.jpg" alt="" width="1400" height="1400" loading="lazy">
          <button type="button" class="pan-abrir" aria-expanded="false"><span class="pan-rotulo"><small>Andrés Mellado, 21</small>Visítanos</span></button>
          <div class="pan-cont">
            <p class="etq">Kitchen Madness · Argüelles</p>
            <h2 class="pan-tit">Puedes comer en cualquier sitio, pero será solo comer.</h2>
            <!-- El texto para buscadores que pidió Mario (2026-11-02): solo datos comprobados (site.ts y
                 Visítanos) y frases de la casa, a la espera de que lo revise. -->
            <p class="pan-seo pan-largo">Cokima es una explosión de sabor en Argüelles, Madrid: cocina ecléctica para compartir, de las recetas más castizas a los guiños más exóticos. Estamos en la calle de Andrés Mellado, 21, y abrimos de lunes a domingo, de 9:00 a 00:00.</p>
            <p class="voz">Ven a conocernos y le dirás <i>ciao</i> a las croquetas de tu abuela.</p>
            <p class="estado" data-estado></p>
            <p class="pan-acc"><a class="pill solid" href="/reservas" data-ir="reservar">Reservar mesa</a><a class="pill" href="/visitanos" data-ir="visitanos">Cómo llegar y horario</a></p>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap">
      <footer class="pie"><span>Calle de Andrés Mellado, 21 · 28015 Madrid</span><a href="tel:+34915989401">+34 915 98 94 01</a><a href="https://instagram.com/cokimamadrid" rel="me noopener" target="_blank">@cokimamadrid</a><span>Lunes a domingo, 9:00–00:00</span></footer>
    </div>
  </section>
</Brasa>
