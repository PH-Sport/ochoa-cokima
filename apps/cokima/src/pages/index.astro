---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Embers from "../components/Embers.astro";
import MenuSection from "@tombo/ui/MenuSection.astro";
import { ALLERGEN_LABELS } from "../site.ts";

const featured = (await getCollection("menu-es", (e) => e.data.featured)).map((e) => e.data);
---

<Base
  title="Cokima — Kitchen Madness · Restaurante en Madrid"
  description="Una explosión de sabor en Andrés Mellado 21, Madrid. Cocina para compartir: de la receta madrileña de siempre a la más exótica. Reserva tu mesa."
  locale="es"
  altPath="/en/"
>
  <header class="hero" id="top">
    <Embers />
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Kitchen Madness · Madrid</p>
        <h1>Puedes comer en cualquier sitio. <span class="red">Pero será solo comer.</span></h1>
        <p class="kicker">
          Una explosión de sabor. Un concepto creado para compartir y desfasar: de la receta madrileña
          de siempre a la cocina más exótica, con producto fresco y sin miedo a mezclar.
        </p>
        <div class="hero-cta">
          <a href="/reservas" class="btn">Reservar mesa</a>
          <a href="/carta" class="btn ghost">Ver la carta</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/images/hero.jpg" alt="Plato de Cokima sobre pizarra oscura" width="1200" height="1200" loading="eager" fetchpriority="high" />
        <span class="tag">Compartir es vivir</span>
      </div>
    </div>
  </header>

  <section class="manifesto">
    <div class="wrap">
      <p class="quote">«Nos gusta mezclar, probar, mancharnos.»</p>
      <p class="sub">Y, sobre todo, que tú disfrutes. Si algo te sorprende, vamos bien. Si repites, mejor aún.</p>
    </div>
  </section>

  <section class="picks">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Lo que no te puedes perder</p>
        <h2>Los imprescindibles</h2>
      </div>
      <MenuSection title="Selección" dishes={featured} allergenLabels={ALLERGEN_LABELS.es} />
      <p class="more"><a href="/carta" class="btn ghost">Carta completa</a></p>
    </div>
  </section>

  <section class="visita" id="visita">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Dónde estamos</p>
        <h2>Chamberí, Madrid</h2>
      </div>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Dirección</dt><dd>C. de Andrés Mellado, 21<small>28015 Madrid</small></dd></div>
          <div class="block"><dt>Teléfono</dt><dd><a href="tel:+34915989401">915 98 94 01</a></dd></div>
          <div class="block"><dt>Horario</dt><dd>Lunes a domingo · 9:00 – 00:00<small>Cocina 13:00–16:00 y 19:30–23:30</small></dd></div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/cokimamadrid">@cokimamadrid</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Mapa orientativo: Andrés Mellado 21, Madrid">
          <div class="pin"><i class="dot"></i><span>Andrés Mellado 21</span></div>
          <span class="ph">Mapa · pendiente de integrar</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 9vw, 112px) 0 clamp(40px, 7vw, 80px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero h1 {
    font-weight: 800;
    font-size: clamp(2.9rem, 8.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0.3em 0 0;
    text-wrap: balance;
  }
  .hero h1 .red {
    color: var(--vermilion);
  }
  .kicker {
    max-width: 46ch;
    color: var(--bone-dim);
    font-size: 1.1rem;
    margin: 1.5rem 0 0;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 2.1rem;
  }
  .hero-photo {
    position: relative;
    border: 1px solid var(--ground-3);
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
    aspect-ratio: 4 / 5;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, rgba(21, 15, 12, 0) 40%, rgba(21, 15, 12, 0.55) 100%);
  }
  .hero-photo .tag {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    background: rgba(21, 15, 12, 0.55);
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: 3px;
  }
  .manifesto {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(44px, 7vw, 88px) 0;
  }
  .quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.55rem, 3.6vw, 2.6rem);
    line-height: 1.3;
    max-width: 24ch;
    margin: 0;
    text-wrap: balance;
  }
  .sub {
    font-size: 1.06rem;
    color: var(--bone-dim);
    max-width: 52ch;
    margin: 1.6rem 0 0;
  }
  .picks,
  .visita {
    padding: clamp(52px, 8vw, 96px) 0 0;
  }
  .more {
    margin-top: 2.2rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: stretch;
    margin-top: 2rem;
  }
  @media (max-width: 820px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
  .info {
    margin: 0;
  }
  .block {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .block dt {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ember);
    margin: 0 0 0.45rem;
  }
  .block dd {
    margin: 0;
    font-size: 1.1rem;
  }
  .block dd small {
    display: block;
    color: var(--bone-dim);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .mapbox {
    position: relative;
    border: 1px solid var(--ground-3);
    border-radius: 8px;
    overflow: hidden;
    min-height: 280px;
    background:
      radial-gradient(circle at 62% 42%, rgba(237, 28, 36, 0.16), transparent 45%),
      repeating-linear-gradient(0deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(90deg, rgba(243, 234, 221, 0.05) 0 1px, transparent 1px 46px),
      var(--ground-2);
  }
  .pin {
    position: absolute;
    left: 62%;
    top: 42%;
    transform: translate(-50%, -100%);
    text-align: center;
  }
  .dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--vermilion);
    margin: 0 auto;
    box-shadow: 0 0 0 6px rgba(237, 28, 36, 0.22), 0 0 16px 3px var(--ember);
  }
  .pin span {
    font-size: 0.82rem;
    background: rgba(21, 15, 12, 0.7);
    padding: 4px 10px;
    border-radius: 3px;
    margin-top: 8px;
    display: inline-block;
  }
  .ph {
    position: absolute;
    left: 16px;
    bottom: 12px;
    font-size: 0.82rem;
    color: var(--bone-faint);
  }
</style>
