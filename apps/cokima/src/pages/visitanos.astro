---
import Brasa from "../layouts/Brasa.astro";
import Contacto from "../components/Contacto.astro";
// La mecha (mecha.js): el barrio que dibuja. Se pide desde el HTML, mientras se lee la página, para que no haga
// esperar. Con un script y no con un <link rel="preload">: WebKit lo descargaba dos veces (2026-11-04).
import urlMapa from "../data/mapa-barrio.json?url";

const mapsHref = "https://www.google.com/maps/search/?api=1&query=Calle%20de%20Andr%C3%A9s%20Mellado%2021%2C%2028015%20Madrid";
---

<Brasa
  vista="visitanos"
  title="Visítanos · Cokima, Andrés Mellado 21 (Argüelles, Madrid)"
  description="Calle de Andrés Mellado, 21, 28015 Madrid, en Argüelles. Abierto de lunes a domingo, de 9:00 a 00:00; cocina de 13:00 a 16:00 y de 19:30 a 23:30. Teléfono: 915 98 94 01."
>
  <section class="vista" data-vista="visitanos">
    <div class="mecha">
      {/* Y el nombre de Cokima se esconde antes del primer pintado, si va a arder, para que no asome y se vaya
          (regla 21 de movimiento.md). Las dos cosas, solo mientras se lee la página: al traer la sección desde
          otra, las hace mecha.js. Si mecha.js no llegara, a los 4 s vuelve solo: como la entrada del Inicio. */}
      <script is:inline define:vars={{ urlMapa }}>
        if (document.readyState === "loading") {
          window.mapaBarrio = fetch(urlMapa).then((r) => r.json()).catch(() => null);
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const c = document.querySelector(".mecha"); c.classList.add("arde");
            setTimeout(() => { if (!c.dataset.viva) c.classList.remove("arde"); }, 4000);
          }
        }
      </script>
      <canvas class="mapa" role="img" aria-label="Las calles de Argüelles, con los caminos desde los metros Argüelles, Moncloa, Islas Filipinas y Quevedo hasta Cokima, en Andrés Mellado, 21"></canvas>
      <div class="velo-mapa"></div>
      <div class="wrap cab-vista mecha-cab">
        <p class="etq">Visítanos</p>
        <h1 class="tit">Si alguna vez has cruzado esta puerta, ya sabes por qué siempre apetece volver.</h1>
      </div>
      <div class="destino">
        <i class="punto"></i>
        <div class="destino-txt">
          <b>Cokima</b><span>Andrés Mellado, 21</span>
          <a href={mapsHref} target="_blank" rel="noopener">Cómo llegar ↗</a>
        </div>
      </div>
      <small class="osm">© OpenStreetMap</small>
    </div>
    <div class="wrap visita-ficha">
      <p class="voz">Y si todavía no lo has hecho, te estamos esperando.</p>
      <div class="visita-datos">
        <Contacto />
        <dl class="datos">
          <div><dt>Dónde</dt><dd>Calle de Andrés Mellado, 21</dd><dd>28015 Madrid · Argüelles</dd>
            <dd><a class="enlace" href={mapsHref} target="_blank" rel="noopener">Cómo llegar ↗</a></dd></div>
          <div><dt>Cuándo</dt><dd>Lunes a domingo, 9:00–00:00</dd><dd>Cocina 13:00–16:00 y 19:30–23:30</dd><dd class="estado" data-estado></dd></div>
          <div><dt>Reservas</dt><dd><a class="pill solid" href="/reservas" data-ir="reservar" style="margin-top:4px">Reservar mesa</a></dd></div>
        </dl>
      </div>
    </div>
    <div class="wrap"><footer class="pie"><a href="/aviso-legal">Aviso legal</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a></footer></div>
  </section>
</Brasa>
