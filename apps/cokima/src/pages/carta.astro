---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MenuSection from "@tombo/ui/MenuSection.astro";
import { ALLERGEN_LABELS } from "../site.ts";

const all = (await getCollection("menu-es")).map((e) => e.data);
const bySection = (s: string) => all.filter((d) => d.section === s);
---

<Base
  title="La carta · Cokima — Kitchen Madness"
  description="La carta de Cokima en Madrid: gyozas de langostino, tataki de atún, arroz meloso de carabinero, katsu sando y más. Para compartir y desfasar."
  locale="es"
  altPath="/en/menu"
>
  <section class="carta">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">La carta</p>
        <h1>Para compartir y desfasar</h1>
      </div>

      <MenuSection title="Compartir es vivir" dishes={bySection("compartir")} allergenLabels={ALLERGEN_LABELS.es} />
      <MenuSection title="Para terminar o no…" dishes={bySection("terminar")} allergenLabels={ALLERGEN_LABELS.es} />
      <MenuSection title="Y por fin, los postres" dishes={bySection("postres")} allergenLabels={ALLERGEN_LABELS.es} />

      <p class="note">
        Mantequilla, AOVE, pan y aperitivo: 3 €. Los iconos de alérgenos son orientativos
        hasta confirmar la documentación oficial del restaurante.
      </p>
    </div>
  </section>
</Base>

<style>
  .carta {
    padding: clamp(52px, 8vw, 96px) 0 0;
  }
  .note {
    font-size: 0.9rem;
    color: var(--bone-faint);
    margin-top: 2.6rem;
    text-align: center;
  }
</style>
