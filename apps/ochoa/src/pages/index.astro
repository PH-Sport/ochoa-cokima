---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import { showPhotoGuides } from "@tombo/config/photo-guides";
import PhotoGuide from "@tombo/ui/PhotoGuide.astro";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";

const featured = pickFeatured((await getCollection("menu-es")).map((e) => e.data));

// La casa: la sección que hoy no existe porque no hay fotos del local, solo del
// plato. Se dibuja en hueco para poder decidir qué se encarga; cuando lleguen
// las imágenes, esta sección deja de ser andamio y se publica con ellas.
const guides = showPhotoGuides();
const casa = [
  { file: "apps/ochoa/src/assets/casa/barra.jpg", ratio: "16 / 9", note: "La barra en hora punta, con el mandil rojo. Horizontal y ancha." },
  { file: "apps/ochoa/src/assets/casa/rotulo.jpg", ratio: "1 / 1", note: "El rótulo desde la calle, de noche, con el rojo encendido." },
  { file: "apps/ochoa/src/assets/casa/vermu.jpg", ratio: "1 / 1", note: "Vermú de grifo servido, primer plano corto." },
  { file: "apps/ochoa/src/assets/casa/comedor.jpg", ratio: "3 / 4", note: "El comedor lleno a mediodía. Vertical, gente de verdad." },
];
---

<Base
  title="Tasquita Los Ochoa · La tasca que te mereces · Madrid"
  description="Bar madrileño de toda la vida con gastronomía renovada, en plena Castellana. Vermú, tapas con un toque diferente y aperitivos que se alargan hasta la noche."
  locale="es"
  altPath="/en/"
>
  <Hero locale="es" />

  <Highlights dishes={featured} locale="es" href="/carta" />

  <section class="manifesto">
    <div class="wrap">
      <div class="rule"></div>
      <blockquote>«Aperitivos de esos que se alargan hasta la noche, <strong>como filosofía de vida</strong>.»</blockquote>
      <p class="sub">
        Un espacio divertido en plena Castellana donde beberte un buen vermú y acompañarlo de tapas
        con un toque diferente. El tapeo de toda la vida, con sabores nuevos.
      </p>
    </div>
  </section>

  <section class="tasca">
    <div class="wrap"><div class="rule"></div></div>
    <div class="wrap tasca-grid">
      <div class="tasca-photo">
        <img src="/images/tasca.jpg" alt="Rótulo rojo de Los Ochoa en la ventana del local" width="900" height="900" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">La tasca</p>
        <h2 class="cartel">El bar de toda la vida, renovado</h2>
        <p class="txt">
          Barra, mármol y rótulo rojo. <em>El tapeo de toda la vida que te sorprenderá con sabores
          nuevos</em> y con la mejor calidad de producto — de la ensaladilla al cachopín, pasando
          por unas gyozas de txistorra.
        </p>
        <p><a href="/carta" class="btn ghost">Ver la carta completa</a></p>
      </div>
    </div>
  </section>

  {guides && (
    <section class="casa">
      <div class="wrap">
        <div class="rule"></div>
        <p class="eyebrow">La casa · huecos de foto</p>
        <h2 class="cartel">Lo que falta por retratar</h2>
        <p class="txt">
          Estos cuatro huecos no se publican: están para decidir qué se encarga al fotógrafo y con
          qué encuadre. Dejando el archivo con el nombre que pone cada uno, el hueco se convierte
          en la foto.
        </p>
        <div class="wall">
          {casa.map((c) => (
            <PhotoGuide file={c.file} ratio={c.ratio} note={c.note} minHeight="150px" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="visita" id="visita">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Dónde estamos</p>
      <h2 class="cartel">En plena Castellana</h2>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Dirección</dt><dd>P.º de la Castellana, 117<small>28046 Madrid</small></dd></div>
          <div class="block"><dt>Teléfono</dt><dd><a href="tel:+34912876820">912 87 68 20</a></dd></div>
          <div class="block">
            <dt>Horario</dt>
            <dd>
              <div class="hours">
                <span>Lunes a jueves</span><b>9:00 – 1:00</b>
                <span>Viernes</span><b>9:00 – 2:30</b>
                <span>Sábado</span><b>12:00 – 2:30</b>
                <span>Domingo</span><b>12:00 – 1:00</b>
              </div>
            </dd>
          </div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/tasquita.losochoa">@tasquita.losochoa</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Mapa orientativo: Paseo de la Castellana 117, Madrid">
          <div class="pin"><i class="dot"></i><span>Castellana 117</span></div>
          <span class="ph">Mapa · pendiente de integrar</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto {
    padding: clamp(44px, 7vw, 84px) 0;
  }
  .manifesto .rule {
    margin-bottom: clamp(30px, 5vw, 52px);
  }
  blockquote {
    margin: 0;
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.32;
    max-width: 26ch;
    text-wrap: balance;
  }
  blockquote strong {
    color: var(--rojo);
  }
  .sub {
    font-size: 1.08rem;
    color: var(--ink-dim);
    max-width: 56ch;
    margin: 1.5rem 0 0;
  }
  .tasca {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  /* Cada sección abre con el mismo filete doble que ya usaba el manifiesto: la
     hoja de bar se lee como un cartel pautado, no como bloques flotando. */
  .tasca .rule,
  .visita .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .tasca-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  @media (max-width: 860px) {
    .tasca-grid {
      grid-template-columns: 1fr;
    }
  }
  .tasca-photo {
    border: 2px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
    aspect-ratio: 1 / 1;
  }
  .tasca-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tasca h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 0;
  }
  .txt {
    color: var(--ink-dim);
    font-size: 1.08rem;
    max-width: 50ch;
    margin: 1.3rem 0 1.6rem;
  }
  .txt em {
    color: var(--ink);
  }
  /* Mosaico asimétrico y no una rejilla de cuatro iguales: la distribución es
     justo lo que hay que decidir aquí, y cuatro rectángulos idénticos no
     ayudan a imaginar nada. El ancho manda sobre el primero y el último. */
  .casa {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .casa .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .casa h2 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    margin: 0.2rem 0 0;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 1.4rem;
  }
  /* `:global` porque los hijos son componentes con su propio ámbito de estilos:
     sin él, Astro no deja que esta hoja alcance al <figure> de PhotoGuide y los
     cuatro huecos salen del mismo tamaño. */
  .wall > :global(*:first-child) {
    grid-column: span 2;
  }
  /* En ancho, mosaico de tres columnas colocado a mano: la barra manda arriba,
     el comedor sostiene la derecha a doble alto y los dos cuadrados rellenan
     debajo. Cuatro celdas iguales no dirían nada sobre qué foto pesa más. */
  @media (min-width: 861px) {
    .wall {
      grid-template-columns: repeat(3, 1fr);
    }
    .wall > :global(*:nth-child(1)) {
      grid-column: 1 / span 2;
      grid-row: 1;
    }
    .wall > :global(*:nth-child(2)) {
      grid-column: 1;
      grid-row: 2;
    }
    .wall > :global(*:nth-child(3)) {
      grid-column: 2;
      grid-row: 2;
    }
    .wall > :global(*:nth-child(4)) {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  .visita {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .visita h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 1.6rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: stretch;
  }
  @media (max-width: 820px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
  .info {
    margin: 0;
  }
  .block {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .block dt {
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: var(--fs-label);
    color: var(--rojo);
    margin: 0 0 0.4rem;
  }
  .block dd {
    margin: 0;
    font-size: 1.08rem;
  }
  .block dd small {
    display: block;
    color: var(--ink-dim);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 1.2rem;
    font-size: 1rem;
  }
  .hours span {
    color: var(--ink-dim);
  }
  .mapbox {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: 6px;
    overflow: hidden;
    min-height: 300px;
    background:
      radial-gradient(circle at 40% 45%, rgba(198, 34, 43, 0.14), transparent 45%),
      repeating-linear-gradient(0deg, rgba(26, 26, 26, 0.06) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(90deg, rgba(26, 26, 26, 0.06) 0 1px, transparent 1px 46px),
      var(--paper-3);
  }
  .pin {
    position: absolute;
    left: 40%;
    top: 45%;
    transform: translate(-50%, -100%);
    text-align: center;
  }
  .dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--rojo);
    margin: 0 auto;
    box-shadow: 0 0 0 6px rgba(198, 34, 43, 0.2), 2px 2px 0 var(--ink);
  }
  .pin span {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--paper);
    background: var(--ink);
    padding: 4px 10px;
    border-radius: 3px;
    margin-top: 8px;
    display: inline-block;
  }
  .ph {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  /* Móvil: la hoja de bar es densa y vertical, no aireada. Nada de scroll
     lateral en esta marca — es justo lo que la separa de Cokima. Va al final
     de la hoja porque comparte especificidad con las reglas de arriba. */
  @media (max-width: 860px) {
    .manifesto {
      padding: 28px 0 0;
    }
    .tasca,
    .visita {
      padding-top: 28px;
    }
    .manifesto .rule,
    .tasca .rule,
    .visita .rule {
      margin-bottom: 20px;
    }
    .sub,
    .txt {
      font-size: 1rem;
      margin-top: 0.9rem;
    }
  }
</style>
