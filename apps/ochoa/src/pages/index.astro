---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";
import Ticker from "../components/Ticker.astro";
import Mapa from "../components/Mapa.astro";
import Contacto from "../components/Contacto.astro";
import barra from "../assets/casa/barra.jpg";
import rotulo from "../assets/casa/rotulo.jpg";
import vermu from "../assets/casa/vermu.jpg";
import comedor from "../assets/casa/comedor.jpg";

const featured = pickFeatured((await getCollection("menu-es")).map((e) => e.data));

// La casa: ya no son rejillas. Las cuatro son fotos reales del local, de la
// propia web del grupo, así que esta sección se publica.
//
// `rotulo` se separa de las otras tres porque no va en el muro: va abrazada por
// el titular, entre «lo que hay» y «detrás del cristal». La foto es literalmente
// el cristal rotulado, así que la frase se termina de leer en la imagen en vez
// de describirla. Es el recurso que nos gustó de la portada de Sibuya —el medio
// como una línea más del titular, no como fondo— traído al único sitio de la
// hoja donde no deshace una decisión ya tomada.
const cristal = {
  src: rotulo,
  alt: "Rótulo de Los Ochoa pintado en el cristal, con la terraza al otro lado",
};
const casa = [
  { src: barra, alt: "Barra de Los Ochoa con las botellas y el espejo rotulado a mano: tortilla, gildas, ensaladilla, patatas bravas" },
  { src: vermu, alt: "Vermú con hielo y una banderilla de anchoa y aceituna sobre mármol" },
  { src: comedor, alt: "Interior del local: banco corrido rojo, mesas de mármol y el rótulo visto desde dentro" },
];
---

<Base
  title="Tasquita Los Ochoa · La tasca que te mereces · Madrid"
  description="Bar madrileño de toda la vida con gastronomía renovada, en plena Castellana. Vermú, tapas con un toque diferente y aperitivos que se alargan hasta la noche."
  locale="es"
  altPath="/en/"
>
  <Hero locale="es" />

  <Highlights dishes={featured} locale="es" href="/carta" />

  {/* Va debajo de la tira y no debajo de la portada: ahí arriba el hueco está
      medido para que asome la primera ficha de plato, y meter una banda lo
      gastaría entero. Aquí hace de corte entre los platos y el manifiesto. */}
  <Ticker locale="es" />

  <section class="manifesto">
    <div class="wrap">
      <div class="rule"></div>
      <blockquote>«Aperitivos de esos que se alargan hasta la noche, <strong>como filosofía de vida</strong>.»</blockquote>
      <p class="sub">
        Un espacio divertido en plena Castellana donde beberte un buen vermú y acompañarlo de tapas
        con un toque diferente. El tapeo de toda la vida, con sabores nuevos.
      </p>
    </div>
  </section>

  <section class="tasca">
    <div class="wrap"><div class="rule"></div></div>
    <div class="wrap tasca-grid">
      <div class="tasca-photo">
        <img src="/images/mesa.jpg" alt="Mesa de mármol con varios platos de la carta servidos para compartir" width="1920" height="1080" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">La tasca</p>
        <h2 class="cartel">El bar de toda la vida, renovado</h2>
        <p class="txt">
          Barra, mármol y rótulo rojo. <em>El tapeo de toda la vida que te sorprenderá con sabores
          nuevos</em> y con la mejor calidad de producto — de la ensaladilla al cachopín, pasando
          por unas gyozas de txistorra.
        </p>
        {/* El enlace de contexto va aquí y no en el pie: «La tasca» es donde la
            home insinúa que hay una historia detrás, así que es donde tiene
            sentido ofrecerla. Es además lo que le da peso interno a la página
            nueva, que si solo cuelga del menú no lo tiene. */}
        <p class="acciones">
          <a href="/carta" class="btn ghost">Ver la carta completa</a>
          <a href="/conocenos" class="btn ghost">Conócenos</a>
        </p>
      </div>
    </div>
  </section>

  <section class="casa">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">La casa</p>
      {/* El titular es un solo h2 partido en dos bloques con la foto en medio:
          para quien lo escucha sigue siendo una frase seguida, porque la imagen
          va entre los dos tramos de texto y no dentro de ninguno. */}
      <h2 class="cartel titular-cristal">
        <span class="tramo">Lo que hay</span>
        <Image
          src={cristal.src}
          alt={cristal.alt}
          widths={[390, 640, 960]}
          sizes="(max-width: 860px) 100vw, 560px"
          quality={72}
          loading="lazy"
          class="cristal-shot"
        />
        <span class="tramo">Detrás del cristal</span>
      </h2>
      <p class="txt">
        Barra, mármol y vermú de media tarde. <em>El tapeo que se alarga hasta que alguien mira
        el reloj</em> y resulta que ya es de noche. Los Ochoa por dentro.
      </p>
      <div class="wall">
        {casa.map((c) => (
          <Image
            src={c.src}
            alt={c.alt}
            widths={[320, 640, 900]}
            sizes="(max-width: 860px) 46vw, 33vw"
            quality={72}
            loading="lazy"
            class="casa-shot"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="visita" id="visita">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Dónde estamos</p>
      <h2 class="cartel">En plena Castellana</h2>
      {/* El mapa abre la sección en vez de cerrarla: quien llega hasta aquí ya
          sabe que quiere venir, y lo primero que necesita es situarse. Detrás,
          las dos acciones —llamar y mirar el Instagram— y solo después los
          datos en frío. */}
      <div class="visit-grid">
        <Mapa locale="es" />
        <div class="datos">
          <Contacto locale="es" />
          <dl class="info">
            <div class="block"><dt>Dirección</dt><dd>P.º de la Castellana, 117<small>28046 Madrid</small></dd></div>
            <div class="block">
              <dt>Horario</dt>
              <dd>
                <div class="hours">
                  <span>Lunes a jueves</span><b>9:00 – 1:00</b>
                  <span>Viernes</span><b>9:00 – 2:30</b>
                  <span>Sábado</span><b>12:00 – 2:30</b>
                  <span>Domingo</span><b>12:00 – 1:00</b>
                </div>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto {
    padding: clamp(44px, 7vw, 84px) 0;
  }
  .manifesto .rule {
    margin-bottom: clamp(30px, 5vw, 52px);
  }
  blockquote {
    margin: 0;
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.32;
    max-width: 26ch;
    text-wrap: balance;
  }
  blockquote strong {
    color: var(--rojo);
  }
  .sub {
    font-size: 1.08rem;
    color: var(--ink-dim);
    max-width: 56ch;
    margin: 1.5rem 0 0;
  }
  .tasca {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  /* Cada sección abre con el mismo filete doble que ya usaba el manifiesto: la
     hoja de bar se lee como un cartel pautado, no como bloques flotando. */
  .tasca .rule,
  .visita .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .tasca-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  /* Dos botones en hueco, uno al lado del otro. Envuelven en vez de encogerse
     porque los dos llevan sombra dura y su recorrido al pulsar cuenta con tener
     los tres píxeles libres: apretados en una línea se pisarían al hundirse. */
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 860px) {
    .tasca-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Apaisada 16:9, la proporción del propio archivo: aquí vive el cenital de la
     mesa y recortarlo a cuadrado se comía media mesa. */
  .tasca-photo {
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
    overflow: hidden;
    box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
    aspect-ratio: 16 / 9;
  }
  .tasca-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tasca h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 0;
  }
  .txt {
    color: var(--ink-dim);
    font-size: 1.08rem;
    max-width: 50ch;
    margin: 1.3rem 0 1.6rem;
  }
  .txt em {
    color: var(--ink);
  }
  /* Cuadrícula de dos por dos, con las cuatro del mismo tamaño y la misma
     proporción. El mosaico asimétrico que hubo antes hacía justo lo contrario de
     lo que necesita esta sección: llamaba la atención sobre la composición en vez
     de sobre las fotos, y con cuatro piezas se leía como descuadrado más que
     como intencionado. */
  .casa {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .casa .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .casa h2 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    margin: 0.2rem 0 0;
  }
  /* El titular abraza la foto: los dos tramos de texto y la imagen son un solo
     bloque, con el mismo interlineado apretado del cartel a cada lado. La foto
     no lleva la sombra dura roja que sí llevan las del muro —aquí hace de
     palabra, y una palabra no se realza contra sí misma. */
  .titular-cristal {
    display: grid;
    gap: clamp(10px, 2.5vw, 18px);
    justify-items: start;
  }
  .cristal-shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
  }
  /* Dos columnas desfasadas: la de la derecha baja un escalón para que la serie
     no se lea como una tabla. Ni el mosaico de piezas de tamaños distintos —que
     llamaba la atención sobre la composición— ni la cuadrícula perfecta, que era
     lo contrario y quedaba rígida. El desfase también hace que se vea siempre
     media foto empezada, que invita a seguir bajando. */
  .wall {
    display: grid;
    /* `minmax(0, 1fr)` y no `1fr` a secas: un track `1fr` es en realidad
       `minmax(auto, 1fr)`, y el mínimo automático de una imagen es su tamaño
       intrínseco —estas declaran 1000px—, así que el track se negaba a bajar de
       ahí por mucho `width: 100%` que llevara la foto. Medido a 375px, la
       retícula se iba a 513 y sacaba 138px de scroll lateral a toda la portada.
       El cero le da permiso al track para encoger. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 22px);
    margin-top: 1.6rem;
    padding-bottom: clamp(18px, 3vw, 34px);
    --desfase: clamp(28px, 7vw, 64px);
  }
  .wall > :global(*:nth-child(2n)) {
    margin-top: var(--desfase);
  }
  /* Quedan tres piezas desde que el rótulo se fue al titular, y tres en dos
     columnas dejaban un hueco al final. La última pasa a ancho completo y la
     sección cierra en plano: no es el mosaico de tamaños arbitrarios que se
     retiró —ahí el desorden era el recurso—, sino la fila de cierre de una
     retícula que sigue siendo de dos columnas. Por eso tampoco hace falta ya
     el relleno del escalón: no hay diente que compensar. */
  .wall > :global(*:nth-child(3)) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .casa-shot {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
  }
  /* La primera y la última llevan el realce rojo de la casa, en esquinas
     opuestas: es el mismo recurso del retrato de «la tasca», y remata el
     escalonado por sus dos extremos. */
  .wall > :global(*:first-child) {
    box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
  }
  .wall > :global(*:last-child) {
    box-shadow: 8px 8px 0 rgba(198, 34, 43, 0.9);
  }

  .visita {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .visita h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 1.6rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: stretch;
  }
  @media (max-width: 820px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
  .info {
    margin: 0;
  }
  .block {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .block dt {
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: var(--fs-label);
    color: var(--rojo);
    margin: 0 0 0.4rem;
  }
  .block dd {
    margin: 0;
    font-size: 1.08rem;
  }
  .block dd small {
    display: block;
    color: var(--ink-dim);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 1.2rem;
    font-size: 1rem;
  }
  .hours span {
    color: var(--ink-dim);
  }
  /* Las acciones separadas de los datos: entre pulsar «llamar» y leer el
     horario hay un cambio de marcha, y el hueco lo dice mejor que una regla. */
  .datos {
    display: grid;
    gap: clamp(18px, 3vw, 26px);
    align-content: start;
  }

  /* Móvil: la hoja de bar es densa y vertical, no aireada. Nada de scroll
     lateral en esta marca — es justo lo que la separa de Cokima. Va al final
     de la hoja porque comparte especificidad con las reglas de arriba. */
  @media (max-width: 860px) {
    .manifesto {
      padding: 28px 0 0;
    }
    .visita {
      padding-top: 28px;
    }
    /* Las dos secciones que cargan fotografía respiran casi el doble que el
       resto. La densidad de la hoja se mantiene donde es texto —que es lo que
       la hace una hoja de bar y no un folleto—, pero una foto pegada a la
       anterior se lee como error de montaje y no como ritmo. El asomo de la
       portada y el relleno apretado de la tira de platos siguen intactos: esos
       dos están medidos para que la primera ficha se vea sin bajar. */
    .tasca,
    .casa {
      padding-top: 52px;
    }
    .manifesto .rule,
    .tasca .rule,
    .visita .rule {
      margin-bottom: 20px;
    }
    .sub,
    .txt {
      font-size: 1rem;
      margin-top: 0.9rem;
    }
  }
</style>
