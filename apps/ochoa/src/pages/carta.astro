---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MenuBoard from "../components/MenuBoard.astro";

const all = (await getCollection("menu-es")).map((e) => e.data);
---

<Base
  title="La carta · Tasquita Los Ochoa"
  description="La carta de Los Ochoa en la Castellana: pinchos y tapas, montados y bocatines, y raciones como la ensaladilla, las croquetas de Joselito, el cachopín o el croissant de rabo de toro."
  locale="es"
  altPath="/en/menu"
>
  <section class="carta">
    <div class="wrap">
      <p class="eyebrow">Tasquita · Madriz</p>
      <h1 class="cartel">Carta</h1>

      <MenuBoard dishes={all} locale="es" />

      <p class="note">Carta facilitada por el restaurante en julio de 2026. La carta de bebidas no se publica aquí.</p>
    </div>
  </section>
</Base>

<style>
  .carta {
    padding: clamp(48px, 8vw, 92px) 0 0;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    margin: 0.15rem 0 0;
  }
  .note {
    font-family: var(--sans);
    font-size: 0.88rem;
    color: var(--ink-faint);
    margin-top: 2.4rem;
    text-align: center;
  }
</style>
