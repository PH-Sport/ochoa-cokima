---
import Base from "../layouts/Base.astro";
---

<Base title="Política de privacidad · Tasquita Los Ochoa" description="Política de privacidad de Tasquita Los Ochoa." locale="es" altPath="/en/" altSeoPath={null}>
  <section class="legal">
    <div class="wrap">
      <h1 class="cartel">Política de privacidad</h1>
      <p>
        Los datos facilitados a través del módulo de reservas son tratados por CoverManager
        como encargado del tratamiento para gestionar tu reserva. No almacenamos datos
        personales en este sitio web.
      </p>
      <p>
        El responsable del tratamiento es <em>[razón social pendiente — datos fiscales del
        cliente]</em>. Este contenido se completará antes de la puesta en producción.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal { padding: clamp(48px, 8vw, 92px) 0 0; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  p { color: var(--ink-dim); max-width: 65ch; }
</style>
