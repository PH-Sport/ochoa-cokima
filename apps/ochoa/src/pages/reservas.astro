---
import Base from "../layouts/Base.astro";
import BookingEmbed from "@tombo/ui/BookingEmbed.astro";
import { COVER_SLUG } from "../site.ts";
---

<Base
  title="Reservas · Tasquita Los Ochoa"
  description="Reserva tu mesa en Tasquita Los Ochoa, Paseo de la Castellana 117, Madrid. Abierto todos los días, hasta las 2:30 los viernes y sábados."
  locale="es"
  altPath="/en/reservations"
>
  <section class="reservar">
    <div class="wrap">
      <div class="grid">
        <div>
          <p class="eyebrow">Reservas</p>
          <h1 class="cartel">Reserva tu mesa</h1>
          <p class="txt">
            Abierto todos los días, hasta las 2:30 los viernes y sábados.
            Si no encuentras hueco, llámanos al <a href="tel:+34912876820">912 87 68 20</a>.
          </p>
        </div>
        <BookingEmbed slug={COVER_SLUG} locale="es" title="Reservas Tasquita Los Ochoa" />
      </div>
    </div>
  </section>
</Base>

<style>
  .reservar {
    padding: clamp(48px, 8vw, 92px) 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.15rem 0 0;
  }
  .txt {
    color: var(--ink-dim);
    margin: 1.2rem 0 0;
    max-width: 44ch;
  }
  .txt a {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
