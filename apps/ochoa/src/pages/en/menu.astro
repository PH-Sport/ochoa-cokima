---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import MenuSection from "@tombo/ui/MenuSection.astro";

const all = (await getCollection("menu-en")).map((e) => e.data);
const bySection = (s: string) => all.filter((d) => d.section === s);
---

<Base
  title="Menu · Tasquita Los Ochoa"
  description="Los Ochoa's menu on the Castellana: Russian salad, Joselito ham croquettes, patatas bravas, oxtail croissant and more. Half or full portions."
  locale="en"
  altPath="/carta"
>
  <section class="carta">
    <div class="wrap">
      <p class="eyebrow">Tasquita · Madriz</p>
      <h1 class="cartel">Menu</h1>

      <MenuSection title="For tapeo" dishes={bySection("carta")} showAllergens={false} halfLabel="½ portion" fullLabel="Full" layout="list" />
      <MenuSection title="Desserts" dishes={bySection("postres")} showAllergens={false} layout="list" />

      <p class="note">Bread basket with olive oil: €3. Menu from September 2025, the latest published — pending confirmation by the restaurant.</p>
    </div>
  </section>
</Base>

<style>
  .carta {
    padding: clamp(48px, 8vw, 92px) 0 0;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    margin: 0.15rem 0 0;
  }
  .note {
    font-family: var(--sans);
    font-size: 0.88rem;
    color: var(--ink-faint);
    margin-top: 2.4rem;
    text-align: center;
  }
</style>
