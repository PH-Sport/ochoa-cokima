---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import MenuBoard from "../../components/MenuBoard.astro";

const all = (await getCollection("menu-en")).map((e) => e.data);
---

<Base
  title="Menu · Tasquita Los Ochoa"
  description="Los Ochoa's menu on the Castellana: Russian salad, Joselito ham croquettes, patatas bravas, oxtail croissant and more. Half or full portions."
  locale="en"
  altPath="/carta"
>
  <section class="carta">
    <div class="wrap">
      <p class="eyebrow">Tasquita · Madriz</p>
      <h1 class="cartel">Menu</h1>

      <MenuBoard dishes={all} locale="en" />

      <p class="note">Menu provided by the restaurant in July 2026. The drinks list is not published here.</p>
    </div>
  </section>
</Base>

<style>
  .carta {
    padding: clamp(48px, 8vw, 92px) 0 0;
  }
  /* La carta ocupa el 90% de la pantalla a cualquier ancho (prueba de Mario,
     2026-09-19): sin el tope de 1140px de `.wrap` y con un 5% de margen a cada
     lado, que en el móvil es lo mismo que había. El porqué del tope que había
     está en MenuBoard.astro, junto a `--carta-w`. */
  .carta .wrap {
    max-width: none;
    padding-inline: 5vw;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    margin: 0.15rem 0 0;
  }
  .note {
    font-family: var(--sans);
    font-size: 0.88rem;
    color: var(--ink-faint);
    margin-top: 2.4rem;
    text-align: center;
  }
</style>
