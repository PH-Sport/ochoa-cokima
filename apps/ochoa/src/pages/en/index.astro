---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Highlights from "../../components/Highlights.astro";

const featured = pickFeatured((await getCollection("menu-en")).map((e) => e.data));
---

<Base
  title="Tasquita Los Ochoa · The tasca you deserve · Madrid"
  description="A lifelong Madrid neighbourhood bar with a renewed kitchen, right on the Castellana. Vermouth, tapas with a twist and aperitivos that stretch into the night."
  locale="en"
  altPath="/"
>
  <Hero locale="en" />

  <Highlights dishes={featured} locale="en" href="/en/menu" />

  <section class="manifesto">
    <div class="wrap">
      <div class="rule"></div>
      <blockquote>“Aperitivos that stretch into the night, <strong>as a philosophy of life</strong>.”</blockquote>
      <p class="sub">
        A fun spot right on the Castellana to sip a good vermouth alongside tapas with a twist.
        Lifelong tapeo, with new flavours.
      </p>
    </div>
  </section>

  <section class="visita" id="visit">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Find us</p>
      <h2 class="cartel">On the Castellana</h2>
      <div class="visit-grid">
        <dl class="info">
          <div class="block"><dt>Address</dt><dd>P.º de la Castellana, 117<small>28046 Madrid</small></dd></div>
          <div class="block"><dt>Phone</dt><dd><a href="tel:+34912876820">+34 912 87 68 20</a></dd></div>
          <div class="block">
            <dt>Hours</dt>
            <dd>
              <div class="hours">
                <span>Monday to Thursday</span><b>9:00 – 1:00</b>
                <span>Friday</span><b>9:00 – 2:30</b>
                <span>Saturday</span><b>12:00 – 2:30</b>
                <span>Sunday</span><b>12:00 – 1:00</b>
              </div>
            </dd>
          </div>
          <div class="block"><dt>Instagram</dt><dd><a href="https://instagram.com/tasquita.losochoa">@tasquita.losochoa</a></dd></div>
        </dl>
        <div class="mapbox" role="img" aria-label="Map placeholder: Paseo de la Castellana 117, Madrid">
          <div class="pin"><i class="dot"></i><span>Castellana 117</span></div>
          <span class="ph">Map · integration pending</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto { padding: clamp(44px, 7vw, 84px) 0; }
  .manifesto .rule { margin-bottom: clamp(30px, 5vw, 52px); }
  blockquote { margin: 0; font-family: var(--display); text-transform: uppercase; letter-spacing: 0.01em; font-size: clamp(1.5rem, 3.5vw, 2.5rem); line-height: 1.32; max-width: 26ch; text-wrap: balance; }
  blockquote strong { color: var(--rojo); }
  .sub { font-size: 1.08rem; color: var(--ink-dim); max-width: 56ch; margin: 1.5rem 0 0; }
  /* Mismo filete doble de cartel que abre el manifiesto: ver index.astro. */
  .visita { padding: clamp(32px, 6vw, 56px) 0 0; }
  .visita .rule { margin-bottom: clamp(22px, 4vw, 40px); }
  .visita h2 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin: 0.2rem 0 1.6rem; }
  .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 56px); align-items: stretch; }
  @media (max-width: 820px) { .visit-grid { grid-template-columns: 1fr; } }
  .info { margin: 0; }
  .block { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .block dt { font-family: var(--sans); font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; font-size: 0.8rem; color: var(--rojo); margin: 0 0 0.4rem; }
  .block dd { margin: 0; font-size: 1.08rem; }
  .block dd small { display: block; color: var(--ink-dim); font-size: 0.9rem; margin-top: 0.3rem; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 1.2rem; font-size: 1rem; }
  .hours span { color: var(--ink-dim); }
  .mapbox { position: relative; border: 2px solid var(--ink); border-radius: 6px; overflow: hidden; min-height: 300px; background: radial-gradient(circle at 40% 45%, rgba(198, 34, 43, 0.14), transparent 45%), repeating-linear-gradient(0deg, rgba(26, 26, 26, 0.06) 0 1px, transparent 1px 46px), repeating-linear-gradient(90deg, rgba(26, 26, 26, 0.06) 0 1px, transparent 1px 46px), var(--paper-3); }
  .pin { position: absolute; left: 40%; top: 45%; transform: translate(-50%, -100%); text-align: center; }
  .dot { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--rojo); margin: 0 auto; box-shadow: 0 0 0 6px rgba(198, 34, 43, 0.2), 2px 2px 0 var(--ink); }
  .pin span { font-family: var(--sans); font-size: 0.82rem; color: var(--paper); background: var(--ink); padding: 4px 10px; border-radius: 3px; margin-top: 8px; display: inline-block; }
  .ph { position: absolute; left: 14px; bottom: 12px; font-family: var(--sans); font-size: 0.8rem; color: var(--ink-faint); }

  /* Densificación móvil de la hoja de bar: ver index.astro. */
  @media (max-width: 860px) {
    .hero { padding: 28px 0 32px; }
    .hero h1 { font-size: clamp(2.6rem, 9vw, 4rem); }
    .hero-photo { aspect-ratio: 16 / 9; }
    .kicker { font-size: 1rem; margin-top: 1rem; }
    .manifesto { padding: 28px 0 0; }
    .visita { padding-top: 28px; }
    .manifesto .rule, .visita .rule { margin-bottom: 20px; }
    .sub { font-size: 1rem; margin-top: 0.9rem; }
  }
</style>
