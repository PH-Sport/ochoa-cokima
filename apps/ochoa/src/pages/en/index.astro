---
import { getCollection } from "astro:content";
import { pickFeatured } from "@tombo/content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Highlights from "../../components/Highlights.astro";
import Ticker from "../../components/Ticker.astro";
import Mapa from "../../components/Mapa.astro";
import Contacto from "../../components/Contacto.astro";
import barra from "../../assets/casa/barra.jpg";
import rotulo from "../../assets/casa/rotulo.jpg";
import vermu from "../../assets/casa/vermu.jpg";
import comedor from "../../assets/casa/comedor.jpg";

const featured = pickFeatured((await getCollection("menu-en")).map((e) => e.data));

// Las mismas cuatro fotos reales del local que la hoja española, con los `alt`
// traducidos: son descripciones de lo que se ve, no texto de marca, así que se
// traducen igual que el resto.
const cristal = {
  src: rotulo,
  alt: "The Los Ochoa sign painted on the window, with the terrace on the other side",
};
const casa = [
  { src: barra, alt: "The bar at Los Ochoa with its bottles and hand-lettered mirror: tortilla, gildas, Russian salad, patatas bravas" },
  { src: vermu, alt: "Vermouth on the rocks with an anchovy and olive skewer on marble" },
  { src: comedor, alt: "Inside the bar: red banquette, marble tables and the sign seen from within" },
];
---

<Base
  title="Tasquita Los Ochoa · The tasca you deserve · Madrid"
  description="A lifelong Madrid neighbourhood bar with a renewed kitchen, right on the Castellana. Vermouth, tapas with a twist and aperitivos that stretch into the night."
  locale="en"
  altPath="/"
>
  <Hero locale="en" />

  <Highlights dishes={featured} locale="en" href="/en/menu" />

  {/* Va debajo de la tira y no debajo de la portada: ahí arriba el hueco está
      medido para que asome la primera ficha de plato. Ver index.astro. */}
  <Ticker locale="en" />

  <section class="manifesto">
    <div class="wrap">
      <div class="rule"></div>
      <blockquote>“Aperitivos that stretch into the night, <strong>as a philosophy of life</strong>.”</blockquote>
      <p class="sub">
        A fun spot right on the Castellana to sip a good vermouth alongside tapas with a twist.
        Lifelong tapeo, with new flavours.
      </p>
    </div>
  </section>

  <section class="tasca">
    <div class="wrap"><div class="rule"></div></div>
    <div class="wrap tasca-grid">
      <div class="tasca-photo">
        <img src="/images/mesa.jpg" alt="Marble table with several dishes from the menu, served to share" width="1920" height="1080" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">The tasca</p>
        <h2 class="cartel">The lifelong bar, renewed</h2>
        <p class="txt">
          Bar, marble and a red sign. <em>The tapeo of a lifetime, with new flavours that will
          surprise you</em> and the best produce there is — from the Russian salad to the
          cachopín, by way of txistorra gyozas.
        </p>
        <p><a href="/en/menu" class="btn ghost">See the full menu</a></p>
      </div>
    </div>
  </section>

  <section class="casa">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">The house</p>
      {/* El titular es un solo h2 partido en dos bloques con la foto en medio:
          para quien lo escucha sigue siendo una frase seguida, porque la imagen
          va entre los dos tramos de texto y no dentro de ninguno. */}
      <h2 class="cartel titular-cristal">
        <span class="tramo">What goes on</span>
        <Image
          src={cristal.src}
          alt={cristal.alt}
          widths={[390, 640, 960]}
          sizes="(max-width: 860px) 100vw, 560px"
          quality={72}
          loading="lazy"
          class="cristal-shot"
        />
        <span class="tramo">Behind the glass</span>
      </h2>
      <p class="txt">
        Bar, marble and mid-afternoon vermouth. <em>The tapeo that stretches until somebody
        checks the clock</em> and it turns out it's already night. Los Ochoa from the inside.
      </p>
      <div class="wall">
        {casa.map((c) => (
          <Image
            src={c.src}
            alt={c.alt}
            widths={[320, 640, 900]}
            sizes="(max-width: 860px) 46vw, 33vw"
            quality={72}
            loading="lazy"
            class="casa-shot"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="visita" id="visit">
    <div class="wrap">
      <div class="rule"></div>
      <p class="eyebrow">Find us</p>
      <h2 class="cartel">On the Castellana</h2>
      {/* El mapa abre la sección en vez de cerrarla: quien llega hasta aquí ya
          sabe que quiere venir. Detrás, las dos acciones, y solo después los
          datos en frío. El teléfono y el Instagram los da `Contacto`, así que no
          se repiten en la lista. */}
      <div class="visit-grid">
        <Mapa locale="en" />
        <div class="datos">
          <Contacto locale="en" />
          <dl class="info">
            <div class="block"><dt>Address</dt><dd>P.º de la Castellana, 117<small>28046 Madrid</small></dd></div>
            <div class="block">
              <dt>Hours</dt>
              <dd>
                <div class="hours">
                  <span>Monday to Thursday</span><b>9:00 – 1:00</b>
                  <span>Friday</span><b>9:00 – 2:30</b>
                  <span>Saturday</span><b>12:00 – 2:30</b>
                  <span>Sunday</span><b>12:00 – 1:00</b>
                </div>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .manifesto {
    padding: clamp(44px, 7vw, 84px) 0;
  }
  .manifesto .rule {
    margin-bottom: clamp(30px, 5vw, 52px);
  }
  blockquote {
    margin: 0;
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.32;
    max-width: 26ch;
    text-wrap: balance;
  }
  blockquote strong {
    color: var(--rojo);
  }
  .sub {
    font-size: 1.08rem;
    color: var(--ink-dim);
    max-width: 56ch;
    margin: 1.5rem 0 0;
  }
  .tasca {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  /* Mismo filete doble de cartel que abre el manifiesto: ver index.astro. */
  .tasca .rule,
  .visita .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .tasca-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  @media (max-width: 860px) {
    .tasca-grid {
      grid-template-columns: 1fr;
    }
  }
  .tasca-photo {
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
    overflow: hidden;
    box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
    aspect-ratio: 16 / 9;
  }
  .tasca-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tasca h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 0;
  }
  .txt {
    color: var(--ink-dim);
    font-size: 1.08rem;
    max-width: 50ch;
    margin: 1.3rem 0 1.6rem;
  }
  .txt em {
    color: var(--ink);
  }
  .casa {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .casa .rule {
    margin-bottom: clamp(22px, 4vw, 40px);
  }
  .casa h2 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    margin: 0.2rem 0 0;
  }
  /* El titular abraza la foto: los dos tramos de texto y la imagen son un solo
     bloque. La foto no lleva la sombra dura roja que sí llevan las del muro
     —aquí hace de palabra, y una palabra no se realza contra sí misma. */
  .titular-cristal {
    display: grid;
    gap: clamp(10px, 2.5vw, 18px);
    justify-items: start;
  }
  .cristal-shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
  }
  /* Dos columnas desfasadas, con la tercera a ancho completo cerrando en plano:
     ver index.astro, donde está el razonamiento entero. */
  .wall {
    display: grid;
    /* `minmax(0, 1fr)`: ver index.astro, donde está el razonamiento. Sin el
       cero, el mínimo intrínseco de las fotos empuja la retícula fuera de la
       pantalla. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 22px);
    margin-top: 1.6rem;
    padding-bottom: clamp(18px, 3vw, 34px);
    --desfase: clamp(28px, 7vw, 64px);
  }
  .wall > :global(*:nth-child(2n)) {
    margin-top: var(--desfase);
  }
  .wall > :global(*:nth-child(3)) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .casa-shot {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
  }
  .wall > :global(*:first-child) {
    box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
  }
  .wall > :global(*:last-child) {
    box-shadow: 8px 8px 0 rgba(198, 34, 43, 0.9);
  }

  .visita {
    padding: clamp(32px, 6vw, 56px) 0 0;
  }
  .visita h2 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.2rem 0 1.6rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: stretch;
  }
  @media (max-width: 820px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
  .info {
    margin: 0;
  }
  .block {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .block dt {
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: var(--fs-label);
    color: var(--rojo);
    margin: 0 0 0.4rem;
  }
  .block dd {
    margin: 0;
    font-size: 1.08rem;
  }
  .block dd small {
    display: block;
    color: var(--ink-dim);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 1.2rem;
    font-size: 1rem;
  }
  .hours span {
    color: var(--ink-dim);
  }
  /* Las acciones separadas de los datos: entre pulsar «llamar» y leer el
     horario hay un cambio de marcha, y el hueco lo dice mejor que una regla. */
  .datos {
    display: grid;
    gap: clamp(18px, 3vw, 26px);
    align-content: start;
  }

  /* Densificación móvil de la hoja de bar: ver index.astro. */
  @media (max-width: 860px) {
    .manifesto {
      padding: 28px 0 0;
    }
    .visita {
      padding-top: 28px;
    }
    .tasca,
    .casa {
      padding-top: 52px;
    }
    .manifesto .rule,
    .tasca .rule,
    .visita .rule {
      margin-bottom: 20px;
    }
    .sub,
    .txt {
      font-size: 1rem;
      margin-top: 0.9rem;
    }
  }
</style>
