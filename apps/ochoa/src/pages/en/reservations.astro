---
import Base from "../../layouts/Base.astro";
import BookingEmbed from "@tombo/ui/BookingEmbed.astro";
import { COVER_SLUG } from "../../site.ts";
---

<Base
  title="Reservations · Tasquita Los Ochoa"
  description="Book your table at Tasquita Los Ochoa, Paseo de la Castellana 117, Madrid. Open every day, until 2:30 am on Fridays and Saturdays."
  locale="en"
  altPath="/reservas"
>
  <section class="reservar">
    <div class="wrap">
      <div class="grid">
        <div>
          <p class="eyebrow">Reservations</p>
          <h1 class="cartel">Book your table</h1>
          <p class="txt">
            Open every day, until 2:30 am on Fridays and Saturdays.
            Can't find a slot? Call us on <a href="tel:+34912876820">+34 912 87 68 20</a>.
          </p>
        </div>
        <BookingEmbed slug={COVER_SLUG} locale="en" title="Tasquita Los Ochoa reservations" />
      </div>
    </div>
  </section>
</Base>

<style>
  .reservar {
    padding: clamp(48px, 8vw, 92px) 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0.15rem 0 0;
  }
  .txt {
    color: var(--ink-dim);
    margin: 1.2rem 0 0;
    max-width: 44ch;
  }
  .txt a {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
