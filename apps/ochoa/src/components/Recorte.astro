---
// apps/ochoa/src/components/Recorte.astro
//
// Un plato recortado, sin fondo, en un hueco blanco del Inicio (rama de prueba
// `feat/inicio-paralaje`, 2026-10-28). Es la capa cercana del paralaje: al bajar
// va un pelo más rápido que la página.
//
// Mario lo afinó en tres vueltas. Platos sueltos flotando como adorno: efecto
// pegatina. Dos al pie de cada foto: «no me convencen el par en el pie de cada
// foto». Asomando por las esquinas de las fotos, de uno en uno: el paralaje
// «exageradamente notorio» y los platos encima de fotos y textos. Así que ahora
// van solo en blanco y nunca encima de nada, de dos maneras:
//
// - `flota`: a la derecha de un párrafo, que lo rodea. El plato reserva su hueco
//   y el texto se aparta, así que no lo pisa a ningún ancho de pantalla.
// - `al-lado`: en el blanco que deja a su derecha un bloque corto —un titular de
//   tres palabras, la dirección, el horario—, pegado abajo a la derecha de su
//   contenedor, que tiene que llevar `position: relative`.
//
// El paralaje lo mueve como mucho `data-tope` píxeles (8): los márgenes de los
// dos modos son mayores, así que ni en el extremo toca el texto.
//
// Es decoración: el plato ya lo nombra el texto o la carta, así que va sin
// texto alternativo y fuera del árbol de accesibilidad.
//
// Los recortes y de dónde salen, en docs/fotografia.md §Los platos recortados.
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  modo: "flota" | "al-lado";
  /** Alto del plato en píxeles. El ancho sale de su proporción. */
  alto: number;
  /** Solo `al-lado`: cuánto se separa del fondo de su contenedor. */
  abajo?: number;
}
const { src, modo, alto, abajo = 0 } = Astro.props;
---

<span
  class:list={["recorte", modo]}
  style={`--alto: ${alto}px; --abajo: ${abajo}px`}
  data-vel="0.04"
  data-tope="8"
  aria-hidden="true"
>
  <Image
    src={src}
    alt=""
    height={alto * 2}
    quality={80}
    loading="lazy"
  />
</span>

<style>
  .recorte {
    display: block;
    pointer-events: none;
    will-change: transform;
  }
  /* Un margen mayor que el tope del paralaje (8 px) por cada lado en que haya
     texto. */
  .flota {
    float: right;
    margin: 4px 0 14px 18px;
  }
  .al-lado {
    position: absolute;
    right: 0;
    bottom: var(--abajo);
  }
  /* Por debajo de 360 px el blanco de al lado no da para un plato: a 320 el del
     horario pisaba las horas. Medido el 2026-10-28; de 360 a 1440, ninguno
     pisa nada. */
  @media (max-width: 359px) {
    .al-lado {
      display: none;
    }
  }
  .recorte :global(img) {
    display: block;
    width: auto;
    height: var(--alto);
  }
</style>
