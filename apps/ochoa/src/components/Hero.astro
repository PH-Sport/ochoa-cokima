---
// apps/ochoa/src/components/Hero.astro
import { Image } from "astro:assets";
import OpenState from "@tombo/ui/OpenState.astro";
import { RESTAURANT } from "../site.ts";
// La portada es la fachada: el toldo rojo, el cartel colgante y la terraza en la
// Castellana. Antes fue el cenital de la mesa —que recortado a pantalla vertical
// se quedaba en un fragmento de plato sin contexto— y después el rótulo del
// cristal, que era demasiado plano de cerca y no cabía entero en móvil. Esta
// dice qué sitio es antes de leer una palabra, y aguanta el recorte porque el
// nombre aparece dos veces, arriba y a la derecha.
import hero from "../assets/hero.jpg";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";
---

<header class="hero" id="top">
  <Image
    src={hero}
    alt={es
      ? "Fachada de Tasquita Los Ochoa: toldo rojo, cartel colgante con el nombre y la terraza en la calle"
      : "Tasquita Los Ochoa storefront: red awning, hanging sign and the street terrace"}
    widths={[390, 640, 960, 1200]}
    sizes="100vw"
    quality={72}
    loading="eager"
    fetchpriority="high"
    class="shot"
  />
  <div class="veil"></div>
  <div class="wrap copy">
    <h1 class="cartel">{es ? "La tasca que te mereces" : "The tavern you deserve"}</h1>
    <OpenState hours={RESTAURANT.openingHours} locale={locale} />
  </div>
</header>

<style>
  .hero {
    position: relative;
    /* svh y no vh: en móvil, vh cuenta con la barra del navegador retraída y la
       portada se corta por abajo justo donde queremos que asome el primer
       plato. Además de la cabecera se resta una franja de asomo: sin ella la
       portada llena la pantalla al píxel y la tira de platos queda invisible
       hasta que alguien decide bajar. Que asome es el punto entero. */
    height: calc(100svh - var(--t-header-h, 62px) - clamp(128px, 18vw, 156px));
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La portada es una sola pieza a sangre en todos los anchos, y el titular se
     apoya en la foto con su sombra roja. Hubo un intento de partirla en dos en
     móvil —foto arriba, titular sobre una banda roja— para que cupiera entero el
     rótulo del cristal; se retiró con esa foto: la banda roja competía con la
     imagen y la sombra del titular tenía que cambiar de color para verse, que era
     perder justo lo que mejor funcionaba. */
  @media (max-width: 860px) {
    /* Encuadre para el recorte vertical: la foto se lleva el peso al cartel
       colgante y a la puerta, no a la acera. */
    .shot {
      object-position: 62% 42%;
    }
  }
  /* Degradado solo bajo el texto, no una capa uniforme sobre toda la foto:
     apagar la imagen entera es justo lo que hacen las cinco webs que nos
     pusieron de referencia, y es lo que las vuelve intercambiables. */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, 0.92) 0%,
      rgba(26, 26, 26, 0.66) 28%,
      rgba(26, 26, 26, 0) 62%
    );
  }
  /* El cartel de cookies vive en esta misma esquina durante la primera visita.
     `--t-consent-h` lo publica el propio cartel y vuelve a 0 al decidir, así
     que el titular se aparta mientras hace falta y no un píxel más. */
  /* El apartarse es un `transform` y no el `padding` que crecía: mover el
     relleno obliga al navegador a recalcular la disposición en cada fotograma,
     y el resultado en pantalla es idéntico porque el bloque ya está anclado
     abajo y el alto de la portada no depende de él. */
  .copy {
    position: relative;
    padding-bottom: clamp(26px, 5vw, 54px);
    width: 100%;
    transform: translateY(calc(-1 * var(--t-consent-h, 0px)));
    transition: transform var(--dur-out) var(--ease);
    /* Aquí abajo la foto está oscurecida por el degradado, así que la tinta de la
       marca no se lee: el estado de apertura salía en gris oscuro sobre fondo
       oscuro. En vez de parchearlo desde fuera se le reescriben los tokens que
       consume, y cualquier pieza neutra que caiga sobre la portada se adapta. */
    --t-text: var(--paper);
    --t-text-dim: rgba(255, 255, 255, 0.9);
    --t-text-faint: rgba(255, 255, 255, 0.65);
  }
  .hero h1 {
    /* 11.5vw y no 10vw: por debajo de 416px de ancho, 10vw cae bajo el mínimo
       de 2.6rem y el cartel se queda congelado en 41.6px justo en el formato
       que más se usa —a 390px daba 39px y ganaba siempre el suelo del clamp—.
       Con 11.5vw el titular vuelve a escalar con la pantalla desde 362px, y el
       suelo sigue protegiendo a las pantallas por debajo de eso. */
    font-size: clamp(2.6rem, 11.5vw, 6rem);
    line-height: 0.94;
    margin: 0 0 14px;
    max-width: 14ch;
    /* Sobre la foto, el cartel invierte su fórmula: la tinta pasa a ser el
       papel y la sombra dura la pone el rojo de la marca. */
    color: var(--paper);
    text-shadow: 0.04em 0.045em 0 var(--rojo);
  }
</style>
