---
// apps/ochoa/src/components/Hero.astro
import { Image } from "astro:assets";
import OpenState from "@tombo/ui/OpenState.astro";
import { RESTAURANT } from "../site.ts";
// La portada son ocho fotos de Instagram, y se enseñan distinto en cada pantalla
// (2026-10-29, tercera ronda del probador; el porqué entero en
// docs/ochoa-inicio-vivo.md):
//  · En el móvil, el telón que Mario eligió el 2026-10-27 entre cinco bocetos:
//    una foto a pantalla completa y la siguiente que entra de derecha a izquierda
//    sobre ella. Siete fotos: el rótulo del cristal no cabe en vertical.
//  · En el ordenador, «la tira»: las ocho en fila, enteras, pasando despacio de
//    derecha a izquierda. Con el telón, la portada era una franja de 1440×682 y
//    de cada foto de Instagram —verticales o cuadradas— se veía entre el 36 y el
//    47% de su alto, estirada al doble en una pantalla de alta densidad.
// La serie, sus encuadres y sus textos, en `../data/portada.ts`.
import { portada } from "../data/portada.ts";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";
const enMovil = portada.filter((f) => !f.soloOrdenador);

// Lo que mide cada foto en la tira: el alto de la capa del paralaje —la portada
// del ordenador, `100svh` menos la cabecera y la franja de asomo (218 px desde
// 861 de ancho), y un 8% más por arriba y por abajo— por su proporción. Es una
// cuenta aproximada, solo para que el navegador elija el tamaño que pide.
const enTira = (f: (typeof portada)[number]) =>
  `calc((100vh - 218px) * ${((1.16 * f.src.width) / f.src.height).toFixed(3)})`;
const estilo = (f: (typeof portada)[number]) =>
  [f.encuadre && `--encuadre: ${f.encuadre}`, f.acerca && `--acerca: ${f.acerca}`].filter(Boolean).join("; ") || undefined;
---

<header class="hero" id="top" data-paralaje>
  {/* La primera foto es la única con prioridad: es la que se pinta al entrar y
      la que mide la carga. Las demás se piden con prioridad baja para no
      competir con ella. Sin JavaScript se queda la primera, quieta, en el móvil;
      en el ordenador, la fila quieta. */}
  {/* El último ancho es 1600 y no 1440, que es lo que miden casi todas: Vercel
      solo sirve los anchos de `imagesConfig` y descarta el resto en silencio
      —con 1440 el srcset se quedaba en 1200—, y pedir 1600 de una foto de 1440
      devuelve la foto entera, sin agrandarla. */}
  {/* La serie entera es la capa lejana del paralaje (2026-10-28, «paralaje en
      segundo plano»): al bajar va más lenta que la página. */}
  <div class="pase" data-pase data-vel="-0.25" data-tope="60">
    <div class="pista" data-pista>
      {portada.map((foto, i) => (
        <Image
          src={foto.src}
          alt={foto.alt[locale]}
          widths={[390, 640, 960, 1200, 1600]}
          sizes={`(max-width: 860px) 100vw, ${enTira(foto)}`}
          quality={72}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          class:list={["shot", { on: i === 0 }]}
          style={estilo(foto)}
          data-solo-ordenador={foto.soloOrdenador ? "" : undefined}
        />
      ))}
    </div>
  </div>
  <div class="veil"></div>
  <div class="wrap copy">
    <h1 class="cartel" data-relieve="0.075">{es ? "La tasca que te mereces" : "The tavern you deserve"}</h1>
    <div class="pie">
      <OpenState hours={RESTAURANT.openingHours} locale={locale} />
      {/* Por qué foto va el telón del móvil. Es un indicador, no un mando, como los
          turnos de «Lo que más sale»: los puntos medían 10 px, muy por debajo de
          un dedo, y la portada no se recorre — se mira. En la tira del ordenador
          no hay «una foto en curso», y no sale. */}
      <div class="pager" aria-hidden="true" data-pager>
        {enMovil.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}
      </div>
    </div>
  </div>
  {/* La referencia del alto: lleva el mismo `calc()` que la portada pero sin
      congelar, fuera del flujo e invisible. El script observa ESTE elemento y
      no la portada, y así lee lo que da el cálculo sin quitar y volver a poner
      la variable. El porqué entero está en `@tombo/ui/alto-congelado.ts`. */}
  <div class="alto-ref" aria-hidden="true"></div>
</header>

<script>
  /* La portada congela su alto en píxeles y no lo dimensiona desde el viewport
   * (regla 16 de `docs/movimiento.md`). Cómo se congela, y la trampa del
   * 2026-09-07 —recargar con la barra del navegador retraída dejaba la portada
   * 94px más alta para toda la sesión—, en `@tombo/ui/alto-congelado.ts`.
   *
   * Si el script no llega a correr, el `calc()` del CSS sigue mandando y la
   * portada mide exactamente lo mismo: esto no añade una medida, congela la que
   * ya había.
   */
  import { congelaAlto } from "@tombo/ui/alto-congelado.ts";
  import { hastaElProximo, leeDuracion, leeNumero } from "../compas.ts";
  import { montaParalaje } from "../paralaje.ts";

  const ORDENADOR = matchMedia("(min-width: 861px)");
  const QUIETO = "(prefers-reduced-motion: reduce)";

  let sueltaAnterior: (() => void) | undefined;
  let sueltaPortada: (() => void) | null = null;
  let sueltaParalaje: (() => void) | null = null;
  let origen = 0;

  /* EL TELÓN, en el móvil. La ronda avanza sola cada `--dur-pase` y, como todo lo
   * que se mueve solo (regla 6 de `docs/movimiento.md`), se para para siempre al
   * primer toque, no corre fuera de pantalla ni con la pestaña en segundo plano,
   * y no arranca si se pide menos movimiento. Cuándo toca cada cambio no lo
   * cuenta ella: lo pregunta a `compas.ts`, que la mantiene a destiempo del mazo
   * de «Lo que más sale». */
  function montaTelon() {
    const hero = document.querySelector<HTMLElement>(".hero");
    const fotos = [...document.querySelectorAll<HTMLElement>(".hero [data-pista] > img:not([data-solo-ordenador])")];
    const puntos = [...document.querySelectorAll<HTMLElement>(".hero [data-pager] > span")];
    if (!hero || fotos.length < 2) return null;

    const abort = new AbortController();
    const { signal } = abort;
    let actual = Math.max(0, fotos.findIndex((f) => f.classList.contains("on")));
    let reloj: ReturnType<typeof setTimeout> | null = null;
    let parado = matchMedia(QUIETO).matches;

    /* La que llega se pone encima y se descubre; la que se va se queda debajo,
       entera, hasta que la tapa. Las demás, recogidas. */
    const pasa = () => {
      /* Si la siguiente no ha llegado todavía —en una conexión lenta—, el telón
         descubriría un hueco. Se espera al próximo turno en vez de enseñarlo. */
      const viene = fotos[(actual + 1) % fotos.length] as HTMLImageElement;
      if (!viene.complete || viene.naturalWidth === 0) return;
      const anterior = actual;
      actual = (actual + 1) % fotos.length;
      fotos.forEach((f) => f.classList.remove("on", "fondo"));
      fotos[anterior].classList.add("fondo");
      void fotos[actual].offsetWidth;
      fotos[actual].classList.add("on");
      puntos.forEach((p, i) => p.classList.toggle("on", i === actual));
    };

    const pausa = () => {
      if (reloj) clearTimeout(reloj);
      reloj = null;
    };
    const arranca = () => {
      if (parado || reloj) return;
      const periodo = leeDuracion("--dur-pase");
      reloj = setTimeout(() => {
        reloj = null;
        pasa();
        arranca();
      }, hastaElProximo(origen, periodo, periodo));
    };
    const para = () => {
      parado = true;
      pausa();
    };

    for (const ev of ["pointerdown", "touchstart"]) {
      hero.addEventListener(ev, para, { passive: true, once: true, signal });
    }
    let enVista = false;
    const decide = () => (enVista && !document.hidden ? arranca() : pausa());
    const ojo = new IntersectionObserver(
      ([e]) => {
        /* La proporción y no `isIntersecting`: esa es cierta en cuanto asoma un
           borde, y la primera llamada llega siempre, cruce o no el umbral. */
        enVista = e.intersectionRatio >= 0.5;
        decide();
      },
      { threshold: 0.5 },
    );
    ojo.observe(hero);
    document.addEventListener("visibilitychange", decide, { signal });

    return () => {
      pausa();
      ojo.disconnect();
      abort.abort();
    };
  }

  /* LA TIRA, en el ordenador. Las ocho fotos en fila, cada una entera al alto de
   * la capa del paralaje y con su proporción —eso lo hace el CSS: la anchura sale
   * del alto y del `width`/`height` de cada foto—, y la serie dos veces seguida
   * para que la vuelta no se note: al recorrer exactamente una serie, la copia
   * está donde estaba la primera. Avanza de derecha a izquierda a `--vel-tira`
   * píxeles por segundo, lineal y sin parar: una velocidad que cambia se lee como
   * un fallo, como en la cinta rotulada.
   * La misma doctrina de todo lo que se mueve solo: se para para siempre al
   * primer toque en la portada, se pausa con menos de media portada a la vista o
   * con la pestaña oculta, y con «reducir movimiento» se queda quieta (y sin
   * copia: no hace falta). La copia la pone este script, así que sin él queda la
   * fila quieta. */
  function montaTira() {
    const hero = document.querySelector<HTMLElement>(".hero");
    const pista = hero?.querySelector<HTMLElement>("[data-pista]");
    const fotos = pista ? [...pista.querySelectorAll<HTMLImageElement>(":scope > img")] : [];
    if (!hero || !pista || !fotos.length) return null;
    /* Se piden todas ya, con su prioridad baja: la tira las va a enseñar, y una
       foto perezosa no se pediría hasta asomar por el borde, en hueco. */
    fotos.forEach((f) => (f.loading = "eager"));
    if (matchMedia(QUIETO).matches) return null;

    const copias = fotos.map((f) => {
      const c = f.cloneNode() as HTMLImageElement;
      c.alt = "";
      c.setAttribute("aria-hidden", "true");
      c.removeAttribute("fetchpriority");
      c.classList.remove("on", "fondo");
      pista.append(c);
      return c;
    });
    const abort = new AbortController();
    const { signal } = abort;
    const vel = leeNumero("--vel-tira");
    let anim: Animation | null = null;
    let tramo = 0;
    let parado = false;
    let enVista = false;

    /* Lo que hay que recorrer para que la copia ocupe el sitio de la primera: la
       serie entera con sus juntas, medida en la página y no calculada. */
    const arma = () => {
      const nuevo = copias[0].offsetLeft - fotos[0].offsetLeft;
      if (nuevo <= 0 || Math.abs(nuevo - tramo) < 1) return;
      const progreso = anim ? (Number(anim.currentTime ?? 0) % ((tramo / vel) * 1000)) / ((tramo / vel) * 1000) : 0;
      anim?.cancel();
      tramo = nuevo;
      const duracion = (tramo / vel) * 1000;
      anim = pista.animate([{ transform: "translateX(0)" }, { transform: `translateX(${-tramo}px)` }], {
        duration: duracion,
        iterations: Infinity,
        easing: "linear",
      });
      anim.currentTime = progreso * duracion;
      decide();
    };
    const decide = () => {
      if (!anim) return;
      if (!parado && enVista && !document.hidden) anim.play();
      else anim.pause();
    };
    for (const ev of ["pointerdown", "touchstart"]) {
      hero.addEventListener(
        ev,
        () => {
          parado = true;
          decide();
        },
        { passive: true, once: true, signal },
      );
    }
    const ojo = new IntersectionObserver(
      ([e]) => {
        enVista = e.intersectionRatio >= 0.5;
        decide();
      },
      { threshold: 0.5 },
    );
    ojo.observe(hero);
    document.addEventListener("visibilitychange", decide, { signal });
    /* La tira mide sus fotos por el alto de la portada: si cambia, cambia lo que
       hay que recorrer, y se rehace sin perder por dónde iba. */
    const ojoTam = new ResizeObserver(() => arma());
    ojoTam.observe(pista);
    arma();

    return () => {
      anim?.cancel();
      ojo.disconnect();
      ojoTam.disconnect();
      abort.abort();
      copias.forEach((c) => c.remove());
    };
  }

  const montaPortada = () => {
    sueltaPortada?.();
    sueltaPortada = ORDENADOR.matches ? montaTira() : montaTelon();
  };
  /* Al cruzar los 861 px se cambia de una a otra. */
  ORDENADOR.addEventListener("change", montaPortada);

  document.addEventListener("astro:page-load", (e) => {
    sueltaAnterior?.();
    const referencia = document.querySelector<HTMLElement>(".hero .alto-ref");
    sueltaAnterior = referencia ? congelaAlto({ referencia, variable: "--alto-portada" }) : undefined;
    origen = e.timeStamp;
    montaPortada();
    /* El paralaje vive aquí porque la portada es su primera capa y está en las
       dos portadas; recoge también las fotos de fondo de las secciones. */
    sueltaParalaje?.();
    sueltaParalaje = montaParalaje();
  });
</script>

<style>
  .hero {
    position: relative;
    /* svh y no vh: en móvil, vh cuenta con la barra del navegador retraída y la
       portada se corta por abajo. */
    /* En el ordenador, además de la cabecera se resta una franja de asomo: sin
       ella la portada llena la pantalla al píxel y la tira de platos queda
       invisible hasta que alguien decide bajar. En el móvil, desde el
       2026-10-29, no: Mario la quiere a pantalla completa bajo la cabecera, y
       ahí la regla es la de abajo. */
    /* El cálculo se escribe una vez, aquí, y lo leen dos: la portada como
       respaldo y valor del primer pintado, y `.alto-ref` como referencia viva.
       En cuanto el script mide, manda `--alto-portada`, que es ese mismo número
       congelado en píxeles. El motivo está en el script. */
    --alto-calculado: calc(100svh - var(--t-header-h, 62px) - clamp(128px, 18vw, 156px));
    height: var(--alto-portada, var(--alto-calculado));
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (max-width: 860px) {
    .hero {
      --alto-calculado: calc(100svh - var(--t-header-h, 62px));
    }
  }
  /* Fuera del flujo y sin caja visible: no empuja nada ni se ve, solo mide. */
  .alto-ref {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: var(--alto-calculado);
    visibility: hidden;
    pointer-events: none;
  }
  /* Su propio contexto de apilamiento: los `z-index` de las fotos ordenan la
     ronda entre ellas y no pueden subir por encima del velo ni del titular. */
  /* Sobresale un 8% por arriba y por abajo: es el recorrido del paralaje, que
     la desplaza como mucho 60 px y nunca deja ver el fondo. La tinta de debajo
     es también la de las juntas de la tira. */
  .pase {
    position: absolute;
    inset: -8% 0;
    isolation: isolate;
    background: var(--ink);
  }
  .pista {
    position: absolute;
    inset: 0;
  }

  /* ---- El telón, en el móvil ---- */
  /* Recogidas a la derecha mientras esperan su turno. Las capas van por
     `z-index` y no por el orden del HTML: al dar la vuelta, la primera foto
     entraba por debajo de la última y el telón no se veía. */
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 0 100%);
  }
  /* Cruza la pantalla entera, así que va con la curva del telón del menú y la
     duración de la recogida, que miden lo mismo (regla 9). */
  .shot.on {
    z-index: 2;
    clip-path: inset(0);
    transition: clip-path var(--dur-recogida) var(--ease-telon);
  }
  .shot.fondo {
    z-index: 1;
    clip-path: inset(0);
  }
  /* En el móvil la foto llena el alto y se recorta por los lados: cada una va a
     lo que cuenta (`--encuadre`), y alguna se acerca un poco hacia ahí
     (`--acerca`). `scale` es una transformación y convive con el `clip-path`
     del telón. El rótulo del cristal no sale: en vertical se leía «S OCHO». */
  @media (max-width: 860px) {
    .shot {
      object-position: var(--encuadre, 50% 50%);
      scale: var(--acerca, 1);
      transform-origin: var(--encuadre, 50% 50%);
    }
    .shot[data-solo-ordenador] {
      display: none;
    }
  }

  /* ---- La tira, en el ordenador ---- */
  /* En fila, con juntas de 3 px de tinta. Cada foto mide el alto de la capa y su
     ancho sale de su proporción, así que se ve entera: no hay recorte por los
     lados y el encuadre del móvil no cuenta. */
  @media (min-width: 861px) {
    .pista {
      inset: 0 auto 0 0;
      display: flex;
      gap: 3px;
      will-change: transform;
    }
    .pista > :global(img) {
      position: static;
      flex: none;
      width: auto;
      height: 100%;
      max-width: none;
      clip-path: none;
      transition: none;
      user-select: none;
    }
  }

  /* La portada es una sola pieza a sangre en todos los anchos, y el titular se
     apoya en la foto con su sombra roja. Hubo un intento de partirla en dos en
     móvil —foto arriba, titular sobre una banda roja— para que cupiera entero el
     rótulo del cristal; se retiró con esa foto: la banda roja competía con la
     imagen y la sombra del titular tenía que cambiar de color para verse, que era
     perder justo lo que mejor funcionaba. */
  /* Degradado solo bajo el texto, no una capa uniforme sobre toda la foto:
     apagar la imagen entera es justo lo que hacen las cinco webs que nos
     pusieron de referencia, y es lo que las vuelve intercambiables. */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, 0.92) 0%,
      rgba(26, 26, 26, 0.66) 28%,
      rgba(26, 26, 26, 0) 62%
    );
  }
  /* El cartel de cookies vive en esta misma esquina durante la primera visita.
     `--t-consent-h` lo publica el propio cartel y vuelve a 0 al decidir, así
     que el titular se aparta mientras hace falta y no un píxel más. */
  /* El apartarse es un `transform` y no el `padding` que crecía: mover el
     relleno obliga al navegador a recalcular la disposición en cada fotograma,
     y el resultado en pantalla es idéntico porque el bloque ya está anclado
     abajo y el alto de la portada no depende de él. */
  .copy {
    position: relative;
    padding-bottom: clamp(26px, 5vw, 54px);
    width: 100%;
    transform: translateY(calc(-1 * var(--t-consent-h, 0px)));
    transition: transform var(--dur-out) var(--ease);
    /* Aquí abajo la foto está oscurecida por el degradado, así que la tinta de la
       marca no se lee: el estado de apertura salía en gris oscuro sobre fondo
       oscuro. En vez de parchearlo desde fuera se le reescriben los tokens que
       consume, y cualquier pieza neutra que caiga sobre la portada se adapta. */
    --t-text: var(--paper);
    --t-text-dim: rgba(255, 255, 255, 0.9);
    --t-text-faint: rgba(255, 255, 255, 0.65);
  }
  .hero h1 {
    /* 11.5vw y no 10vw: por debajo de 416px de ancho, 10vw cae bajo el mínimo
       de 2.6rem y el cartel se queda congelado en 41.6px justo en el formato
       que más se usa —a 390px daba 39px y ganaba siempre el suelo del clamp—.
       Con 11.5vw el titular vuelve a escalar con la pantalla desde 362px, y el
       suelo sigue protegiendo a las pantallas por debajo de eso. */
    font-size: clamp(2.6rem, 11.5vw, 6rem);
    line-height: 0.94;
    margin: 0 0 14px;
    max-width: 14ch;
    /* Sobre la foto, el cartel invierte su fórmula: la tinta pasa a ser el
       papel y la sombra dura la pone el rojo de la marca. Con ratón, la sombra
       cae al lado contrario del cursor (El relieve, `relieve.ts`).
       Va aquí, en la regla del componente, y no en una hoja de fuera: en el
       probador se puso fuera y no se movía, porque esta regla, con su atributo
       de ámbito, pesaba más. */
    color: var(--paper);
    text-shadow: var(--relieve-x, 0.04em) var(--relieve-y, 0.045em) 0 var(--rojo);
  }
  /* El estado de apertura a la izquierda y la ronda a la derecha, en la misma
     línea: así los puntos no tapan foto que no tape ya el texto. */
  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* El punto de la foto en curso se estira a barra, como los turnos de «Lo que
     más sale». */
  .pager span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    transition: width var(--dur-in) var(--ease);
  }
  .pager span.on {
    width: 26px;
    background: var(--paper);
  }
  /* En la tira no hay una foto en curso que señalar. Va al final porque pesa lo
     mismo que la regla de arriba, y en un empate gana la última. */
  @media (min-width: 861px) {
    .pager {
      display: none;
    }
  }
</style>
