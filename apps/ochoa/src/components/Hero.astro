---
// apps/ochoa/src/components/Hero.astro
import { Image } from "astro:assets";
import OpenState from "@tombo/ui/OpenState.astro";
import { RESTAURANT } from "../site.ts";
// La portada son seis fotos de la casa con gente, que se relevan con un telón:
// la nueva entra de derecha a izquierda sobre la anterior. Antes fue una sola
// foto —el cenital de la mesa, que recortado a pantalla vertical se quedaba en un
// fragmento de plato; el rótulo del cristal, demasiado plano de cerca; y la
// fachada—. Mario la cambió el 2026-10-26: no hace falta la foto del local, sino
// enseñar la casa viva. Eligió el telón entre cinco bocetos (collage, rejilla,
// escaparate, ronda con fundido y telón) porque tiene carácter de tasca. La serie
// y el porqué de cada foto, en `../data/portada.ts`.
//
// RAMA DE PRUEBA `feat/inicio-paralaje` (2026-10-28): Mario pidió verla a
// pantalla completa, ligeramente oscurecida y con un fundido suave entre fotos,
// «ningún efecto demasiado fancy». Es la ronda con fundido que se descartó el
// 2026-10-26 frente al telón, ahora con la portada entera y un velo parejo; se
// prueba aquí para decidir viéndola en el móvil.
import { portada } from "../data/portada.ts";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";
// Lo que se viene a hacer a esta web es mirar la carta y reservar (Mario,
// 2026-10-28: «manteniendo como prioridad tanto la carta como la reserva»), así
// que la portada lleva los dos a mano. Los textos son los que ya usa la web.
const t = es
  ? { reservar: "Reservar", carta: "Ver la carta", reservarHref: "/reservas", cartaHref: "/carta" }
  : { reservar: "Book", carta: "Full menu", reservarHref: "/en/reservations", cartaHref: "/en/menu" };
// En el ordenador, la portada no es la serie a pantalla completa: a 1440×682 las
// fotos verticales se quedaban en una franja y se cortaban demasiado. Es un
// collage de tres, cada una con su proporción entera —el cocinero 3:4, las otras
// dos cuadradas—, así que no se recorta ninguna.
const collage = [portada[0], portada[1], portada[2]];
---

<header class="hero" id="top" data-paralaje>
  {/* La primera foto es la única con prioridad: es la que se pinta al entrar y
      la que mide la carga. Las demás entran en la ronda a los 3,5 s como pronto
      y se piden con prioridad baja para no competir con ella. Sin JavaScript se
      queda la primera, quieta, que es una portada completa. */}
  {/* El último ancho es 1600 y no 1440, que es lo que miden las fotos: Vercel
      solo sirve los anchos de `imagesConfig` y descarta el resto en silencio
      —con 1440 el srcset se quedaba en 1200—, y pedir 1600 de una foto de 1440
      devuelve la foto entera, sin agrandarla. */}
  {/* La serie entera es la capa lejana: al bajar va más lenta que la página. */}
  <div class="pase" data-pase data-vel="-0.3">
    {portada.map((foto, i) => (
      <Image
        src={foto.src}
        alt={foto.alt[locale]}
        widths={[390, 640, 960, 1200, 1600]}
        sizes="100vw"
        quality={72}
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : "low"}
        class:list={["shot", { on: i === 0 }]}
        style={foto.position ? `object-position: ${foto.position}` : undefined}
      />
    ))}
  </div>
  <div class="veil"></div>
  <div class="wrap copy">
    <div class="texto">
    <h1 class="cartel">{es ? "La tasca que te mereces" : "The tavern you deserve"}</h1>
    <p class="acciones">
      <a href={t.reservarHref} class="btn">{t.reservar}</a>
      <a href={t.cartaHref} class="btn ghost">{t.carta}</a>
    </p>
    <div class="pie">
      <OpenState hours={RESTAURANT.openingHours} locale={locale} />
      {/* Por qué foto va la ronda. Es un indicador, no un mando, como los turnos
          de «Lo que más sale»: los puntos medían 10 px, muy por debajo de un dedo,
          y la portada no se recorre — se mira. */}
      <div class="pager" aria-hidden="true" data-pager>
        {portada.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}
      </div>
    </div>
    </div>
    {/* Solo en el ordenador. Responde al cursor: cada foto se desplaza unos
        píxeles en contra, más cuanto más cerca está, y vuelve al salir. */}
    <div class="collage" data-collage>
      {collage.map((foto, i) => (
        <Image
          src={foto.src}
          alt={foto.alt[locale]}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 861px) 34vw, 1px"
          quality={72}
          loading="lazy"
          class:list={["pieza", `p${i}`]}
          data-hondo={[5, 9, 13][i]}
        />
      ))}
    </div>
  </div>
  {/* La referencia del alto: lleva el mismo `calc()` que la portada pero sin
      congelar, fuera del flujo e invisible. El script observa ESTE elemento y
      no la portada, y así lee lo que da el cálculo sin quitar y volver a poner
      la variable. El porqué entero está en `@tombo/ui/alto-congelado.ts`. */}
  <div class="alto-ref" aria-hidden="true"></div>
</header>

<script>
  /* La portada congela su alto en píxeles y no lo dimensiona desde el viewport
   * (regla 16 de `docs/movimiento.md`). Cómo se congela, y la trampa del
   * 2026-09-07 —recargar con la barra del navegador retraída dejaba la portada
   * 94px más alta para toda la sesión—, en `@tombo/ui/alto-congelado.ts`.
   *
   * Si el script no llega a correr, el `calc()` del CSS sigue mandando y la
   * portada mide exactamente lo mismo: esto no añade una medida, congela la que
   * ya había.
   */
  import { congelaAlto } from "@tombo/ui/alto-congelado.ts";
  import { hastaElProximo, leeDuracion } from "../compas.ts";
  import { montaParalaje } from "../paralaje.ts";

  let sueltaAnterior: (() => void) | undefined;
  let sueltaTelon: (() => void) | null = null;
  let sueltaParalaje: (() => void) | null = null;

  /* El telón. La ronda avanza sola cada `--dur-pase` y, como todo lo que se
   * mueve solo (regla 6 de `docs/movimiento.md`), se para para siempre al primer
   * toque, no corre fuera de pantalla ni con la pestaña en segundo plano, y no
   * arranca si se pide menos movimiento. Cuándo toca cada cambio no lo cuenta
   * ella: lo pregunta a `compas.ts`, que la mantiene a destiempo del mazo de
   * «Lo que más sale». */
  function montaTelon(origen: number) {
    const hero = document.querySelector<HTMLElement>(".hero");
    const fotos = [...document.querySelectorAll<HTMLElement>(".hero [data-pase] > img")];
    const puntos = [...document.querySelectorAll<HTMLElement>(".hero [data-pager] > span")];
    if (!hero || fotos.length < 2) return null;

    const abort = new AbortController();
    const { signal } = abort;
    let actual = 0;
    let reloj: ReturnType<typeof setTimeout> | null = null;
    let parado = matchMedia("(prefers-reduced-motion: reduce)").matches;
    /* En el ordenador la serie no se ve —manda el collage—, así que no corre. */
    const escritorio = matchMedia("(min-width: 861px)");

    /* La que llega se pone encima y se descubre; la que se va se queda debajo,
       entera, hasta que la tapa. Las demás, recogidas. */
    const pasa = () => {
      /* Si la siguiente no ha llegado todavía —en una conexión lenta—, el telón
         descubriría un hueco. Se espera al próximo turno en vez de enseñarlo. */
      const viene = fotos[(actual + 1) % fotos.length] as HTMLImageElement;
      if (!viene.complete || viene.naturalWidth === 0) return;
      const anterior = actual;
      actual = (actual + 1) % fotos.length;
      fotos.forEach((f) => f.classList.remove("on", "fondo"));
      fotos[anterior].classList.add("fondo");
      void fotos[actual].offsetWidth;
      fotos[actual].classList.add("on");
      puntos.forEach((p, i) => p.classList.toggle("on", i === actual));
    };

    const pausa = () => {
      if (reloj) clearTimeout(reloj);
      reloj = null;
    };
    const arranca = () => {
      if (parado || reloj) return;
      const periodo = leeDuracion("--dur-pase");
      reloj = setTimeout(() => {
        reloj = null;
        pasa();
        arranca();
      }, hastaElProximo(origen, periodo, periodo));
    };
    const para = () => {
      parado = true;
      pausa();
    };

    for (const ev of ["pointerdown", "touchstart"]) {
      hero.addEventListener(ev, para, { passive: true, once: true, signal });
    }
    let enVista = false;
    const decide = () => (enVista && !document.hidden && !escritorio.matches ? arranca() : pausa());
    const ojo = new IntersectionObserver(
      ([e]) => {
        /* La proporción y no `isIntersecting`: esa es cierta en cuanto asoma un
           borde, y la primera llamada llega siempre, cruce o no el umbral. */
        enVista = e.intersectionRatio >= 0.5;
        decide();
      },
      { threshold: 0.5 },
    );
    ojo.observe(hero);
    document.addEventListener("visibilitychange", decide, { signal });
    escritorio.addEventListener("change", decide, { signal });

    return () => {
      pausa();
      ojo.disconnect();
      abort.abort();
    };
  }

  /* El collage del ordenador sigue al cursor, poco y sin prisa: cada foto se
   * desplaza en contra hasta `data-hondo` píxeles según dónde esté el cursor
   * dentro de la portada, y vuelve a su sitio al salir. Solo con un ratón de
   * verdad —en una pantalla táctil no hay cursor que seguir— y nada si se pide
   * menos movimiento. El suavizado no lo hace el script: lo hace la transición
   * del CSS, que se reorienta sola con cada movimiento. */
  function montaCollage() {
    const hero = document.querySelector<HTMLElement>(".hero");
    const piezas = [...document.querySelectorAll<HTMLElement>(".hero [data-collage] > img")];
    if (!hero || !piezas.length) return null;
    if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return null;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return null;

    const abort = new AbortController();
    let pendiente = 0;
    let nx = 0;
    let ny = 0;
    const pinta = () => {
      pendiente = 0;
      for (const p of piezas) {
        const h = parseFloat(p.dataset.hondo ?? "0");
        p.style.transform = `translate3d(${(-nx * h).toFixed(1)}px, ${(-ny * h).toFixed(1)}px, 0)`;
      }
    };
    const pide = () => {
      if (!pendiente) pendiente = requestAnimationFrame(pinta);
    };
    hero.addEventListener(
      "pointermove",
      (e) => {
        const r = hero.getBoundingClientRect();
        nx = ((e.clientX - r.left) / r.width) * 2 - 1;
        ny = ((e.clientY - r.top) / r.height) * 2 - 1;
        pide();
      },
      { signal: abort.signal },
    );
    hero.addEventListener(
      "pointerleave",
      () => {
        nx = 0;
        ny = 0;
        pide();
      },
      { signal: abort.signal },
    );
    return () => {
      abort.abort();
      if (pendiente) cancelAnimationFrame(pendiente);
    };
  }
  let sueltaCollage: (() => void) | null = null;

  document.addEventListener("astro:page-load", (e) => {
    sueltaAnterior?.();
    const referencia = document.querySelector<HTMLElement>(".hero .alto-ref");
    sueltaAnterior = referencia ? congelaAlto({ referencia, variable: "--alto-portada" }) : undefined;
    sueltaTelon?.();
    sueltaTelon = montaTelon(e.timeStamp);
    /* El paralaje vive aquí porque la portada es su capa lejana y está en las
       dos portadas, la española y la inglesa; recoge también los platos de las
       secciones de abajo. */
    sueltaParalaje?.();
    sueltaParalaje = montaParalaje();
    sueltaCollage?.();
    sueltaCollage = montaCollage();
  });
</script>

<style>
  .hero {
    position: relative;
    /* svh y no vh: en móvil, vh cuenta con la barra del navegador retraída y la
       portada se corta por abajo justo donde queremos que asome el primer
       plato. Además de la cabecera se resta una franja de asomo: sin ella la
       portada llena la pantalla al píxel y la tira de platos queda invisible
       hasta que alguien decide bajar. Que asome es el punto entero. */
    /* El cálculo se escribe una vez, aquí, y lo leen dos: la portada como
       respaldo y valor del primer pintado, y `.alto-ref` como referencia viva.
       En cuanto el script mide, manda `--alto-portada`, que es ese mismo número
       congelado en píxeles. El motivo está en el script. */
    /* En la rama de prueba, la pantalla entera bajo la cabecera: Mario la quiere
       al 100% aunque eso apague el asomo de la primera ficha. */
    --alto-calculado: calc(100svh - var(--t-header-h, 62px));
    height: var(--alto-portada, var(--alto-calculado));
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  /* Fuera del flujo y sin caja visible: no empuja nada ni se ve, solo mide. */
  .alto-ref {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: var(--alto-calculado);
    visibility: hidden;
    pointer-events: none;
  }
  /* Su propio contexto de apilamiento: los `z-index` de las fotos ordenan la
     ronda entre ellas y no pueden subir por encima del velo ni del titular. */
  /* Sobresale un 8% por arriba y por abajo: es el recorrido del paralaje, que
     la desplaza como mucho 70px y nunca deja ver el fondo. */
  .pase {
    position: absolute;
    inset: -8% 0;
    isolation: isolate;
    background: var(--ink);
  }
  /* Transparentes mientras esperan su turno. Las capas van por `z-index` y no
     por el orden del HTML: al dar la vuelta, la primera foto entraba por debajo
     de la última. */
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  /* La que llega se funde encima de la anterior, que sigue entera debajo hasta
     quedar tapada: así no hay un instante a medias en que se vea el fondo
     oscuro. Va con la curva del telón porque ocupa la pantalla entera (regla 9). */
  .shot.on {
    z-index: 2;
    opacity: 1;
    transition: opacity var(--dur-fundido) var(--ease-telon);
  }
  .shot.fondo {
    z-index: 1;
    opacity: 1;
  }

  /* La portada es una sola pieza a sangre en todos los anchos, y el titular se
     apoya en la foto con su sombra roja. Hubo un intento de partirla en dos en
     móvil —foto arriba, titular sobre una banda roja— para que cupiera entero el
     rótulo del cristal; se retiró con esa foto: la banda roja competía con la
     imagen y la sombra del titular tenía que cambiar de color para verse, que era
     perder justo lo que mejor funcionaba. */
  /* Degradado solo bajo el texto, no una capa uniforme sobre toda la foto:
     apagar la imagen entera es justo lo que hacen las cinco webs que nos
     pusieron de referencia, y es lo que las vuelve intercambiables. */
  /* En la rama de prueba sí hay un velo parejo, ligero, porque Mario pidió la
     portada «ligeramente oscurecida»; el degradado de abajo sigue sosteniendo
     el titular. */
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(26, 26, 26, 0.85) 0%,
        rgba(26, 26, 26, 0.5) 28%,
        rgba(26, 26, 26, 0) 62%
      ),
      rgba(26, 26, 26, 0.28);
  }
  /* El cartel de cookies vive en esta misma esquina durante la primera visita.
     `--t-consent-h` lo publica el propio cartel y vuelve a 0 al decidir, así
     que el titular se aparta mientras hace falta y no un píxel más. */
  /* El apartarse es un `transform` y no el `padding` que crecía: mover el
     relleno obliga al navegador a recalcular la disposición en cada fotograma,
     y el resultado en pantalla es idéntico porque el bloque ya está anclado
     abajo y el alto de la portada no depende de él. */
  .copy {
    position: relative;
    padding-bottom: clamp(26px, 5vw, 54px);
    width: 100%;
    transform: translateY(calc(-1 * var(--t-consent-h, 0px)));
    transition: transform var(--dur-out) var(--ease);
    /* Aquí abajo la foto está oscurecida por el degradado, así que la tinta de la
       marca no se lee: el estado de apertura salía en gris oscuro sobre fondo
       oscuro. En vez de parchearlo desde fuera se le reescriben los tokens que
       consume, y cualquier pieza neutra que caiga sobre la portada se adapta. */
    --t-text: var(--paper);
    --t-text-dim: rgba(255, 255, 255, 0.9);
    --t-text-faint: rgba(255, 255, 255, 0.65);
  }
  .hero h1 {
    /* 11.5vw y no 10vw: por debajo de 416px de ancho, 10vw cae bajo el mínimo
       de 2.6rem y el cartel se queda congelado en 41.6px justo en el formato
       que más se usa —a 390px daba 39px y ganaba siempre el suelo del clamp—.
       Con 11.5vw el titular vuelve a escalar con la pantalla desde 362px, y el
       suelo sigue protegiendo a las pantallas por debajo de eso. */
    font-size: clamp(2.6rem, 11.5vw, 6rem);
    line-height: 0.94;
    margin: 0 0 14px;
    max-width: 14ch;
    /* Sobre la foto, el cartel invierte su fórmula: la tinta pasa a ser el
       papel y la sombra dura la pone el rojo de la marca. */
    color: var(--paper);
    text-shadow: 0.04em 0.045em 0 var(--rojo);
  }
  /* Reservar y la carta, lo primero que se viene a hacer. Sobre la foto, el
     botón en hueco pasa a blanco para leerse. */
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 18px;
  }
  .hero .acciones .btn.ghost {
    color: var(--paper);
    border-color: var(--paper);
    box-shadow: 3px 3px 0 var(--paper);
  }
  .collage {
    display: none;
  }

  /* El ordenador: papel, el titular a la izquierda con los dos botones y el
     collage a la derecha. Ni velo ni serie ni puntos, que son de la foto a
     sangre del móvil. El alto sigue siendo el de la pantalla bajo la cabecera,
     congelado como en el móvil (regla 16). */
  @media (min-width: 861px) {
    .hero {
      align-items: center;
      background: var(--paper);
      /* El alto del collage: lo que deja la portada menos su relleno, sin
         pasar de 600 px ni comerse más de lo que cabe a lo ancho. */
      --hueco: clamp(28px, 4vw, 56px);
      --alto-collage: min(calc(var(--alto-portada, var(--alto-calculado)) - 2 * var(--hueco)), 44vw, 600px);
      --junta: clamp(14px, 1.4vw, 22px);
    }
    .pase,
    .veil,
    .pager {
      display: none;
    }
    .copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(28px, 4vw, 64px);
      padding-block: var(--hueco);
      --t-text: var(--ink);
      --t-text-dim: var(--ink-dim);
      --t-text-faint: var(--ink-faint);
    }
    /* Al lado del collage el titular tiene media pantalla, no la entera: con el
       11,5vw del móvil, a 900 px la S de «mereces» se metía bajo las fotos. */
    .hero h1 {
      color: var(--ink);
      font-size: clamp(2.6rem, 6vw, 5.4rem);
    }
    .hero .acciones .btn.ghost {
      color: var(--ink);
      border-color: var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
    }
    /* El cocinero entero a la izquierda y las dos cuadradas apiladas a su
       derecha: cada una con su proporción, así que ninguna se recorta. */
    .collage {
      display: grid;
      grid-template-columns: auto auto;
      gap: var(--junta);
      align-items: center;
    }
    .pieza {
      display: block;
      width: auto;
      object-fit: cover;
      border: 2px solid var(--ink);
      border-radius: var(--r-marco);
      transition: transform var(--dur-in) var(--ease);
      will-change: transform;
    }
    .p0 {
      grid-row: 1 / 3;
      height: var(--alto-collage);
      aspect-ratio: 3 / 4;
      box-shadow: -8px 8px 0 rgba(198, 34, 43, 0.9);
    }
    .p1,
    .p2 {
      height: calc((var(--alto-collage) - var(--junta)) / 2);
      aspect-ratio: 1;
    }
    .p2 {
      box-shadow: 8px 8px 0 rgba(198, 34, 43, 0.9);
    }
  }

  /* El estado de apertura a la izquierda y la ronda a la derecha, en la misma
     línea: así los puntos no tapan foto que no tape ya el texto. */
  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* El punto de la foto en curso se estira a barra, como los turnos de «Lo que
     más sale». */
  .pager span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    transition: width var(--dur-in) var(--ease);
  }
  .pager span.on {
    width: 26px;
    background: var(--paper);
  }
</style>
