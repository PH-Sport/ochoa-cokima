---
// apps/ochoa/src/components/Hero.astro
import { Image } from "astro:assets";
import OpenState from "@tombo/ui/OpenState.astro";
import { RESTAURANT } from "../site.ts";
// La portada es el rótulo en el cristal, no el cenital de la mesa: recortado a
// pantalla vertical, aquel se quedaba en un fragmento de plato sin contexto, y
// este dice el nombre de la casa y de dónde sale todo lo demás —las letras
// rojas con sombra, el «MADRIZ», el vermú. El cenital se mudó a «la tasca», que
// es apaisada y le sienta.
import hero from "../assets/tasca.jpg";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";
---

<header class="hero" id="top">
  <Image
    src={hero}
    alt={es
      ? "Rótulo de Tasquita Los Ochoa pintado en el cristal del local, con la terraza al otro lado"
      : "Tasquita Los Ochoa sign painted on the window, with the terrace on the other side"}
    widths={[390, 640, 960, 1200]}
    sizes="100vw"
    quality={72}
    loading="eager"
    fetchpriority="high"
    class="shot"
  />
  <div class="veil"></div>
  <div class="wrap copy">
    <h1 class="cartel">{es ? "La tasca que te mereces" : "The tavern you deserve"}</h1>
    <OpenState hours={RESTAURANT.openingHours} locale={locale} />
  </div>
</header>

<style>
  .hero {
    position: relative;
    /* svh y no vh: en móvil, vh cuenta con la barra del navegador retraída y la
       portada se corta por abajo justo donde queremos que asome el primer
       plato. Además de la cabecera se resta una franja de asomo: sin ella la
       portada llena la pantalla al píxel y la tira de platos queda invisible
       hasta que alguien decide bajar. Que asome es el punto entero. */
    height: calc(100svh - var(--t-header-h, 62px) - clamp(128px, 18vw, 156px));
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* En pantalla estrecha la portada se parte en dos piezas, y no es un capricho
     de composición: la foto es cuadrada y el hueco de móvil es vertical, así que
     a sangre solo cabía el 60% del ancho y el rótulo se leía «OS OCHO». Como el
     rótulo es justo lo que tiene que verse, la foto se muestra entera arriba y el
     titular baja a una banda del rojo de la casa. En ancho no hace falta: ahí el
     hueco es apaisado, el rótulo entra completo y la portada sigue a sangre. */
  @media (max-width: 860px) {
    /* El alto lo dan la foto y el texto, no un cálculo contra la pantalla: con
       `100svh` sobraba un dedo de rojo vacío debajo del titular. Partida en dos
       piezas, la portada mide lo que mide y la tira de platos asoma igual —de
       hecho asoma más—, que es lo que el cálculo protegía. */
    .hero {
      display: grid;
      grid-template-rows: auto auto;
      height: auto;
      min-height: 0;
      background: var(--rojo);
    }
    .shot {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
    /* Sin degradado: el titular ya no se apoya en la foto, sino en el rojo. */
    .veil {
      display: none;
    }
    .copy {
      display: flex;
      flex-direction: column;
      padding-top: clamp(18px, 4vw, 28px);
      padding-bottom: clamp(20px, 5vw, 32px);
      /* Sobre el rojo, la tinta no se lee. En vez de parchear el estado de
         apertura desde fuera, se le reescriben los tokens que consume: para eso
         existe el sistema, y así cualquier pieza neutra que caiga aquí se
         adapta sola. */
      --t-text: var(--paper);
      --t-text-dim: rgba(255, 255, 255, 0.88);
      --t-text-faint: rgba(255, 255, 255, 0.6);
      --t-accent: var(--paper);
    }
    .hero h1 {
      /* Sobre rojo plano la sombra de tinta vuelve a ser la de la marca: la roja
         desaparecería contra el fondo. */
      text-shadow: 0.04em 0.045em 0 var(--ink);
    }
  }
  /* Degradado solo bajo el texto, no una capa uniforme sobre toda la foto:
     apagar la imagen entera es justo lo que hacen las cinco webs que nos
     pusieron de referencia, y es lo que las vuelve intercambiables. */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, 0.92) 0%,
      rgba(26, 26, 26, 0.66) 28%,
      rgba(26, 26, 26, 0) 62%
    );
  }
  /* El cartel de cookies vive en esta misma esquina durante la primera visita.
     `--t-consent-h` lo publica el propio cartel y vuelve a 0 al decidir, así
     que el titular se aparta mientras hace falta y no un píxel más. */
  /* El apartarse es un `transform` y no el `padding` que crecía: mover el
     relleno obliga al navegador a recalcular la disposición en cada fotograma,
     y el resultado en pantalla es idéntico porque el bloque ya está anclado
     abajo y el alto de la portada no depende de él. */
  .copy {
    position: relative;
    padding-bottom: clamp(26px, 5vw, 54px);
    width: 100%;
    transform: translateY(calc(-1 * var(--t-consent-h, 0px)));
    transition: transform var(--dur-out) var(--ease);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 10vw, 6rem);
    line-height: 0.94;
    margin: 0 0 14px;
    max-width: 14ch;
    /* Sobre la foto, el cartel invierte su fórmula: la tinta pasa a ser el
       papel y la sombra dura la pone el rojo de la marca. */
    color: var(--paper);
    text-shadow: 0.04em 0.045em 0 var(--rojo);
  }
</style>
