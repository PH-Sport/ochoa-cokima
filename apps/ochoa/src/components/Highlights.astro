  .highlights[data-mazo] .strip {
    --dur-vuelta: calc(var(--dur-baraja) * 0.5);
  }
  .highlights[data-mazo] .card[data-vuelve] {
    z-index: 20;
    opacity: 1;
    animation: del-fondo var(--dur-vuelta) var(--ease-telon) both;
  }
  /* Mientras entra, el resto del mazo espera quieto y se recoloca cuando ya
     está tapado por ella. Sin esa espera, la de delante perdía la sombra en el
     primer fotograma y se encogía al fondo en 150 ms —la quíntica—, y Mario lo
     vio como «se hunde de golpe». La sombra cambia de dueña en ese mismo
     instante: `0s` con retardo es un cambio diferido, no una animación de la
     sombra. */
  .highlights[data-mazo] .strip[data-atras] .card:not([data-vuelve]) {
    transition:
      transform var(--dur-in) var(--ease) var(--dur-vuelta),
      opacity var(--dur-in) var(--ease) var(--dur-vuelta),
      box-shadow 0s linear var(--dur-vuelta);
  }
  .highlights[data-mazo] .strip[data-atras] .card[data-vuelve] {
    transition: box-shadow 0s linear var(--dur-vuelta);
  }

  @media (min-width: 861px) {
    /* En el ordenador la tira va dentro de la ventana, que lleva el margen de la
       página (`.wrap`): así la rueda recorta justo donde acaba la fila, y la
       fila queda a plomo con el título. */
    .ventana {
      display: block;
    }
    /* Seis tarjetas a la vista, del mismo ancho que cuando los seis platos
       llenaban la fila. El relleno de la derecha es para la sombra roja de la
       última, que si no se cortaba en seco, y el margen negativo lo devuelve
       para que la fila no se estreche. */
    .strip {
      --visibles: 6;
      /* En unidades de la tira (`cqw`) y no en % de la tarjeta: para mover la
         rueda, Safari toma el % con el ancho de la tarjeta redondeado, y a 1440
         la sexta se quedaba 1,7 px corta del botón. */
      --ancho: calc((100cqw - (var(--visibles) - 1) * var(--hueco)) / var(--visibles));
      container-type: inline-size;
      padding: 0 6px 10px 0;
      margin-right: -6px;
      scroll-padding-inline: 0;
    }
    .card {
      flex: 0 0 var(--ancho);
      max-width: none;
    }
    .shot {
      aspect-ratio: 1;
    }
    /* La rueda no tiene una carta «de delante» que señalar, y sin JavaScript la
       tira se recorre igual que una página. */
    .turnos {
      display: none;
    }

    /* La rueda (ver el script). Todas las tarjetas en la celda de una rejilla
       del ancho de una, y cada una en su `--sitio`: el 0 es la primera de la
       izquierda. La tira ya no se desliza, y lo que queda fuera lo recorta ella. */
    .highlights[data-rueda] .strip {
      display: grid;
      overflow: hidden;
      scroll-snap-type: none;
      touch-action: pan-y;
      user-select: none;
    }
    .highlights[data-rueda] .card {
      grid-area: 1 / 1;
      width: var(--ancho);
      transform: translateX(calc(var(--sitio, 0) * (var(--ancho) + var(--hueco))));
      transition: transform var(--dur-rueda) var(--ease-telon);
    }
    /* La que da la vuelta, de un extremo al otro por fuera de la vista. */
    .highlights[data-rueda] .card[data-salta] {
      transition: none;
    }
  }
  /* Tumbado y bajo no hay mazo (ver el script), y sin mazo no hay turno. */
  @media (orientation: landscape) and (max-height: 500px) {
    .turnos {
      display: none;
    }
  }
</style>
