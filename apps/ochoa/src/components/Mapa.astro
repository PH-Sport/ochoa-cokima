---
// apps/ochoa/src/components/Mapa.astro
//
// El mapa del local es un dibujo, no un mapa: la manzana en isométrico, al
// estilo de la vista 3D de Apple Maps pero propio y con la piel de la casa.
// Las huellas y las alturas de los edificios son las reales —salen de
// OpenStreetMap— y el dibujo lo genera `scripts/mapa-manzana.py`; aquí solo se
// incrusta y se pinta con los tokens.
//
// No es un mapa embebido a propósito. El interactivo trae novecientos
// kilobytes de JavaScript y cookies de terceros —esta web no tiene ni un
// dominio ajeno y no vamos a estrenar el contador con el mapa—, y la imagen
// estática de Google necesitaba una clave que gestionar. Mario lo cerró el
// 2026-09-20: «no nos metemos en tanto lío de claves de Google y demás». Lo
// que hace falta de verdad es lo que ya hacía el hueco: tocarlo abre la app de
// mapas del móvil, que es lo que quiere quien mira esto de pie en la calle.
import { RESTAURANT } from "../site.ts";
import dibujo from "../assets/mapa-manzana.svg?raw";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";

const direccion = `${RESTAURANT.streetAddress}, ${RESTAURANT.postalCode} ${RESTAURANT.addressLocality}`;
const consulta = encodeURIComponent(direccion);

// Universal: lo resuelve cada sistema con su app de mapas por defecto.
const comoLlegar = `https://www.google.com/maps/search/?api=1&query=${consulta}`;

const t = es
  ? { como: "Cómo llegar", alt: `Mapa de ${direccion}: la manzana entre la Castellana, San Germán y Pedro Teixeira, junto al metro de Cuzco` }
  : { como: "Get directions", alt: `Map of ${direccion}: the block between the Castellana, San Germán and Pedro Teixeira, next to Cuzco metro` };
---

<a class="mapa" href={comoLlegar} target="_blank" rel="noopener">
  {/* El SVG va en línea y no como <img>: así el texto usa la fuente de la casa
      y los colores salen de los tokens, no van horneados en el archivo. */}
  <span class="dibujo" role="img" aria-label={t.alt} set:html={dibujo} />
  <span class="ir">{t.como} →</span>
</a>

<style>
  .mapa {
    position: relative;
    display: block;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
    overflow: hidden;
    box-shadow: 6px 6px 0 rgba(198, 34, 43, 0.9);
    /* Se hunde el doble que un botón porque su sombra mide el doble, y su
       sombra es roja: las dos cosas se las dice al mecanismo de `data-tacto`
       del layout, que por defecto asume tres píxeles y tinta. */
    --tacto-d: 6px;
    --tacto-sombra: rgba(198, 34, 43, 0.9);
    transition:
      transform var(--dur-out) var(--ease),
      box-shadow var(--dur-out) var(--ease);
  }
  /* El mismo recorrido que los botones: el mapa es lo más grande que se pulsa
     en toda la sección, y tiene que acusar el dedo igual que ellos. */
  .mapa:active {
    transform: translate(6px, 6px);
    box-shadow: 0 0 0 rgba(198, 34, 43, 0.9);
  }
  .dibujo {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--paper-2);
  }
  .dibujo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* La chapa de «cómo llegar» va sobre el mapa, no debajo: es la acción de esta
     pieza y tiene que verse sin buscarla. */
  .ir {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-label);
    color: var(--paper);
    background: var(--ink);
    border-radius: var(--r-chapa);
    padding: 9px 12px;
  }
</style>

<style is:global>
  /* La piel del dibujo, hecha de nuevo el 2026-09-20 a petición de Mario: la primera parecía
     «un render técnico, pálido y gris». Esta busca de frente la sensación de maqueta de la vista
     3D de Apple: ningún contorno de tinta, volúmenes modelados solo por la luz, sombras difusas,
     y un suelo más oscuro para que calzadas y edificios tengan presencia. Sigue en la paleta de
     la casa: todos los grises son papel y tinta mezclados. Las clases las pone
     `scripts/mapa-manzana.py`. */
  .dibujo .suelo { fill: #dcd5d0; }
  .dibujo .jardin { fill: #d3cbc5; }
  .dibujo .canto { fill: none; stroke: #d0c8c2; stroke-linecap: round; stroke-linejoin: round; }
  .dibujo .cara { fill: none; stroke: #f6f3f1; stroke-linecap: round; stroke-linejoin: round; }
  /* Sombra arrojada y contacto con el suelo, los dos difusos: es lo que hace maqueta. */
  .dibujo .sombra { fill: var(--ink); opacity: 0.24; }
  .dibujo .contacto { fill: none; stroke: var(--ink); stroke-width: 3; stroke-opacity: 0.28; stroke-linecap: round; }
  .dibujo .halo { fill: var(--rojo); opacity: 0.45; }
  /* Una sola luz, de arriba a la derecha: la cara sur clara, la oeste en sombra, el techo el más
     claro. Sin contornos: el volumen lo dan los tres valores. */
  .dibujo .muro-o { fill: #b9ada5; }
  .dibujo .muro-s { fill: #d9d1cb; }
  .dibujo .techo { fill: #efeae6; }
  .dibujo .caseta { fill: #cbc1ba; }
  .dibujo .caseta-techo { fill: #e4deda; }
  .dibujo .local-muro { fill: var(--rojo-2); }
  .dibujo .local-techo { fill: var(--rojo); }
  /* Los nombres, en caja baja y con halo del color del suelo, como en un mapa. */
  .dibujo text { font-family: var(--sans); }
  .dibujo .rotulo, .dibujo .rotulo-menor, .dibujo .rotulo-cerca, .dibujo .rotulo-lugar {
    font-weight: 650;
    letter-spacing: 0.01em;
    paint-order: stroke;
    stroke: #dcd5d0;
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }
  .dibujo .rotulo { font-size: 12px; fill: var(--ink-dim); stroke: #f6f3f1; }
  .dibujo .rotulo-menor, .dibujo .rotulo-cerca { font-size: 9.5px; fill: var(--ink-dim); stroke: #f6f3f1; }
  .dibujo .rotulo-lugar { font-size: 9.5px; font-weight: 700; fill: var(--ink); }
  .dibujo .metro { fill: var(--ink); }
  .dibujo .metro-txt { font-size: 11px; font-weight: 800; fill: var(--paper); }
  .dibujo .chapa { fill: var(--ink); }
  .dibujo .chapa-pie { stroke: var(--ink); stroke-width: 1.6; }
  .dibujo .chapa-punto { fill: var(--ink); }
  .dibujo .chapa-txt { font-size: 12px; font-weight: 600; fill: var(--paper); }
  .dibujo .credito { font-size: 8px; fill: var(--ink-dim); }

  /* En el móvil el dibujo mide 350px: se apagan las calles menores y lo que orienta crece sobre
     su sitio. `transform-box: fill-box` escala cada texto alrededor de sí mismo; el giro de cada
     rótulo va en un grupo padre porque un `transform` de CSS sustituye al del atributo. */
  @media (max-width: 640px) {
    .dibujo .rotulo-menor { display: none; }
    .dibujo .rotulo, .dibujo .rotulo-cerca, .dibujo .rotulo-lugar, .dibujo .metro-g, .dibujo .chincheta, .dibujo .credito {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      transform: scale(1.6);
    }
    .dibujo .rotulo-lugar { transform: scale(1.35); }
    .dibujo .chincheta { transform-origin: 50% 100%; }
    /* Lo que está pegado al borde crece hacia dentro, no hacia fuera del marco. */
    .dibujo .metro-g { transform-origin: 100% 100%; }
    .dibujo .rotulo-borde { transform-origin: 100% 50%; }
    .dibujo .rotulo-izq { transform-origin: 0 50%; }
    .dibujo .credito { transform-origin: 0 100%; transform: scale(1.9); }
  }
</style>
