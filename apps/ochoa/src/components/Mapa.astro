---
// apps/ochoa/src/components/Mapa.astro
//
// El mapa del local es un dibujo, no un mapa: la manzana en perspectiva, con
// cámara baja e inclinada como la vista 3D de Apple Maps, pero propio y con la
// piel de la casa. Las huellas y las alturas de los edificios son las reales
// —salen de OpenStreetMap— y el dibujo lo genera `scripts/mapa-manzana.py`;
// aquí solo se incrusta y se pinta con los tokens. Fue isométrico un día
// (2026-09-20) y a Mario le pareció «un render técnico»: la perspectiva es lo
// que lo convierte en ciudad.
//
// No es un mapa embebido a propósito. El interactivo trae novecientos
// kilobytes de JavaScript y cookies de terceros —esta web no tiene ni un
// dominio ajeno y no vamos a estrenar el contador con el mapa—, y la imagen
// estática de Google necesitaba una clave que gestionar. Mario lo cerró el
// 2026-09-20: «no nos metemos en tanto lío de claves de Google y demás». Lo
// que hace falta de verdad es lo que ya hacía el hueco: tocarlo abre la app de
// mapas del móvil, que es lo que quiere quien mira esto de pie en la calle.
import { RESTAURANT } from "../site.ts";
import dibujo from "../assets/mapa-manzana.svg?raw";

interface Props {
  locale: "es" | "en";
}
const { locale } = Astro.props;
const es = locale === "es";

const direccion = `${RESTAURANT.streetAddress}, ${RESTAURANT.postalCode} ${RESTAURANT.addressLocality}`;
const consulta = encodeURIComponent(direccion);

// Universal: lo resuelve cada sistema con su app de mapas por defecto.
const comoLlegar = `https://www.google.com/maps/search/?api=1&query=${consulta}`;

const t = es
  ? { como: "Cómo llegar", alt: `Mapa de ${direccion}: la manzana del 117 sobre la Castellana, en la esquina con San Germán, entre la plaza y el metro de Cuzco y el Ministerio de Defensa` }
  : { como: "Get directions", alt: `Map of ${direccion}: the block at 117 on the Castellana, at the corner with San Germán, between Cuzco square and metro and the Ministry of Defence` };
---

<a class="mapa" href={comoLlegar} target="_blank" rel="noopener">
  {/* El SVG va en línea y no como <img>: así el texto usa la fuente de la casa
      y los colores salen de los tokens, no van horneados en el archivo. */}
  <span class="dibujo" role="img" aria-label={t.alt} set:html={dibujo} />
  <span class="ir">{t.como} →</span>
</a>

<style>
  .mapa {
    position: relative;
    display: block;
    border: 2px solid var(--ink);
    border-radius: var(--r-marco);
    overflow: hidden;
    box-shadow: 6px 6px 0 rgba(198, 34, 43, 0.9);
    /* Se hunde el doble que un botón porque su sombra mide el doble, y su
       sombra es roja: las dos cosas se las dice al mecanismo de `data-tacto`
       del layout, que por defecto asume tres píxeles y tinta. */
    --tacto-d: 6px;
    --tacto-sombra: rgba(198, 34, 43, 0.9);
    transition:
      transform var(--dur-out) var(--ease),
      box-shadow var(--dur-out) var(--ease);
  }
  /* El mismo recorrido que los botones: el mapa es lo más grande que se pulsa
     en toda la sección, y tiene que acusar el dedo igual que ellos. */
  .mapa:active {
    transform: translate(6px, 6px);
    box-shadow: 0 0 0 rgba(198, 34, 43, 0.9);
  }
  .dibujo {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--paper-2);
  }
  .dibujo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* La chapa de «cómo llegar» va sobre el mapa, no debajo: es la acción de esta
     pieza y tiene que verse sin buscarla. */
  .ir {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-label);
    color: var(--paper);
    background: var(--ink);
    border-radius: var(--r-chapa);
    padding: 9px 12px;
  }
</style>

<style is:global>
  /* La piel del dibujo. La primera parecía «un render técnico, pálido y gris»; esta busca de
     frente la sensación de maqueta de la vista 3D de Apple: ningún contorno de tinta, volúmenes
     modelados solo por la luz —techo el más claro, caras en cuatro escalones—, sombra arrojada y
     de contacto difusas, y un suelo más oscuro para que calzadas y bloques tengan presencia.
     Sigue en la paleta de la casa, literalmente: todos los grises son papel y tinta mezclados
     con color-mix sobre los tokens. Las clases las pone `scripts/mapa-manzana.py`. */
  .dibujo .suelo { fill: color-mix(in srgb, var(--paper-3) 86%, var(--ink)); }
  .dibujo .jardin { fill: color-mix(in srgb, var(--paper-3) 79%, var(--ink)); }
  .dibujo .calzada { fill: var(--paper-2); }
  .dibujo .sombra { fill: var(--ink); opacity: 0.28; }
  .dibujo .contacto { fill: var(--ink); opacity: 0.38; }
  .dibujo .halo { fill: var(--rojo); opacity: 0.4; }
  .dibujo .m1 { fill: color-mix(in srgb, var(--paper-3) 78%, var(--ink)); }
  .dibujo .m2 { fill: color-mix(in srgb, var(--paper-3) 70%, var(--ink)); }
  .dibujo .m3 { fill: color-mix(in srgb, var(--paper-3) 61%, var(--ink)); }
  .dibujo .m4 { fill: color-mix(in srgb, var(--paper-3) 53%, var(--ink)); }
  .dibujo .techo { fill: color-mix(in srgb, var(--paper-3) 92%, var(--ink)); }
  .dibujo .caseta { fill: color-mix(in srgb, var(--paper-3) 64%, var(--ink)); }
  .dibujo .caseta-techo { fill: color-mix(in srgb, var(--paper-3) 88%, var(--ink)); }
  .dibujo .local-luz { fill: color-mix(in srgb, var(--rojo) 78%, var(--rojo-2)); }
  .dibujo .local-sombra { fill: var(--rojo-2); }
  .dibujo .local-techo { fill: var(--rojo); }
  /* Un filete del mismo color que el relleno, para que no asome el suelo por las juntas entre
     caras: no es un contorno, es el antialias tapado. */
  .dibujo .m1, .dibujo .m2, .dibujo .m3, .dibujo .m4, .dibujo .techo, .dibujo .caseta, .dibujo .caseta-techo,
  .dibujo .local-luz, .dibujo .local-sombra, .dibujo .local-techo { stroke-width: 0.6; stroke-linejoin: round; }
  .dibujo .m1 { stroke: color-mix(in srgb, var(--paper-3) 78%, var(--ink)); }
  .dibujo .m2 { stroke: color-mix(in srgb, var(--paper-3) 70%, var(--ink)); }
  .dibujo .m3 { stroke: color-mix(in srgb, var(--paper-3) 61%, var(--ink)); }
  .dibujo .m4 { stroke: color-mix(in srgb, var(--paper-3) 53%, var(--ink)); }
  .dibujo .techo { stroke: color-mix(in srgb, var(--paper-3) 92%, var(--ink)); }
  .dibujo .caseta { stroke: color-mix(in srgb, var(--paper-3) 64%, var(--ink)); }
  .dibujo .caseta-techo { stroke: color-mix(in srgb, var(--paper-3) 88%, var(--ink)); }
  .dibujo .local-luz { stroke: color-mix(in srgb, var(--rojo) 78%, var(--rojo-2)); }
  .dibujo .local-sombra { stroke: var(--rojo-2); }
  .dibujo .local-techo { stroke: var(--rojo); }
  /* Los nombres, en caja baja y con halo del color de la calzada, pintados en el suelo. */
  .dibujo text { font-family: var(--sans); }
  .dibujo .rotulo, .dibujo .rotulo-menor, .dibujo .rotulo-cerca, .dibujo .rotulo-lugar {
    font-weight: 650;
    letter-spacing: 0.01em;
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }
  .dibujo .rotulo { font-size: 12px; fill: var(--ink-dim); }
  .dibujo .rotulo-menor, .dibujo .rotulo-cerca { font-size: 9.5px; fill: var(--ink-dim); }
  .dibujo .rotulo-lugar { font-size: 9.5px; font-weight: 700; fill: var(--ink); stroke: color-mix(in srgb, var(--paper-3) 86%, var(--ink)); }
  .dibujo .metro { fill: var(--ink); }
  .dibujo .metro-txt { font-size: 10px; font-weight: 800; fill: var(--paper); }
  .dibujo .chapa { fill: var(--ink); }
  .dibujo .chapa-pie { stroke: var(--ink); stroke-width: 1.6; }
  .dibujo .chapa-punto { fill: var(--ink); }
  .dibujo .chapa-txt { font-size: 12px; font-weight: 600; fill: var(--paper); }
  .dibujo .credito { font-size: 8px; fill: var(--ink-dim); }

  /* En el móvil el dibujo mide 350px: se apagan las calles menores y lo que orienta crece sobre
     su sitio. `transform-box: fill-box` escala cada texto alrededor de sí mismo; el giro y la
     inclinación de cada rótulo van en un grupo padre porque un `transform` de CSS sustituye al
     del atributo. */
  @media (max-width: 640px) {
    .dibujo .rotulo-menor { display: none; }
    .dibujo .rotulo, .dibujo .rotulo-cerca, .dibujo .rotulo-lugar, .dibujo .metro-g, .dibujo .chincheta, .dibujo .credito {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      transform: scale(1.6);
    }
    .dibujo .rotulo-lugar { transform: scale(1.35); }
    .dibujo .chincheta { transform-origin: 50% 100%; }
    /* Lo que está pegado al borde crece hacia dentro, no hacia fuera del marco. */
    .dibujo .metro-g { transform-origin: 100% 100%; }
    .dibujo .rotulo-borde { transform-origin: 100% 50%; }
    .dibujo .rotulo-izq { transform-origin: 0 50%; }
    .dibujo .credito { transform-origin: 0 100%; transform: scale(1.9); }
  }
</style>
