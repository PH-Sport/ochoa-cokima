---
// El manifiesto: una banda roja con la pared de botellas de la casa en blanco y
// negro, multiplicada encima como un cartel a dos tintas, que va y viene muy
// despacio (`--dur-paneo`) y además va más lenta que la página. Llegó con la home
// viva el 2026-10-28 —«aporta algo de dinamismo», dijo Mario— y se quedó. Vive
// aquí desde el 2026-10-29 para que la home inglesa lleve la misma pieza: la cita
// y el párrafo llegan por el `slot` desde cada home, en su idioma.
import { Image } from "astro:assets";
import botellas from "../assets/casa/botellas.jpg";
---

<section class="manifesto" data-paralaje data-paneo>
  {/* Decoración: la cita se lee igual sin ella. 1600 y no 1440, que es lo que
      mide la foto: Vercel descarta en silencio los anchos que no están en
      `imagesConfig`, y con 1440 el srcset se quedaba en 960. */}
  <div class="fondo-paneo" data-vel="-0.12" data-tope="40" aria-hidden="true">
    <Image src={botellas} alt="" widths={[640, 960, 1200, 1600]} sizes="100vw" quality={70} loading="lazy" class="paneo" />
  </div>
  <div class="wrap">
    <slot />
  </div>
</section>

<script>
  /* El paneo solo corre mientras se ve la banda, y se para para siempre al
   * primer toque (regla 6 de docs/movimiento.md). Con «reducir movimiento» no
   * arranca. */
  import { alTocar } from "../toque.ts";

  let suelta: (() => void) | null = null;

  function montaPaneo() {
    const manifiesto = document.querySelector<HTMLElement>("[data-paneo]");
    if (!manifiesto || matchMedia("(prefers-reduced-motion: reduce)").matches) return null;
    const abort = new AbortController();
    const ojo = new IntersectionObserver(([e]) => manifiesto.classList.toggle("en-vista", e.isIntersecting));
    ojo.observe(manifiesto);
    /* Un toque de verdad, no el dedo que baja la página pasando por encima
       (`toque.ts`): con `pointerdown` se apagaba al bajar. */
    alTocar(manifiesto, { toca: () => manifiesto.classList.add("quieto") }, abort.signal);
    return () => {
      ojo.disconnect();
      abort.abort();
    };
  }

  document.addEventListener("astro:page-load", () => {
    suelta?.();
    suelta = montaPaneo();
  });
</script>

<style>
  /* La cita pasa al papel con el relieve de tinta de los rótulos, y lo que antes
     iba en rojo va en tinta con el relieve en papel: rojo sobre rojo no se
     vería. */
  .manifesto {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(44px, 7vw, 84px) 0;
    background: var(--rojo);
    color: var(--paper);
  }
  /* Hasta el 2026-10-30 abría con la doble raya de las secciones, en blanco.
     Mario la quitó —«no cumple una gran función»—, y el aire que dejaba lo da
     el relleno de la banda, el mismo arriba que abajo. */
  .manifesto :global(blockquote) {
    margin: 0;
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.32;
    max-width: 26ch;
    text-wrap: balance;
    color: var(--paper);
    text-shadow: 0.045em 0.05em 0 var(--ink);
  }
  .manifesto :global(blockquote strong) {
    color: var(--ink);
    text-shadow: 0.045em 0.05em 0 var(--paper);
  }
  .manifesto :global(.sub) {
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 56ch;
    margin: 1.5rem 0 0;
  }
  /* La mezcla va en el envoltorio y no en la foto: el paralaje le pone un
     `transform`, que lo convierte en su propio grupo de pintado, y una foto que
     se multiplicara dentro se multiplicaría contra nada (salía gris, sin rojo;
     regla 26). Así se multiplica el grupo entero contra el rojo de la sección,
     que está aislada (`isolation`) para que la mezcla no se salga de ella. */
  .fondo-paneo {
    position: absolute;
    inset: -10% 0;
    z-index: -1;
    mix-blend-mode: multiply;
  }
  .paneo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    transform: scale(1.1);
    animation: paneo var(--dur-paneo) var(--ease-telon) infinite alternate;
    animation-play-state: paused;
  }
  .manifesto:global(.en-vista) .paneo {
    animation-play-state: running;
  }
  .manifesto:global(.quieto) .paneo {
    animation-play-state: paused;
  }
  @keyframes paneo {
    from {
      transform: scale(1.1) translate3d(-2.5%, 1%, 0);
    }
    to {
      transform: scale(1.1) translate3d(2.5%, -1%, 0);
    }
  }
  /* La regla global de «reducir movimiento» acorta las animaciones pero no las
     detiene, y un paneo infinito acortado parpadearía: aquí se quita. */
  @media (prefers-reduced-motion: reduce) {
    .paneo {
      animation: none;
    }
  }

  /* Arriba y abajo lo mismo: es una banda, y el texto no puede tocar su borde. */
  @media (max-width: 860px) {
    .manifesto {
      padding: 40px 0;
    }
    .manifesto :global(.sub) {
      font-size: 1rem;
      margin-top: 0.9rem;
    }
  }
</style>
