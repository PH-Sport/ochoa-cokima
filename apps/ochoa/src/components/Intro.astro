---
// La entrada: «LOS» y «OCHOA» llegan de lados opuestos, cada una torcida, y se
// enderezan al encajar. Después la plancha roja se recoge hasta medir
// exactamente la barra, con el rótulo viajando hasta su sitio dentro de ella y
// los botones deslizándose desde el borde derecho.
//
// No estrena vocabulario: es el telón del menú y la plancha de la barra
// haciendo un gesto nuevo, y por eso la costura no se ve —al terminar la
// recogida, debajo hay el mismo rojo—. El encaje de dos piezas es el rótulo de
// bar montado a mano, que nunca queda a plomo.
//
// El diseño entero, con las variantes descartadas y sus motivos, está en
// docs/superpowers/specs/2026-08-06-entrada-ochoa-design.md.
//
// Sin props: el rótulo es el nombre del bar y se escribe igual en los dos
// idiomas. El día que haya algo que traducir aquí, entrará una.
---

<div class="intro" data-intro-plancha aria-hidden="true" inert>
  <span class="marca cartel" data-intro-marca>
    <span class="capa sombra"><i class="p1">Los</i> <i class="p2">Ochoa</i></span>
    <span class="capa papel"><i class="p1">Los</i> <i class="p2">Ochoa</i></span>
  </span>
</div>

<script>
  import { initEntrada } from "@tombo/ui/intro.ts";

  // El descriptor de la fuente del rótulo, que es lo único de la entrada que es
  // marca: @tombo/ui no sabe que esta casa rotula en Anton.
  initEntrada("400 1em Anton");
</script>

<style>
  /* Solo existe si el script del `<head>` ha decidido que sale. Mientras tanto
     no hay ni caja: la web se ve entera desde el primer frame, que es también
     lo que pasa sin JavaScript. */
  .intro {
    display: none;
  }
  :global(html[data-intro]) .intro {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    /* Por encima de todo: panel del menú 50, barra 60, cartel de cookies 60. */
    z-index: 80;
    background: var(--rojo);
    padding: 0 max(16px, 4vw);
    pointer-events: none;
    /* Las dos mitades del rótulo entran desde fuera de la pantalla, y lo que se
       sale ensancha el documento si no se recorta aquí. Se recorta en la pieza
       que lo provoca, nunca en el documento (regla 17). */
    overflow: hidden;
  }

  /* Lleva la clase `.cartel` y no una copia de su fórmula. Aquí se reimplementó
     al principio —solo familia e interlineado— y el resultado fue que el rótulo
     de la entrada decía «Los Ochoa» mientras el de la barra decía «LOS OCHOA»:
     faltaban el `text-transform` y el `letter-spacing`. Mario lo vio al primer
     vistazo. Dos piezas que tienen que encajar no comparten *valores*,
     comparten *la regla*: es lo mismo que hizo `.brand` con su sombra. */
  .marca {
    position: relative;
    display: inline-block;
    /* El viaje se calcula desde esta esquina: `initEntrada` publica --tx, --ty
       y --s midiendo los dos rectángulos, porque de dónde sale y a dónde llega
       dependen del ancho de la pantalla y del cuerpo de la fuente. Cualquier
       número fijo sería falso en algún móvil. */
    transform-origin: left top;
    font-size: clamp(2.6rem, 13vw, 7rem);
    white-space: nowrap;
    /* Lo único que se le quita a `.cartel`: su sombra se hereda a las dos capas
       y aquí la sombra ES una capa, la de tinta, que es la que se despega. El
       color tampoco importa porque cada capa declara el suyo. */
    text-shadow: none;
  }
  .capa {
    display: block;
  }
  .sombra {
    position: absolute;
    inset: 0;
    color: var(--ink);
    /* Puesta ya en su sitio: si el script no llegara a arrancar la animación,
       el rótulo se ve correcto y no a medio hacer. */
    transform: translate(0.045em, 0.05em);
  }
  .papel {
    position: relative;
    color: var(--paper);
  }
  /* Las dos mitades del rótulo. `<i>` sin cursiva: es la etiqueta más corta que
     queda para partir una palabra sin añadir significado, y aquí la partición
     es puramente de montaje. */
  .p1,
  .p2 {
    display: inline-block;
    font-style: normal;
  }

  /* ── El encaje ────────────────────────────────────────────────────────
     Cada mitad llega de un lado, torcida, y se endereza al juntarse. El
     desplazamiento va en porcentaje del ancho de cada palabra, así que las dos
     salen de la pantalla aunque midan distinto.
     El desfase entre ellas es `--stagger` doblado: con el escalón simple —30ms,
     calibrado para una cascada vertical de hermanos— dos piezas que llegan de
     lados opuestos se leen como simultáneas y el encaje deja de contarse. */
  :global(html[data-intro]) .p1 {
    transform: translateX(-260%) rotate(calc(-1 * var(--tuerce)));
  }
  :global(html[data-intro]) .p2 {
    transform: translateX(160%) rotate(var(--tuerce));
  }
  :global(html[data-intro]) .sombra {
    transform: translate(0, 0);
  }

  /* Las fases se encadenan sin huecos y sin estrenar ninguna duración:
       0    → 420ms   «LOS» llega y se endereza          (--dur-in)
       60   → 480ms   «OCHOA» llega y se endereza        (--dur-in, +2 escalones)
       420  → 700ms   la sombra se despega               (--dur-firma)
       700  → 1400ms  la plancha se recoge hasta ser la barra, el rótulo
                      aterriza dentro y los botones entran por la derecha */
  :global(html[data-intro="va"]) .p1 {
    animation: encaja-izq var(--dur-in) var(--ease) both;
  }
  :global(html[data-intro="va"]) .p2 {
    animation: encaja-der var(--dur-in) var(--ease) calc(var(--stagger) * 2) both;
  }
  :global(html[data-intro="va"]) .sombra {
    animation: firma var(--dur-firma) var(--ease) var(--dur-in) both;
  }

  /* `data-intro="va"` y no `"si"`: la animación no arranca hasta que el script
     ha medido el viaje. Si arrancara sola, con el módulo llegando tarde el
     rótulo aterrizaría en un sitio inventado. */
  :global(html[data-intro="va"]) .intro {
    animation: recoge var(--dur-recogida) var(--ease-telon) var(--espera-firma) both;
  }
  :global(html[data-intro="va"]) .marca {
    animation: aterriza var(--dur-recogida) var(--ease-telon) var(--espera-firma) both;
  }

  /* ── Los botones de la barra ──────────────────────────────────────────
     Se descubrían de golpe cuando la plancha se retiraba, que es justo lo que
     la regla 10 prohíbe: lo que aparece detrás de algo que se mueve no puede
     materializarse sin más.
     Entran DURANTE la recogida y no después, flotando por encima de la plancha
     —de ahí el z-index—. Como la plancha es exactamente el rojo de la barra, se
     leen como si ya estuvieran en su sitio, y todo converge en el mismo
     instante en vez de dejar un hueco muerto al final.
     La barra recorta mientras dura la entrada, porque un botón desplazado fuera
     ensancharía el documento (regla 17). */
  /* La barra sube por encima de la plancha, y para eso tiene que subir ENTERA:
     es `sticky` con `z-index: 60`, así que crea su propio contexto de
     apilamiento y cualquier z-index que se le ponga a un hijo solo compite
     dentro de ella. Subir solo `.nav-actions` a 81 no servía de nada —los
     botones seguían tapados—, y se ve al primer vistazo pero no lo canta
     ningún error.
     Al subirla, su fondo taparía el rótulo que viaja por debajo, así que se
     apaga: la plancha es exactamente este mismo rojo y hace de fondo por ella.
     El filete también, o cruzaría la plancha con una línea negra durante toda
     la entrada; vuelve con la transición que `.nav` ya tiene declarada, la
     misma que usa al cerrar el menú. */
  /* Cada selector va envuelto en UN SOLO `:global()` con la cadena entera. Con
     `:global(a) :global(b) > *` el combinador y el `*` se quedan fuera y Astro
     les añade el ámbito de ESTE componente: la regla salía como
     `.nav-actions > [data-astro-cid-u43ozx4m]`, y los botones llevan el cid de
     `Nav.astro`, así que no le aplicaba a nada. No da ningún error; sencillamente
     no hace nada. */
  :global(html[data-intro] .nav) {
    overflow: hidden;
    z-index: 81;
    background: transparent;
    border-bottom-color: transparent;
  }
  /* `--fuera` es la distancia medida de cada botón al borde de la ventana, y la
     publica `initEntrada`. El valor de reserva es `100vw` y no un porcentaje:
     **tiene que ser seguro, no aproximado**. Aquí hubo un `160%` que parecía
     razonable y no lo era —el porcentaje es del ancho de cada botón, así que
     uno de 62px se apartaba 99px y en escritorio, con el margen de la barra,
     seguía dentro de la pantalla: asomaban desde el primer fotograma—. Con
     `100vw` sale cualquier pieza esté donde esté, y la medida solo sirve para
     que el viaje sea el justo en vez de cruzar la pantalla entera (regla 9). */
  :global(html[data-intro] .nav-actions > *) {
    transform: translateX(var(--fuera, 100vw));
    /* Sin esto, apartarlos NO es instantáneo: estos botones llevan
       `transition: transform` para el hundido al tacto, así que el navegador
       anima también este desplazamiento y se les ve **salir** hacia la derecha
       durante los primeros 160ms en vez de estar ya fuera. Era el «se asoma
       ligeramente» que vio Mario. La transición vuelve sola al retirarse la
       entrada, porque el selector deja de aplicar. */
    transition: none;
  }
  /* Frenan con la quíntica de la casa, que es la que frena como frena un objeto
     de verdad. El que está más a la derecha llega primero: es de donde vienen. */
  :global(html[data-intro="va"] .nav-actions > .menu-btn) {
    animation: llega var(--dur-recogida) var(--ease) var(--espera-firma) both;
  }
  :global(html[data-intro="va"] .nav-actions > .btn) {
    animation: llega var(--dur-recogida) var(--ease)
      calc(var(--espera-firma) + var(--stagger) * 2) both;
  }

  /* Mientras la entrada está puesta, el rótulo de la barra espera apagado: dos
     copias visibles a la vez cantarían el truco justo al aterrizar. */
  :global(html[data-intro] .brand) {
    opacity: 0;
  }

  @keyframes encaja-izq {
    from {
      transform: translateX(-260%) rotate(calc(-1 * var(--tuerce)));
    }
    to {
      transform: translateX(0) rotate(0);
    }
  }
  @keyframes encaja-der {
    from {
      transform: translateX(160%) rotate(var(--tuerce));
    }
    to {
      transform: translateX(0) rotate(0);
    }
  }
  @keyframes firma {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(0.045em, 0.05em);
    }
  }
  @keyframes llega {
    from {
      transform: translateX(var(--fuera, 100vw));
    }
    to {
      transform: translateX(0);
    }
  }

  /* La plancha no se va: se recoge hasta medir exactamente la barra. */
  @keyframes recoge {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 calc(100% - var(--t-header-h, 62px)) 0);
    }
  }
  @keyframes aterriza {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(var(--s, 1));
    }
  }
</style>
