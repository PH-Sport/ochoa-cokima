---
// apps/ochoa/src/components/MenuBoard.astro
import { formatEuro, type MenuEntry } from "@tombo/content";

interface Props {
  dishes: MenuEntry[];
  locale: "es" | "en";
}
const { dishes, locale } = Astro.props;
const es = locale === "es";
const t = es
  ? {
      half: "½ ración",
      full: "Ración",
      price: "Precio",
      dish: "Plato",
      noHalf: "No se sirve en media ración",
      sections: { carta: "Carta", postres: "Postres" } as Record<string, string>,
    }
  : {
      half: "Half",
      full: "Full",
      price: "Price",
      dish: "Dish",
      noHalf: "Not served as a half portion",
      sections: { carta: "Menu", postres: "Desserts" } as Record<string, string>,
    };

// `order` es correlativo dentro de cada sección (carta 1..23, postres 1..2), no
// un índice global: hay que agrupar por sección y ordenar dentro de ella, o los
// postres se intercalan entre los platos salados.
const SECTION_ORDER = ["carta", "postres"];
const sections = SECTION_ORDER.map((key) => {
  const items = dishes.filter((d) => d.section === key).sort((a, b) => a.order - b.order);
  return {
    key,
    title: t.sections[key] ?? key,
    items,
    // Los postres tienen un precio y ya. Una sección sin medias raciones no
    // enseña una columna vacía: enseña una sola columna de precio.
    hasHalf: items.some((d) => typeof d.price === "object" && d.price.half !== null),
  };
}).filter((s) => s.items.length > 0);

/** Las dos cifras de una fila, tal y como van impresas en la carta de la casa. */
const cells = (price: MenuEntry["price"]) => {
  if (typeof price === "number") return { half: null, full: price, noHalf: false };
  return { half: price.half, full: price.full, noHalf: price.half === null };
};
---

<div class="board">
  {sections.map((sec) => (
    <section class="sec">
      {/* La primera sección no repite su título: lo dice el titular de la
          página dos centímetros más arriba. */}
      {sec.key !== "carta" && <h2 class="sec-title">{sec.title}</h2>}

      <table class="menu">
        <caption class="visually-hidden">{sec.title}</caption>
        <thead>
          <tr>
            {/* La columna de platos necesita nombre para quien navega con
                lector de pantalla, pero ninguna carta de bar escribe "PLATO"
                encima de los platos: se lo dice a quien lo necesita y no le
                quita sitio a nadie más. */}
            <th scope="col" class="col-dish"><span class="visually-hidden">{t.dish}</span></th>
            {sec.hasHalf && <th scope="col" class="col-price">{t.half}</th>}
            <th scope="col" class="col-price">{sec.hasHalf ? t.full : t.price}</th>
          </tr>
        </thead>
        <tbody>
          {sec.items.map((dish) => {
            const c = cells(dish.price);
            return (
              <tr>
                <th scope="row" class="dish">
                  <span class="name">{dish.name}</span>
                  {dish.description && <span class="desc">{dish.description}</span>}
                </th>
                {sec.hasHalf && (
                  <td class="price">
                    {c.half !== null ? (
                      formatEuro(c.half)
                    ) : (
                      <>
                        <span aria-hidden="true" class="dash">—</span>
                        <span class="visually-hidden">{t.noHalf}</span>
                      </>
                    )}
                  </td>
                )}
                <td class="price">{formatEuro(c.full)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>
  ))}
</div>

<style>
  .sec + .sec {
    margin-top: var(--t-section-gap);
  }
  .sec-title {
    font-family: var(--t-heading-font);
    font-size: var(--t-menu-title-size);
    font-weight: var(--t-menu-title-weight);
    color: var(--t-menu-title-color);
    text-transform: var(--t-menu-title-transform);
    letter-spacing: var(--t-menu-title-spacing);
    text-shadow: var(--t-menu-title-shadow);
    line-height: var(--lh-cartel);
    margin: 0 0 0.6rem;
  }

  /* La carta no se estira a todo el ancho de la pantalla. A 1280px el nombre
     del plato quedaba a setecientos píxeles de su precio y el ojo no recorre
     esa distancia: es exactamente el hueco que antes tapaba la guía de puntos.
     Acotada, las dos cifras vuelven a caer al lado de su plato. El margen que
     queda a la derecha no sobra: es donde entrarán las fotos. */
  .board {
    --carta-w: 44rem;
  }
  .menu {
    width: 100%;
    max-width: var(--carta-w);
    border-collapse: collapse;
  }
  /* Las cabeceras de columna son la pieza que sostiene todo el invento: sin
     ellas, dos cifras seguidas no dicen cuál es la media y cuál la entera.
     Van en la versal apretada del rótulo y se apoyan en el filete doble de la
     casa, el mismo "CARTA ====" de la carta impresa. */
  .menu thead th {
    font-family: var(--sans);
    font-size: var(--fs-micro);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    text-align: right;
    padding: 0 0 6px;
    border-bottom: var(--t-rule-top);
    /* En una línea, siempre: partido, el «½» caía sobre el «ración» y las dos
       cabeceras dejaban de leerse como la pareja que son. Es la columna la que
       se ensancha lo que haga falta, no el rótulo el que se rompe. */
    white-space: nowrap;
  }
  .menu thead .col-dish {
    text-align: left;
  }
  /* Anchos fijos y no `auto`: son las dos columnas alineadas las que dicen de
     un vistazo qué precio es cuál, y para eso tienen que caer en la misma
     vertical en las veinticinco filas. Con `auto` cada tabla se colocaría a su
     aire y la media ración quedaría desperdigada de la entera. */
  .menu .col-price {
    width: 3.9rem;
  }
  .menu thead .col-price:last-child {
    width: 4.4rem;
  }

  .menu tbody tr {
    border-bottom: 1px solid var(--line);
  }
  .dish {
    text-align: left;
    font-weight: 400;
    padding: 13px 12px 13px 0;
  }
  .name {
    display: block;
    font-size: 1.02rem;
    font-weight: 550;
    line-height: 1.3;
  }
  .desc {
    display: block;
    margin-top: 0.3rem;
    color: var(--ink-dim);
    font-size: 0.92rem;
    line-height: 1.45;
    max-width: 46ch;
  }
  /* Sin `tabular-nums`: era lo que hacía que los precios parecieran de otra
     fuente que el nombre del plato. Y sin guía de puntos, que existía para
     llevar el ojo hasta un precio suelto a la derecha; con dos columnas
     alineadas, la columna ya es la guía. */
  .price {
    text-align: right;
    vertical-align: baseline;
    font-weight: 600;
    white-space: nowrap;
    padding: 13px 0;
  }
  /* El guion es el de la carta de la casa: dice "esto no va en media" sin
     gastar una palabra. Se apaga un punto para que no pese como una cifra. */
  .dash {
    color: var(--ink-faint);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
