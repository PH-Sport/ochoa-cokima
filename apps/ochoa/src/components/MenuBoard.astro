---
// apps/ochoa/src/components/MenuBoard.astro
import { formatPortionPrice, formatEuro, type MenuEntry } from "@tombo/content";

interface Props {
  dishes: MenuEntry[];
  locale: "es" | "en";
}
const { dishes, locale } = Astro.props;
const es = locale === "es";
const t = es
  ? {
      half: "½ ración",
      full: "Ración",
      onlyFull: "solo ración entera",
      legend: "Tamaño de ración",
      announceHalf: "Precios actualizados a media ración.",
      announceFull: "Precios actualizados a ración entera.",
      search: "Buscar plato",
      empty: "Nada con ese nombre.",
    }
  : {
      half: "Half",
      full: "Full",
      onlyFull: "full portion only",
      legend: "Portion size",
      announceHalf: "Prices updated to half portion.",
      announceFull: "Prices updated to full portion.",
      search: "Search dish",
      empty: "Nothing by that name.",
    };

// `order` es correlativo dentro de cada sección (carta 1..23, postres 1..2),
// no un índice global: hay que mantener la sección y solo ordenar dentro de ella,
// o los postres se intercalan entre los platos salados.
const sectionOrder = ["carta", "postres"];
const sorted = [...dishes].sort((a, b) => {
  const bySection = sectionOrder.indexOf(a.section) - sectionOrder.indexOf(b.section);
  return bySection !== 0 ? bySection : a.order - b.order;
});
---

<div class="board">
  <div class="toggle" data-portion-toggle hidden>
    <label class="search" data-search-wrap hidden>
      <span class="visually-hidden">{t.search}</span>
      <input type="search" data-search placeholder={t.search} autocomplete="off" />
    </label>
    <span class="legend" id="portion-legend">{t.legend}</span>
    <div class="switch" role="group" aria-labelledby="portion-legend">
      <button type="button" data-portion="half" aria-pressed="false">{t.half}</button>
      <button type="button" data-portion="full" aria-pressed="true">{t.full}</button>
    </div>
  </div>

  <div
    class="visually-hidden"
    aria-live="polite"
    aria-atomic="true"
    data-portion-announce
    data-msg-half={t.announceHalf}
    data-msg-full={t.announceFull}
  ></div>

  <ul class="rows">
    {sorted.map((dish) => {
      const half = formatPortionPrice(dish.price, "half");
      const full = formatPortionPrice(dish.price, "full");
      return (
        <li class="row" data-dish data-name={dish.name} data-desc={dish.description ?? ""}>
          <div class="head">
            <span class="name">{dish.name}</span>
            <span class="leader" aria-hidden="true"></span>
            <span
              class="price"
              data-half={formatEuro(half.amount)}
              data-full={formatEuro(full.amount)}
              data-only-full={half.onlyFull ? "true" : "false"}
            >{formatEuro(full.amount)}</span>
          </div>
          {dish.description && <p class="desc">{dish.description}</p>}
          {half.onlyFull && (
            <p class="only-full" data-only-full-note hidden>{t.onlyFull}</p>
          )}
        </li>
      );
    })}
  </ul>

  <p class="empty" data-empty hidden aria-live="polite">{t.empty}</p>
</div>

<script>
  import { matchDish } from "@tombo/content";

  const mount = () => {
    const toggle = document.querySelector<HTMLElement>("[data-portion-toggle]");
    if (!toggle) return;
    toggle.hidden = false;

    const announce = document.querySelector<HTMLElement>("[data-portion-announce]");

    const apply = (portion: "half" | "full") => {
      document.querySelectorAll<HTMLElement>("[data-dish]").forEach((row) => {
        const price = row.querySelector<HTMLElement>(".price");
        const note = row.querySelector<HTMLElement>("[data-only-full-note]");
        if (!price) return;
        price.textContent = portion === "half" ? price.dataset.half! : price.dataset.full!;
        const onlyFull = price.dataset.onlyFull === "true";
        if (note) note.hidden = !(portion === "half" && onlyFull);
      });
      toggle.querySelectorAll<HTMLButtonElement>("button[data-portion]").forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.portion === portion));
      });
      if (announce) {
        announce.textContent = portion === "half" ? announce.dataset.msgHalf! : announce.dataset.msgFull!;
      }
    };

    toggle.querySelectorAll<HTMLButtonElement>("button[data-portion]").forEach((b) => {
      b.addEventListener("click", () => apply(b.dataset.portion as "half" | "full"));
    });

    // El buscador solo se ofrece con JavaScript: sin él no filtraría nada y un
    // campo que no hace nada es peor que no tenerlo.
    const wrap = document.querySelector<HTMLElement>("[data-search-wrap]");
    const input = document.querySelector<HTMLInputElement>("[data-search]");
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    if (wrap) wrap.hidden = false;

    input?.addEventListener("input", () => {
      const q = input.value;
      let visible = 0;
      document.querySelectorAll<HTMLElement>("[data-dish]").forEach((row) => {
        const hit = matchDish({ name: row.dataset.name ?? "", description: row.dataset.desc }, q);
        row.hidden = !hit;
        if (hit) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  };

  mount();
  // `astro:after-swap` y no `astro:page-load`: este último también dispara en la
  // carga inicial, así que con ClientRouter activo duplicaría los listeners.
  document.addEventListener("astro:after-swap", mount);
</script>

<style>
  .toggle {
    position: sticky;
    /* Cuelga del alto real que Nav.astro mide y escribe en cliente: el botón de
       reserva y la hamburguesa cambian el alto de la cabecera por idioma y
       ancho, así que un número fijo aquí se desajusta solo. */
    top: var(--t-header-h);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Con el buscador ya son tres piezas: en móvil no caben en una fila, así
       que el campo se queda solo arriba y debajo van leyenda e interruptor. */
    flex-wrap: wrap;
    gap: 10px 12px;
    padding: 10px 0;
    background: var(--paper);
    border-bottom: 3px solid var(--ink);
  }
  .toggle[hidden] {
    display: none;
  }
  .search {
    flex: 1 1 12rem;
    min-width: 0;
  }
  .search[hidden] {
    display: none;
  }
  .search input {
    min-height: 44px;
    width: 100%;
    padding: 0 12px;
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 4px;
  }
  .search input:focus-visible {
    outline: 2px solid var(--rojo);
    outline-offset: 2px;
  }
  .empty {
    margin: 1.4rem 0 0;
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-dim);
  }
  .empty[hidden] {
    display: none;
  }
  .legend {
    font-family: var(--sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  .switch {
    display: flex;
    border: 2px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
  }
  .switch button {
    min-height: 44px;
    padding: 0 14px;
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1;
    background: transparent;
    color: var(--ink);
    border: 0;
    cursor: pointer;
  }
  .switch button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }
  .switch button:focus-visible {
    outline: 2px solid var(--rojo);
    outline-offset: -4px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .name {
    font-size: 1.06rem;
  }
  .leader {
    flex: 1;
    border-bottom: 1px dotted var(--ink-faint);
    transform: translateY(-0.25em);
  }
  .price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .desc {
    margin: 0.35rem 0 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
    max-width: 60ch;
  }
  .only-full {
    margin: 0.3rem 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--rojo);
  }
  .only-full[hidden] {
    display: none;
  }
  /* La leyenda dice lo mismo que los propios botones ("½ ración" / "Ración").
     En pantalla estrecha se retira de la vista —sigue nombrando el grupo por
     aria-labelledby— para que buscador e interruptor quepan en una fila: con
     dos filas la barra pegajosa medía 125px y, sumada a la cabecera, se comía
     192px de los 812 del viewport. */
  @media (max-width: 560px) {
    .legend {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .search {
      flex: 1 1 8rem;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
