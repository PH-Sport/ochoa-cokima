---
// apps/ochoa/src/components/Contacto.astro
//
// Teléfono e Instagram como dos acciones, no como dos renglones de una lista.
// Con icono *y* texto: el icono solo obliga a adivinar, y el número escrito es
// lo que alguien copia o lee en voz alta por teléfono. En el móvil el primero
// abre el marcador y el segundo la app de Instagram; en el escritorio siguen
// siendo un número legible y un enlace.
import { RESTAURANT } from "../site.ts";

interface Props {
  locale: "es" | "en";
  /** En el pie del menú desplegado hay menos sitio y no cabe el relieve. */
  compacto?: boolean;
}
const { locale, compacto = false } = Astro.props;
const es = locale === "es";

const telHref = `tel:${RESTAURANT.telephone.replace(/\s/g, "")}`;
// Sin el prefijo internacional: es el número tal y como lo diría alguien de aquí.
const telVisible = RESTAURANT.telephone.replace(/^\+34\s*/, "");
const usuario = "@" + RESTAURANT.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, "").replace(/\/$/, "");

const t = es
  ? { llamar: "Llamar", ig: "Instagram" }
  : { llamar: "Call", ig: "Instagram" };
---

<ul class:list={["contacto", { compacto }]}>
  <li>
    <a href={telHref}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
      </svg>
      <span class="etq">{t.llamar}</span>
      <span class="dato">{telVisible}</span>
    </a>
  </li>
  <li>
    <a href={RESTAURANT.instagram} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      <span class="etq">{t.ig}</span>
      <span class="dato">{usuario}</span>
    </a>
  </li>
</ul>

<style>
  .contacto {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  /* Las dos cajas miden lo mismo aunque el usuario de Instagram se parta en dos
     líneas y el teléfono no: desiguales se leían como un descuido. */
  .contacto li {
    display: grid;
  }
  .contacto a {
    display: grid;
    height: 100%;
    grid-template-columns: auto 1fr;
    grid-template-areas: "icono etiqueta" "icono dato";
    align-items: center;
    column-gap: 10px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1.5px solid var(--ink);
    /* Un escalón más que un botón: estas fichas miden 55px y con el radio de
       un botón de 44 se veían más picudas que «Reservar» aun teniendo el mismo
       número. La curva se percibe en proporción a la pieza. */
    border-radius: var(--r-caja);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transition:
      transform var(--dur-in) var(--ease) var(--hold-tacto),
      box-shadow var(--dur-in) var(--ease) var(--hold-tacto),
      color var(--dur-out) var(--ease),
      border-color var(--dur-out) var(--ease);
  }
  .contacto a:hover,
  .contacto a:active {
    transition-duration: var(--dur-out);
    transition-delay: 0s;
  }
  .contacto a:hover {
    color: var(--rojo);
    border-color: var(--rojo);
    box-shadow: 2px 2px 0 var(--rojo);
    transform: translate(1px, 1px);
  }
  .contacto a:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--rojo);
  }
  .contacto svg {
    grid-area: icono;
    width: 22px;
    height: 22px;
  }
  /* La etiqueta dice qué hace y el dato dice cuál es: sin la primera, un icono
     de teléfono junto a nueve cifras no aclara si va a llamar o a copiarlas. */
  .etq {
    grid-area: etiqueta;
    font-family: var(--sans);
    font-weight: 700;
    font-stretch: var(--wd-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: var(--rojo);
    line-height: 1.3;
  }
  .dato {
    grid-area: dato;
    font-family: var(--sans);
    font-size: 0.92rem;
    line-height: 1.25;
  }

  /* En el pie del menú el relieve sobra: ahí no hay nada más con sombra y dos
     cajas levantadas pesaban más que los tres nombres de sección, que son lo
     que se ha venido a leer. */
  .compacto a {
    box-shadow: none;
    border-color: var(--line);
  }
  .compacto a:hover,
  .compacto a:active {
    box-shadow: none;
    transform: none;
  }

  /* Una debajo de otra en todo el móvil. A dos columnas, «@tasquita.losochoa»
     no cabe en la mitad de una pantalla de 390px y se partía a mitad de
     palabra —«@tasquita.loso / choa»—, que es peor que ocupar dos renglones.
     A partir de aquí sí caben en fila. */
  @media (min-width: 430px) {
    .contacto {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 429px) {
    .contacto {
      grid-template-columns: 1fr;
    }
  }
</style>
