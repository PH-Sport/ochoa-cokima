{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hook-docs-al-dia.sh\"",
            "timeout": 10,
            "statusMessage": "Comprobando la documentación"
          }
        ]
      }
    ]
  }
}
