---
import type { RestaurantInfo } from "./index.ts";

interface Props {
  title: string;
  description: string;
  locale: "es" | "en";
  /** Ruta equivalente en el otro idioma, p. ej. "/en/menu" desde "/carta".
   *  Opcional: hay páginas que solo existen en un idioma —las legales de Ochoa
   *  se publican solo en español— y ahí no se declara ninguna equivalencia.
   *  Declarar una falsa es peor que no declarar nada: el emparejamiento tiene
   *  que ser recíproco, y una legal apuntando a la home inglesa no lo es. */
  altPath?: string;
  restaurant: RestaurantInfo;
  ogImage?: string;
  /** La foto del local para los buscadores (el `image` del JSON-LD). Sin ella
   *  vale la de compartir. Va aparte porque la de compartir puede ser un
   *  cartel, y a un buscador se le enseña el sitio. */
  schemaImage?: string;
  /** Página que existe pero todavía no debe indexarse: la que está montada con
   *  huecos de contenido a la espera de material. `follow` y no `nofollow`
   *  porque los enlaces que salen de ella —a la carta, a reservas— sí valen;
   *  lo que no vale es que la página en obras compita en los resultados. */
  noindex?: boolean;
}

const { title, description, locale, altPath, restaurant, ogImage, schemaImage = ogImage, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("http://localhost:4321");
const canonical = new URL(Astro.url.pathname, site);
const alternate = altPath ? new URL(altPath, site) : null;
const altLocale = locale === "es" ? "en" : "es";
const xDefault = altPath ? new URL(locale === "es" ? Astro.url.pathname : altPath, site) : null;
// La web del restaurante es su portada, la mire quien la mire. Hasta el 2026-11-18 era la canónica de
// cada página, y el aviso legal declaraba que la web de Cokima era /aviso-legal: la misma ficha en
// cada página, con una dirección distinta en cada una, es lo contrario de decirle a Google quién es.
const home = new URL("/", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": `${home}#restaurante`,
  name: restaurant.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: restaurant.streetAddress,
    postalCode: restaurant.postalCode,
    addressLocality: restaurant.addressLocality,
    addressCountry: "ES",
  },
  telephone: restaurant.telephone,
  servesCuisine: restaurant.servesCuisine,
  priceRange: restaurant.priceRange,
  openingHours: restaurant.openingHours,
  url: home,
  ...(restaurant.menuPath ? { hasMenu: new URL(restaurant.menuPath, site).href } : {}),
  ...(restaurant.reservationsPath ? { acceptsReservations: new URL(restaurant.reservationsPath, site).href } : {}),
  ...(restaurant.instagram ? { sameAs: [restaurant.instagram] } : {}),
  ...(schemaImage ? { image: new URL(schemaImage, site).href } : {}),
};

// El nombre del sitio en los resultados de Google sale de esta ficha (developers.google.com/search/docs/
// appearance/site-names). Solo se declara si la app da el nombre corto: inventarlo del `name` largo
// sería proponerle a Google justo el nombre que no queremos que ponga.
const webSiteLd = restaurant.siteName
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${home}#web`,
      name: restaurant.siteName,
      url: home,
      publisher: { "@id": `${home}#restaurante` },
    }
  : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical.href} />
{alternate && xDefault && (
  <>
    <link rel="alternate" hreflang={locale} href={canonical.href} />
    <link rel="alternate" hreflang={altLocale} href={alternate.href} />
    <link rel="alternate" hreflang="x-default" href={xDefault.href} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_GB"} />
{restaurant.siteName && <meta property="og:site_name" content={restaurant.siteName} />}
{ogImage && <meta property="og:image" content={new URL(ogImage, site).href} />}
{/* Sin esto, X enseña el enlace con la miniatura pequeña aunque la imagen sea de 1200×630. */}
{ogImage && <meta name="twitter:card" content="summary_large_image" />}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{webSiteLd && <script type="application/ld+json" set:html={JSON.stringify(webSiteLd)} />}
