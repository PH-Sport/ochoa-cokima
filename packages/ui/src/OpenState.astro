---
// packages/ui/src/OpenState.astro
interface Props {
  hours: string[];
  locale: "es" | "en";
}
const { hours, locale } = Astro.props;
const labels =
  locale === "es"
    ? { open: "Abierto ahora", until: "hasta las", closed: "Cerrado", next: "abre a las" }
    : { open: "Open now", until: "until", closed: "Closed", next: "opens at" };
---

<span
  class="open-state"
  data-open-state
  data-hours={JSON.stringify(hours)}
  data-labels={JSON.stringify(labels)}
  hidden
>
  <i class="dot" aria-hidden="true"></i><span class="text"></span>
</span>

<script>
  import { getOpenState } from "@tombo/content";

  const render = (el: HTMLElement) => {
    try {
      const hours = JSON.parse(el.dataset.hours ?? "[]") as string[];
      const labels = JSON.parse(el.dataset.labels ?? "{}");
      const state = getOpenState(hours, new Date());
      const text = el.querySelector(".text");
      if (!text) return;

      if (state.open) {
        text.textContent = `${labels.open} · ${labels.until} ${state.until}`;
        el.dataset.state = "open";
      } else if (state.nextOpen) {
        text.textContent = `${labels.closed} · ${labels.next} ${state.nextOpen}`;
        el.dataset.state = "closed";
      } else {
        return; // Sin horario: no afirmamos nada.
      }
      el.hidden = false;
    } catch {
      return;
    }
  };

  const mount = () => document.querySelectorAll<HTMLElement>("[data-open-state]").forEach(render);
  mount();
  // `astro:after-swap` y no `astro:page-load`: este último también dispara en la
  // carga inicial, así que con ClientRouter activo resolvería dos veces.
  document.addEventListener("astro:after-swap", mount);
</script>

<style>
  .open-state {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-size: var(--t-open-state-size, 0.82rem);
    color: var(--t-text-dim);
    line-height: 1.2;
  }
  .open-state[hidden] {
    display: none;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--t-text-faint);
    flex: none;
  }
  /* El texto ya dice si está abierto: el punto refuerza, no informa por sí
     solo, así que no hace falta reservarle un color propio a cada marca.
     `--t-open` sigue siendo opcional para quien quiera uno; sin él, cae al
     acento de la marca en vez de inventar una familia de color nueva. */
  .open-state[data-state="open"] .dot {
    background: var(--t-open, var(--t-accent));
  }
  .open-state[data-state="closed"] .dot {
    background: var(--t-text-faint);
  }
</style>
