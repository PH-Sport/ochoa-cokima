---
import type { Allergen } from "@tombo/content";

interface Props {
  allergens: Allergen[];
  labels: Record<string, string>;
}

const { allergens, labels } = Astro.props;

/** Iconos dibujados; el resto del enum cae al fallback con inicial. */
const PATHS: Record<string, string> = {
  gluten:
    "M12 21V9 M12 9c0-2 1.3-3.6 3.4-4.2C15.4 6.8 14 8.4 12 9Z M12 9c0-2-1.3-3.6-3.4-4.2C8.6 6.8 10 8.4 12 9Z M12 14c0-2 1.3-3.6 3.4-4.2C15.4 11.8 14 13.4 12 14Z M12 14c0-2-1.3-3.6-3.4-4.2C8.6 11.8 10 13.4 12 14Z M12 19c0-2 1.3-3.6 3.4-4.2C15.4 16.8 14 18.4 12 19Z M12 19c0-2-1.3-3.6-3.4-4.2C8.6 16.8 10 18.4 12 19Z",
  lacteos:
    "M8 9h8v10a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z M8 9l1.6-3.5h4.8L16 9 M10.5 13.2h3",
  pescado:
    "M3.5 12c3-4.2 9.5-4.2 13 0-3.5 4.2-10 4.2-13 0Z M16.5 12l4-3v6z M7.5 11h.01",
  crustaceos:
    "M16 6c-3.8 1-6 3.8-6 7.2 0 2.2 1.1 4 3 5.2 M10 13.2C8 13.2 6 12 5 10 M10.6 15.6c-1.6.4-3.2 0-4.4-1.2",
  soja: "M6 17c-.5-5.5 4-10 10-9.5.5 5.5-4 10-10 9.5Z M10 13.5h.01 M13.5 10h.01",
  sesamo: "M9 12l-1.5 3 M14 11.5l1 3 M12 7.5l-.2 3",
  huevo: "M12 4.5c3 0 5.2 4.2 5.2 8.2a5.2 5.2 0 0 1-10.4 0c0-4 2.2-8.2 5.2-8.2Z",
};
---

{allergens.length > 0 && (
  <span class="allergens">
    {allergens.map((a) => {
      const label = labels[a] ?? a;
      return PATHS[a] ? (
        <span class="allergen" role="img" aria-label={label} title={label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={PATHS[a]} />
          </svg>
        </span>
      ) : (
        <span class="allergen allergen--txt" role="img" aria-label={label} title={label}>
          {label.slice(0, 2)}
        </span>
      );
    })}
  </span>
)}

<style>
  .allergens {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0.6rem;
  }
  .allergen {
    width: 23px;
    height: 23px;
    border: 1px solid var(--t-line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--t-text-dim);
    flex: 0 0 auto;
  }
  .allergen svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  .allergen--txt {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>
