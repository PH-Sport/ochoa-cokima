---
interface Props {
  slug: string;
  locale: "es" | "en";
  title: string;
  /** URL absoluta de una hoja de estilo para el motor. CoverManager la acepta
   *  en `?template=` y la enlaza la última dentro del iframe; es como cada casa
   *  le pone su piel sin que este componente sepa de marcas. No está
   *  documentado para URLs (solo `trans-white`/`trans-black`): si lo retiran,
   *  el motor vuelve a su aspecto de serie y sigue reservando. */
  template?: string;
}

const { slug, locale, title, template } = Astro.props;
const lang = locale === "es" ? "spanish" : "english";
const query = template ? `?${new URLSearchParams({ template })}` : "";
const src = `https://www.covermanager.com/reservation/module_restaurant/${slug}/${lang}${query}`;
---

<div class="booking-embed">
  <script is:inline src="https://www.covermanager.com/js/iframeResizer.min.js"></script>
  <iframe
    id={slug}
    title={title}
    src={src}
    frameborder="0"
    height="550"
    width="100%"
    loading="lazy"
    onload="typeof iFrameResize === 'function' && iFrameResize();"
  ></iframe>
</div>

<style>
  .booking-embed {
    background: var(--t-surface, transparent);
    border: var(--t-card-border, 1px solid var(--t-line));
    border-radius: var(--t-radius, 6px);
    overflow: hidden;
  }
  .booking-embed iframe {
    display: block;
    background: transparent;
  }
</style>
